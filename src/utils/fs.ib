const stdlib = import "@stdlib"

pub struct File {
	success: bool,
	length: int,
	content: str,
}

pub fn read_file(file: str): File {
	let result = File {
		success: false,
		length: 0,
		content: null
	};
	let f = stdlib::fopen(file, "r");
	if f == null {
		return result;
	}

	stdlib::fseek(f, 0, stdlib::FileSeek::End);
	let size = stdlib::ftell(f);
	stdlib::fseek(f, 0, stdlib::FileSeek::Start);
	if size <= 0 {
		stdlib::fclose(f);
		return result;
	}
	let buffer: *char = stdlib::malloc(size + 1);
	if buffer == null {
		stdlib::printf("Failed to malloc?\n");
		return result;
	}
	// let terminator: *char = ((buffer as int) + size) as *any;

	let final_size = size + 0; 
	stdlib::fread(buffer, size, 1, f);
	buffer[final_size] = '\0';

	stdlib::fclose(f);

	result.content = buffer;
	result.length = size;
	result.success = true;
	return result;
}


pub fn write_file(file: str, content: str): bool {
	let file = stdlib::fopen(file, "w");
	if file == null { return false; }

	// TODO: Probably validate if all of it has been sent
	stdlib::fputs(content, file);

	stdlib::fclose(file);
	return true;
}


pub fn free(file: *File) {
	file.success = false;
	file.length = 0;
	stdlib::free(file.content);
}


pub fn delete_file(file: str): bool {
	let res = remove(file);
	return res == 0;
}
extern remove(file: str): int

