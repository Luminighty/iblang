const stdlib = import "@stdlib"

pub struct File {
	success: bool,
	length: int,
	content: str,
}

pub fn read_file(file: str): File {
	let f = stdlib::fopen(file, "r");
	if f == null {
		return read_error();
	}

	stdlib::fseek(f, 0, stdlib::FileSeek::End);
	let size = stdlib::ftell(f);
	stdlib::fseek(f, 0, stdlib::FileSeek::Start);
	if size <= 0 {
		stdlib::fclose(f);
		return read_error();
	}

	let buffer: *char = stdlib::malloc(size + 1);
	if buffer == null {
		stdlib::printf("Failed to malloc?\n");
		return read_error();
	}

	let final_size = size + 0; 
	stdlib::fread(buffer, size, 1, f);
	buffer[final_size] = '\0';

	stdlib::fclose(f);
	return File {
		success: true,
		length: size,
		content: buffer,
	};
}

fn read_error(): File {
	return File {
		success: false,
		length: 0, content: null
	};
}


pub fn write_file(file: str, content: str): bool {
	let file = stdlib::fopen(file, "w");
	if file == null { return false; }

	let ret_code = stdlib::fputs(content, file);
	let res = ret_code >= 0;

	stdlib::fclose(file);
	return res;
}


pub fn free(file: *File) {
	file.success = false;
	file.length = 0;
	stdlib::free(file.content);
}


extern remove(file: str): int
pub fn delete_file(file: str): bool {
	let res = remove(file);
	return res == 0;
}


pub fn exists(file: str): bool {
	let file = stdlib::fopen(file, "r");
	if file == null { return false; }
	stdlib::fclose(file);
	return true;
}

