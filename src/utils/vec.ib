const stdlib = import "@stdlib"


pub struct Vec {
	count: int,
	capacity: int,
	item_size: int,
	items: *char,
	frozen: bool,
}


pub fn is_initialized(vec: *Vec): bool {
	return vec.item_size > 0;
}


pub fn new(item_size: int, capacity: int): Vec {
	let items = null;
	item_size = with_alignment(item_size);
	if capacity > 0 {
		items = stdlib::malloc(item_size * capacity);
	}
	return Vec { count: 0, capacity, item_size, items, frozen: false };
}

pub fn new_frozen(item_size: int, capacity: int): Vec {
	let items = null;
	item_size = with_alignment(item_size);
	if capacity > 0 {
		items = stdlib::malloc(item_size * capacity);
	}
	return Vec { count: 0, capacity, item_size, items, frozen: true };
}


pub fn index(vec: *Vec, i: int): int {
	return vec.item_size * i;
}


pub fn free(vec: *Vec): int {
	let size = vec.capacity * vec.item_size;
	stdlib::free(vec.items);
	vec.items = null;
	vec.capacity = 0;
	vec.count = 0;
	return size;
}


pub fn clone(vec: *Vec): Vec {
	let items = stdlib::malloc(vec.item_size * vec.capacity);
	let new_vec = Vec {
		count: vec.count,
		capacity: vec.capacity,
		item_size: vec.item_size,
		items, frozen: vec.frozen,
	};
	if vec.count > 0 {
		stdlib::memcpy(
			new_vec.items,
			vec.items,
			vec.count * vec.item_size
		);
	}
	return new_vec;
}


pub fn clear(vec: *Vec) {
	vec.count = 0;
}


pub fn push(vec: *Vec): *any {
	// NOTE: Once we have generics, we won't need to check for this
	stdlib::assert(is_initialized(vec), "vec::push not initialized!");
	allocate(vec, 1);
	let ptr = &vec.items[index(vec, vec.count)];
	stdlib::memset(ptr, 0, vec.item_size);
	vec.count += 1;
	return ptr;
}


pub fn pop(vec: *Vec): *any {
	stdlib::assert(is_initialized(vec), "vec::pop not initialized!");
	if vec.count == 0 { return null; }
	let element = get(vec, vec.count - 1);
	vec.count -= 1;
	return element;
}


pub fn get(vec: *Vec, idx: int): *any {
	stdlib::assert(is_initialized(vec), "vec::get not initialized!");
	if idx >= vec.count {
		stdlib::printf("vec::get idx %d < count %d\n", idx, vec.count);
		stdlib::fflush(stdlib::stdout);
		stdlib::abort();
	}
	return &vec.items[index(vec, idx)];
}

pub fn last(vec: *Vec): *any {
	stdlib::assert(is_initialized(vec), "vec::last not initialized!");
	if vec.count == 0 { return null; }
	return get(vec, vec.count - 1);
}



pub fn push_many(vec: *Vec, count: int): *any {
	allocate(vec, count);
	let idx = vec.count;
	vec.count += count;
	let ptr = &vec.items[index(vec, idx)];
	stdlib::memset(ptr, 0, vec.item_size);
	return ptr;
}


pub fn append(vec: *Vec, other: *Vec) {
	stdlib::assert(vec.item_size == other.item_size, "vec::append item size mismatch!");
	let ptr = push_many(vec, other.count);
	stdlib::memcpy(ptr, other.items, other.count * other.item_size);
}


pub fn allocate(vec: *Vec, count: int) {
	let min_capacity = vec.count + count;
	if min_capacity <= vec.capacity { return; }
	stdlib::assert(!vec.frozen, "vec tried to allocate but was frozen!");

	let new_capacity = vec.capacity * 2;
	if new_capacity < min_capacity {
		new_capacity = min_capacity * 2;
	}
	vec.capacity = new_capacity;

	vec.items = stdlib::realloc(
		vec.items,
		vec.capacity * vec.item_size
	);
}


fn with_alignment(size: int): int {
	let rem = size % 8;
	if rem == 0 { return size; }
	return size + (8 - rem);
}

