// Numbers
123 321 333
123.322 322.111

// Hexa + Binary
0xFF 0x1000 0x0a00
0b1000 0b0101

// Number Separators
20_000 31_322_122
0b1000_1000 // 136
0x10_10 // 4112

// Chars
'a' 'b' 'c'

//10   9   13    0
'\n' '\t' '\r' '\0' '\'' '\\'

// Strings
"abc\"abc"
//          10
"Hello World\n"

// Hexa
// e     j      }
'\x65' '\x6A' '\x7d'
//      e
"What \x65?"

// Identifiers
abc aaa bbb foo bar
