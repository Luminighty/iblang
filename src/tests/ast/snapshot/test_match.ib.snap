FN numbers
RETURN: void
  BLOCK
    VAR_DECL LET
      IDENTIFIER: res
      TYPE: NONE
        [LITERAL] NUMBER = 0
    VAR_DECL LET
      IDENTIFIER: x
      TYPE: NONE
        [LITERAL] NUMBER = 12
    MATCH
      IDENTIFIER: x
      CASE[0]
        [LITERAL] NUMBER = 0
      THEN
        ASSIGN
          IDENTIFIER: res
          [LITERAL] NUMBER = 1
      CASE[1]
        [LITERAL] NUMBER = 1
      THEN
        ASSIGN
          IDENTIFIER: res
          [LITERAL] NUMBER = 3
      CASE[2]
        [LITERAL] NUMBER = 3
      THEN
        ASSIGN
          IDENTIFIER: res
          [LITERAL] NUMBER = 5


FN default
RETURN: void
  BLOCK
    VAR_DECL LET
      IDENTIFIER: res
      TYPE: NONE
        [LITERAL] NUMBER = 0
    VAR_DECL LET
      IDENTIFIER: x
      TYPE: NONE
        [LITERAL] NUMBER = 12
    MATCH
      IDENTIFIER: x
      CASE[0]
        [LITERAL] NUMBER = 0
      THEN
