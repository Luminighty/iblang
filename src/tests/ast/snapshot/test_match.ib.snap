          [LITERAL] NUMBER = 1
      CASE[1]
        [LITERAL] NUMBER = 1
      THEN
        ASSIGN
          IDENTIFIER: res
          [LITERAL] NUMBER = 3
      CASE[2]
        [DEFAULT]
