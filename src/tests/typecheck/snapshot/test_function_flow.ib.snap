# MODULE: src/tests/typecheck/test_function_flow.ib

STRUCT : Entry SYMBOL@4[name=Entry,module=0] [SIZE=24,ALIGN=8]
  .0	hash	: i64
  .8	length	: i64
  .16	ident	: PTR(u8)

STRUCT : IdentSet SYMBOL@5[name=IdentSet,module=0] [SIZE=24,ALIGN=8]
  .0	count	: i64
  .8	capacity	: i64
  .16	entries	: PTR(SYMBOL@4[name=Entry,module=0])

STRUCT : Literal SYMBOL@6[name=Literal,module=0] [SIZE=16,ALIGN=8]
  .0	kind	: SYMBOL@8[name=LiteralKind,module=0]
  .8	value	: SYMBOL@7[name=LiteralValue,module=0]


UNION : LiteralValue SYMBOL@7[name=LiteralValue,module=0] [SIZE=8,ALIGN=8]
  .0	number	: i64
  .0	flt	: f64
  .0	string	: PTR(u8)
  .0	chr	: u8
  .0	boolean	: bool


ENUM : LiteralKind [SIZE=1,ALIGN=1]
  Bool = 0
  Null = 1
  U8 = 2
  I64 = 3
  F32 = 4
  F64 = 5


FN memcmp
    ident : PTR(u8)
    ident2 : PTR(u8)
    len : i64
  return: i64
  BLOCK
    RETURN
      I64(5)

FN find_identifier_entry
    identifier : PTR(u8)
    length : i64
    ident_hash : i64
  return: PTR(SYMBOL@4[name=Entry,module=0])
  BLOCK
    VAR_DECL LET set@4
      TYPE: SYMBOL@5[name=IdentSet,module=0]
      STRUCT_INIT SYMBOL@5[name=IdentSet,module=0]
        count
          I64(0)
        capacity
          I64(0)
        entries
          CAST Method: Keep
            NULL
            CAST_INTO PTR(SYMBOL@4[name=Entry,module=0])
    VAR_DECL LET index@5
      TYPE: i64
      REM
        ADD
          REM
            VAR@3 [ident=ident_hash,ty=i64]
            STRUCT_FIELD_LOOKUP
              VAR@4 [ident=set,ty=SYMBOL@5[name=IdentSet,module=0]]
              [FIELD] capacity
          STRUCT_FIELD_LOOKUP
            VAR@4 [ident=set,ty=SYMBOL@5[name=IdentSet,module=0]]
            [FIELD] capacity
        STRUCT_FIELD_LOOKUP
          VAR@4 [ident=set,ty=SYMBOL@5[name=IdentSet,module=0]]
          [FIELD] capacity
    LOOP
      BLOCK
        VAR_DECL LET entry@6
          TYPE: SYMBOL@4[name=Entry,module=0]
          INDEX
              STRUCT_FIELD_LOOKUP
                VAR@4 [ident=set,ty=SYMBOL@5[name=IdentSet,module=0]]
                [FIELD] entries
            [IDX]
              VAR@5 [ident=index,ty=i64]
        IF
          EQ
            STRUCT_FIELD_LOOKUP
              VAR@6 [ident=entry,ty=SYMBOL@4[name=Entry,module=0]]
              [FIELD] ident
            CAST Method: Keep
              NULL
              CAST_INTO PTR(u8)
          THEN
            BLOCK
              RETURN
                REF
                  VAR@6 [ident=entry,ty=SYMBOL@4[name=Entry,module=0]]
        IF
          AND
            EQ
              STRUCT_FIELD_LOOKUP
                VAR@6 [ident=entry,ty=SYMBOL@4[name=Entry,module=0]]
                [FIELD] length
              VAR@2 [ident=length,ty=i64]
            EQ
              STRUCT_FIELD_LOOKUP
                VAR@6 [ident=entry,ty=SYMBOL@4[name=Entry,module=0]]
                [FIELD] hash
              VAR@3 [ident=ident_hash,ty=i64]
          THEN
            BLOCK
              IF
                EQ
                  [CALL] CALLEE:
                      SYMBOL@1[name=memcmp,module=0]
                    ARG[0]
                      STRUCT_FIELD_LOOKUP
                        VAR@6 [ident=entry,ty=SYMBOL@4[name=Entry,module=0]]
                        [FIELD] ident
                    ARG[1]
                      VAR@1 [ident=identifier,ty=PTR(u8)]
                    ARG[2]
                      VAR@2 [ident=length,ty=i64]
                  I64(0)
                THEN
                  BLOCK
                    RETURN
                      REF
                        VAR@6 [ident=entry,ty=SYMBOL@4[name=Entry,module=0]]
        ASSIGN
          VAR@5 [ident=index,ty=i64]
          REM
            ADD
              VAR@5 [ident=index,ty=i64]
              I64(1)
            STRUCT_FIELD_LOOKUP
              VAR@4 [ident=set,ty=SYMBOL@5[name=IdentSet,module=0]]
              [FIELD] capacity

FN into_int
    literal : SYMBOL@6[name=Literal,module=0]
  return: i64
  BLOCK
    MATCH
      STRUCT_FIELD_LOOKUP
        VAR@1 [ident=literal,ty=SYMBOL@6[name=Literal,module=0]]
        [FIELD] kind
      CASE[0]
        ENUM_VALUE
          SYMBOL@8[name=LiteralKind,module=0]
            U8	:= 2
      THEN
        RETURN
          CAST Method: Extend
            UNION_FIELD_LOOKUP
              STRUCT_FIELD_LOOKUP
                VAR@1 [ident=literal,ty=SYMBOL@6[name=Literal,module=0]]
                [FIELD] value
              [FIELD] chr
            CAST_INTO i64
      CASE[1]
        ENUM_VALUE
          SYMBOL@8[name=LiteralKind,module=0]
            I64	:= 3
      THEN
        RETURN
          UNION_FIELD_LOOKUP
            STRUCT_FIELD_LOOKUP
              VAR@1 [ident=literal,ty=SYMBOL@6[name=Literal,module=0]]
              [FIELD] value
            [FIELD] number
      CASE[2]
        ENUM_VALUE
          SYMBOL@8[name=LiteralKind,module=0]
            F32	:= 4
        ENUM_VALUE
          SYMBOL@8[name=LiteralKind,module=0]
            F64	:= 5
      THEN
        RETURN
          CAST Method: FloatToInt
            UNION_FIELD_LOOKUP
              STRUCT_FIELD_LOOKUP
                VAR@1 [ident=literal,ty=SYMBOL@6[name=Literal,module=0]]
                [FIELD] value
              [FIELD] flt
            CAST_INTO i64
      CASE[3]
        [DEFAULT]
      THEN
        RETURN
          I64(0)



