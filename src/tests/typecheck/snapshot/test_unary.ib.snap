FN bitnot
  return: void
  BLOCK
    VAR_DECL LET x@1
      TYPE: i64
      I64(15)
    VAR_DECL LET y@2
      TYPE: i64
      I64(255)
    VAR_DECL LET not@3
      TYPE: i64
      BITNOT
        I64(10)
    VAR_DECL LET not@4
      TYPE: i64
      BITNOT
        I64(255)
    VAR_DECL LET not@5
      TYPE: i64
      BITNOT
        VAR@1 [ident=x]
    VAR_DECL LET not@6
      TYPE: i64
      BITNOT
        BIT_AND
          VAR@2 [ident=y]
          I64(255)
    VAR_DECL LET combined@7
      TYPE: i64
      ADD
        BITNOT
          VAR@1 [ident=x]
        BITNOT
          VAR@2 [ident=y]
    VAR_DECL LET double_bitnot@8
      TYPE: i64
      BITNOT
        BITNOT
          VAR@1 [ident=x]

FN not
  return: void
  BLOCK
    VAR_DECL LET flag@1
      TYPE: bool
      TRUE
    VAR_DECL LET flag@2
      TYPE: bool
      FALSE
    VAR_DECL LET flag@3
      TYPE: bool
      TRUE
    VAR_DECL LET not@4
      TYPE: bool
      NOT
        TRUE
    VAR_DECL LET not@5
      TYPE: bool
      NOT
        FALSE
    VAR_DECL LET not@6
      TYPE: bool
      NOT
        VAR@3 [ident=flag]
    VAR_DECL LET not@7
      TYPE: bool
      NOT
        VAR@3 [ident=flag]
    VAR_DECL LET chained@8
      TYPE: bool
      NOT
        NOT
          NOT
            VAR@3 [ident=flag]
    VAR_DECL LET result@9
      TYPE: bool
      AND
        NOT
          VAR@3 [ident=flag]
        NOT
          VAR@3 [ident=flag]

FN pointers
  return: void
  BLOCK
    VAR_DECL LET x@1
      TYPE: i64
      I64(10)
    VAR_DECL LET y@2
