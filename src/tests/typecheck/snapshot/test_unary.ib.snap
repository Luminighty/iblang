# MODULE: src/tests/typecheck/test_unary.ib

FN group
  return: void
  BLOCK
    VAR_DECL LET x@1
      TYPE: i64
      I64(10)
    VAR_DECL LET y@2
      TYPE: i64
      I64(5)
    VAR_DECL LET sum@3
      TYPE: i64
      ADD
        VAR@1 [ident=x]
        VAR@2 [ident=y]
    VAR_DECL LET nested@4
      TYPE: i64
      SUB
        MUL
          ADD
            VAR@1 [ident=x]
            VAR@2 [ident=y]
          I64(2)
        I64(3)
    VAR_DECL LET complex@5
      TYPE: i64
      DIV
        ADD
          VAR@1 [ident=x]
          MUL
            VAR@2 [ident=y]
            I64(2)
        SUB
          VAR@1 [ident=x]
          I64(5)

