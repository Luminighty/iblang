      TYPE: i64
      I64(5)
    VAR_DECL LET ref_mutable@8
      TYPE: PTR(i64)
      REF
        VAR@7 [ident=mutable]
    ASSIGN
      VAR@7 [ident=mutable]
      ADD
        DEREF
          VAR@8 [ident=ref_mutable]
        I64(10)
    VAR_DECL LET c@9
      TYPE: i64
      I64(10)
    VAR_DECL LET cptr1@10
      TYPE: PTR(i64)
      REF
        VAR@9 [ident=c]
