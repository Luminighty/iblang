struct Vec2 {
	x: f32,
	y: f32,
}

struct Login {
	user: str,
	pass: str,
	encrypted: bool,
}

union Message {
	pos: Vec2,
	ping: int,
}

fn Foo() {}

fn structs() {
	let foo = 10;
	let x = 10;
	let v = Vec2 { x, y: 5 };
	let missing = Vec2 { x };
	let unknow_field = Vec2 { x, y: 5, foo };
	let missing_and_unknow_field = Vec2 { x, bar: foo };

	let x = true;
	let v = Vec2 { x, y: 10 };
	let cast_err = Vec2 { x: 10, y: false };
}

fn unions() {
	let m = Message { pos: Vec2 { x: 12.0, y: 20.0 } };
	let m = Message { ping: 123 };
	let zero = Message { };

	let pos = Vec2 { x: 12.0, y: 20.0 };
	let ping = 123;
	let multiple = Message { pos, ping };
	let multiple = Message { pos, ping: 500 };

	let foo = 10;
	let unknown_field = Message { foo };
	let unknown_field = Message { bar: 123 };
	let multiple_unknown_field = Message { ping: 500, foo };
	let multiple_unknown_field = Message { ping: 123, bar: 123 };
}

fn neither() {
	let x = 10;
	let foo = 20;
	let v = Foo { x, bar: foo };
	let v = Bar { x, bar: foo };
}

