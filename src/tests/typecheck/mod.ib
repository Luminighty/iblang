const stdlib = import "@stdlib"
const sb = import "../../utils/stringbuilder.ib"
const vec = import "../../utils/vec.ib"

const snapshot = import "../snapshot.ib"

const err = import "../../storage/error.ib"

const build = import "../../build.ib"
const ast = import "../../ast/mod.ib"
const typecheck = import "../../typecheck/mod.ib"

let PASS = true;

pub fn run_tests() {
	snapshot::base_path("./src/tests/typecheck/");

	test("test_binary.ib");
	test("test_unary.ib");
	test("test_literal.ib");
	test("test_statement.ib");
	test("test_expr.ib");
	test("test_cast.ib");
	test("test_function.ib");

	stdlib::assert(PASS, "Snapshots failed.");
}


let sb = sb::StringBuilder{};
fn test(source: str) {
	sb::reset(&sb);

	let builder = build::new();
	build::parse_all(&builder, snapshot::file_source(source));
	build::typecheck(&builder);
	err::write_errors(&sb, &builder.errors, false);
	for let i = 0; i < builder.modules.count; i+=1 {
		let m = vec::get(&builder.modules, i);
		typecheck::debug_module(&sb, m);
	}
	// if result.module != null {
	// 	ast::free_module(result.module, false);
	// }

	let snapshot = sb::merge(&sb);
	let result = snapshot::test(source, snapshot);
	if !result.success {
		PASS = false;
	}
}

