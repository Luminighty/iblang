struct Vec2 {
	x: f32,
	y: f32,
}

fn Foo() {}

fn fields() {
	let foo = 10;
	let x = 10;
	let v = Vec2 { x, y: 5 };
	let v = Vec2 { x, y: 5, foo };
	let v = Vec2 { x };
	let v = Vec2 { x, bar: foo };
	let v = Foo { x, bar: foo };
	let v = Bar { x, bar: foo };

	let x = true;
	let v = Vec2 { x, y: 10 };
	let v = Vec2 { x: 10, y: false };
}
