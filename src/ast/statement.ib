const stdlib = import "@stdlib"
const workstack = import "../utils/workstack.ib"
const sb = import "../utils/stringbuilder.ib"

const token = import "../lexer/token.ib"

import "./ast.ib"
const err = import "./error.ib"
const node = import "./node.ib"
const ty = import "./typeident.ib"
const expr = import "./expr.ib"
const parse_typeident = import "./parse_typeident.ib"
const recovery = import "./recovery.ib"


pub struct ForData {
	init: int,
	cond: int,
	acc: int,
	body: int,
}


pub struct LoopData {
	has_cond: bool,
	cond: int,
	body: int,
}


pub struct IfData {
	cond: int,
	then: int,
	otherwise: int,
}


pub struct BlockData {
	count: int,
	nodes: *int,
}


pub struct VarDeclaration {
	ident: int,
	value: int,
	type: *node::TypeData,
}


pub struct ReturnData {
	has_value: bool,
	value: int,
}

pub struct MatchData {
	cond: int,
	count: int,
	cases: *MatchCase,
}


pub struct MatchCase {
	has_default: bool,
	conds: *int,
	cond_count: int,
	arm: int,
}


pub fn parse(ast: *Ast): int {
	let skip_expr_semicolon = ast.skip_expr_semicolon;
	ast.skip_expr_semicolon = false;
	match curr(ast) {
		token::TokenKind::Let => return parse_var_dec(ast, true);
		token::TokenKind::Const => return parse_var_dec(ast, false);
		token::TokenKind::BraceL => return parse_block(ast);
		token::TokenKind::Return => return parse_return(ast);
		token::TokenKind::If => return parse_if(ast);
		token::TokenKind::Loop => return parse_loop(ast);
		token::TokenKind::For => return parse_for(ast);
		token::TokenKind::While => return parse_while(ast);
		token::TokenKind::Match => return parse_match(ast);
		token::TokenKind::Break => return parse_simple_statement(ast, node::NodeKind::Break);
		token::TokenKind::Continue => return parse_simple_statement(ast, node::NodeKind::Continue);
		_ => {
			let expr = expr::parse(ast);
			if skip_expr_semicolon { return expr; }
			if !consume(ast, token::TokenKind::SemiColon) {
				return error(ast, err::ErrorKind::SemicolonExpected);
			}
			return expr;
		}
	}
}


fn parse_var_dec(ast: *Ast, mutable: bool): int {
	let span_start = curr_span(ast);

	let kind = node::NodeKind::VarDecl;
	if !mutable { kind = node::NodeKind::ConstDecl; }

	step(ast); // let/cost
	let ident = expr::parse_ident(ast);
	if ident == ERROR { return ERROR; }

	let type: *node::TypeData = null;
	if curr(ast) == token::TokenKind::Colon {
		step(ast);
		ast.typeident_context = TypeIdentContext::VarDeclaration;
		let res = parse_typeident::parse(ast);
		if !res.success { return ERROR; }
		type = node::allocate_extra(
			&ast.module.nodes,
			sizeof(node::TypeData),
		);
		type.span = res.span;
		type.type = res.type;
	}
	if !consume(ast, token::TokenKind::Equal) {
		return error(ast, err::ErrorKind::VarDeclEqExpected);
	}
	let value = expr::parse(ast);
	if value == ERROR { return ERROR; }
	if !consume(ast, token::TokenKind::SemiColon) {
		return error(ast, err::ErrorKind::SemicolonExpected);
	}

	let node = node_create(ast, kind);
	let var_decl: *VarDeclaration = node_data(ast, node);
	var_decl.ident = ident;
	var_decl.type = type;
	var_decl.value = value;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


pub fn parse_block(ast: *Ast): int {
	let span_start = curr_span(ast);

	if !consume(ast, token::TokenKind::BraceL) {
		return error(ast, err::ErrorKind::BlockExpected);
	}
	let count = 0;

	let had_error = false;
	loop {
		let c = curr(ast);
		// WARN: If I ever want to do inline declarations
		//	I will need to figure out how to recover from unterminated blocks
		//	As of today, recovering stops at the next "fn" but it keeps trying to push the same error, causing a huge memory fillup
		//	Potentially I could check if the ast.current changed after error recoveries
		if recovery::shared_recovery(c) {
			return error(ast, err::ErrorKind::UnterminatedBlock);
		}
		match curr(ast) {
		token::TokenKind::EOF =>
			return error(ast, err::ErrorKind::UnterminatedBlock);
		token::TokenKind::BraceR => {
			step(ast);
			break;
		}
		token::TokenKind::SemiColon => {
			step(ast);
		}
		_ => {
			let s = parse(ast);
			// stdlib::printf("Offset: %d\n", ast.current);
			if s == ERROR {
				had_error = true;
			} else {
				work_push(ast, s);
				count += 1;
			}
		}
	} }
	if had_error { return ERROR; }
	
	let node = node_create(ast, node::NodeKind::Block);
	let block: *BlockData = node_data(ast, node);
	node_set_span(ast, node, span_end(ast, span_start));
	block.nodes = node::allocate_extra(&ast.module.nodes, sizeof(int) * count);
	block.count = count;
	for let i = count - 1; i >= 0; i-=1 {
		let node = work_pop(ast);
		block.nodes[i] = node;
	}
	return node;
}


fn parse_return(ast: *Ast): int {
	let value = 0;
	let has_value = false;

	let span_start = curr_span(ast);
	step(ast); // return
	if curr(ast) != token::TokenKind::SemiColon {
		value = expr::parse(ast);
		has_value = true;
	}
	if !consume(ast, token::TokenKind::SemiColon) {
		return error(ast, err::ErrorKind::SemicolonExpected);
	}

	let node = node_create(ast, node::NodeKind::Return);
	let return_data: *ReturnData = node_data(ast, node);
	return_data.value = value;
	return_data.has_value = has_value;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn parse_if(ast: *Ast): int {
	let span_start = curr_span(ast);
	step(ast); // if

	ast.in_condition = true;
	let cond = expr::parse(ast);
	if cond == ERROR { return ERROR; }
	ast.in_condition = false;

	let then = parse_block(ast);
	if then == ERROR { return ERROR; }
	let otherwise = 0;
	if curr(ast) == token::TokenKind::Else {
		step(ast);
		if curr(ast) == token::TokenKind::If {
			otherwise = parse_if(ast);
		} else {
			otherwise = parse_block(ast);
		}
		if otherwise == ERROR { return ERROR; }
	}

	let node = node_create(ast, node::NodeKind::If);
	let if_data: *IfData = node_data(ast, node);
	if_data.cond = cond;
	if_data.then = then;
	if_data.otherwise = otherwise;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn parse_loop(ast: *Ast): int {
	let span_start = curr_span(ast);

	step(ast); // loop
	let body = parse_block(ast);
	if body == ERROR { return ERROR; }

	let node = node_create(ast, node::NodeKind::Loop);
	let loop_data: *LoopData = node_data(ast, node);
	loop_data.body = body;
	loop_data.has_cond = false;
	loop_data.cond = 0;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn parse_for(ast: *Ast): int {
	let span_start = curr_span(ast);
	step(ast); // for

	let init = 0;
	if curr(ast) == token::TokenKind::Let {
		init = parse_var_dec(ast, true);
	} else {
		init = expr::parse(ast);
		if !consume(ast, token::TokenKind::SemiColon) {
			return error(ast, err::ErrorKind::SemicolonExpected);
		}
	}

	ast.in_condition = true;
	let cond = expr::parse(ast);
	if cond == ERROR { return ERROR; }
	if !consume(ast, token::TokenKind::SemiColon) {
		return error(ast, err::ErrorKind::SemicolonExpected);
	}

	let acc = expr::parse(ast);
	if acc == ERROR { return ERROR; }
	ast.in_condition = false;

	let body = parse_block(ast);
	if body == ERROR { return ERROR; }

	// NOTE: For is stored completely on the extras
	let for_data: *ForData = node::allocate_extra(&ast.module.nodes, sizeof(ForData));
	for_data.init = init;
	for_data.cond = cond;
	for_data.acc = acc;
	for_data.body = body;

	let node = node_create(ast, node::NodeKind::For);
	let node_for_data: **ForData = node_data(ast, node);
	*node_for_data = for_data;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn parse_while(ast: *Ast): int {
	let span_start = curr_span(ast);
	step(ast); // while

	ast.in_condition = true;
	let cond = expr::parse(ast);
	ast.in_condition = false;
	if cond == ERROR { return ERROR; }

	let body = parse_block(ast);
	if body == ERROR { return ERROR; }

	let node = node_create(ast, node::NodeKind::Loop);
	let loop_data: *LoopData = node_data(ast, node);
	loop_data.has_cond = true;
	loop_data.cond = cond;
	loop_data.body = body;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}

fn parse_match(ast: *Ast): int {
	let span = curr_span(ast);
	step(ast); // match
	ast.in_condition = true;
	let cond = expr::parse(ast);
	ast.in_condition = false;
	if cond == ERROR { return ERROR; }
	if !consume(ast, token::TokenKind::BraceL) {
		return error(ast, err::ErrorKind::BlockExpected);
	}
	let case_count = 0;
	let had_errors = false;
	loop {
		if curr(ast) == token::TokenKind::BraceR { break; }

		let temp_match_case = MatchCase {};
		// TODO: We could probably continue parsing the other arms for these
		if !parse_match_cond(ast, &temp_match_case) { return ERROR; }
		if !consume(ast, token::TokenKind::FatArrow) {
			return error(ast, err::ErrorKind::MissingMatchArrow);
		}

		// TODO: This is a temporary workaround to support both ; and ,
		ast.skip_expr_semicolon = true;
		let arm = parse(ast);
		if arm == ERROR { had_errors = true; }
		if node::is_expression(&ast.module.nodes, arm) {
			match curr(ast) {
				token::TokenKind::SemiColon | 
				token::TokenKind::Comma => step(ast),
				_ => return error(ast, err::ErrorKind::SemicolonExpected);
			}
		}
		temp_match_case.arm = arm;

		let match_case: *MatchCase = workstack::push(
			&ast.workstack, sizeof(MatchCase)
		);
		*match_case = temp_match_case;
		case_count += 1;
	}
	step(ast); // }
	if had_errors { return ERROR; }

	let node = node_create(ast, node::NodeKind::Match);
	let match_data: *MatchData = node_data(ast, node);
	match_data.cond = cond;
	match_data.count = case_count;
	match_data.cases = node::allocate_extra(
		&ast.module.nodes,
		sizeof(MatchCase) * case_count,
	);
	for let i = case_count - 1; i >= 0; i-=1 {
		let case: *MatchCase = workstack::pop(&ast.workstack, sizeof(MatchCase));
		match_data.cases[i] = *case;
	}

	return node;
}

fn parse_match_cond(ast: *Ast, case: *MatchCase): bool {
	let cond_count = 0;
	let had_default = false;
	let had_error = false;
	loop {
		if match_identifier(ast, "_") {
			if had_default {
				had_error = true;
				error(ast, err::ErrorKind::DuplicateDefaultMatchCase);
			}
			had_default = true;
			case.has_default = true;
			step(ast);
		} else {
			// TODO: I should limit parsing expressions
			//	Since | is a binary OR op
			//	Either that or unwrap the OR expression into match conds
			let expr = expr::parse(ast);
			if expr == ERROR { had_error = true; }
			work_push(ast, expr);
			cond_count += 1;
		}
		if curr(ast) == token::TokenKind::Pipe {
			step(ast);
			continue;
		}
		break;
	}
	case.cond_count = cond_count;
	case.conds = node::allocate_extra(
		&ast.module.nodes,
		sizeof(int) * cond_count,
	);
	for let i = cond_count - 1; i >= 0; i-=1 {
		case.conds[i] = work_pop(ast);
	}
	return !had_error;
}

fn match_identifier(ast: *Ast, string: str): bool {
	if curr(ast) != token::TokenKind::Ident { return false; }
	let token = curr_token(ast);
	return stdlib::strcmp(string, token.data.ident) == 0;
}


fn parse_simple_statement(ast: *Ast, kind: node::NodeKind): int {
	let node = node_create(ast, kind);

	let span_start = curr_span(ast);
	step(ast);
	node_set_span(ast, node, span_end(ast, span_start));

	if !consume(ast, token::TokenKind::SemiColon) {
		return error(ast, err::ErrorKind::SemicolonExpected);
	}
	
	return node;
}


// /////////////////////////////////
// ///////////// DEBUG /////////////
// /////////////////////////////////


pub fn block_get(block: *BlockData, index: int): int {
	if index >= block.count { return node::NONE; }
	return block.nodes[index];
}


pub fn debug_var_decl(sb: *sb::StringBuilder, nodes: *node::Nodes, mutable: bool, var_decl: *VarDeclaration, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "VAR_DECL ");
	if mutable {
		sb::append(sb, "LET\n");
	} else {
		sb::append(sb, "CONST\n");
	}
	node::debug(sb, nodes, var_decl.ident, depth + 1);
	sb::repeat(sb, "  ", depth + 1);
	if var_decl.type != null {
		sb::append(sb, "TYPE: ");
		ty::debug(sb, nodes, var_decl.type.type, depth);
		sb::append(sb, "\n");
	} else {
		sb::append(sb, "TYPE: NONE\n");
	}
	node::debug(sb, nodes, var_decl.value, depth + 2);
}


pub fn debug_block(sb: *sb::StringBuilder, nodes: *node::Nodes, block: *BlockData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "BLOCK\n");
	for let i = 0; i < block.count; i+=1 {
		let n = block_get(block, i);
		stdlib::assert(n != node::NONE, "statement::debug_block");
		node::debug(sb, nodes, n, depth + 1);
	}
}


pub fn debug_if(sb: *sb::StringBuilder, nodes: *node::Nodes, if_data: *IfData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "IF\n");
	node::debug(sb, nodes, if_data.cond, depth + 1);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "THEN\n");
	node::debug(sb, nodes, if_data.then, depth + 2);
	if if_data.otherwise {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "ELSE\n");
		node::debug(sb, nodes, if_data.otherwise, depth + 2);
	}
}


pub fn debug_return(sb: *sb::StringBuilder, nodes: *node::Nodes, return_data: *ReturnData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "RETURN\n");
	if return_data.has_value {
		node::debug(sb, nodes, return_data.value, depth + 1);
	}
}


pub fn debug_loop(sb: *sb::StringBuilder, nodes: *node::Nodes, loop_data: *LoopData, depth: int) {
	sb::repeat(sb, "  ", depth);
	if loop_data.has_cond {
		sb::append(sb, "WHILE\n");
		node::debug(sb, nodes, loop_data.cond, depth + 1);
	} else {
		sb::append(sb, "LOOP\n");
	}
	node::debug(sb, nodes, loop_data.body, depth + 1);
}


pub fn debug_for(sb: *sb::StringBuilder, nodes: *node::Nodes, for_data: **ForData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "FOR\n");
	let for_data = *for_data;
	node::debug(sb, nodes, for_data.init, depth + 2);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "COND\n");
	node::debug(sb, nodes, for_data.cond, depth + 2);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "ACC\n");
	node::debug(sb, nodes, for_data.acc, depth + 2);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "BODY\n");
	node::debug(sb, nodes, for_data.body, depth + 2);
}


pub fn debug_match(sb: *sb::StringBuilder, nodes: *node::Nodes, match_data: *MatchData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "MATCH\n");
	node::debug(sb, nodes, match_data.cond, depth + 1);
	for let i = 0; i < match_data.count; i+=1 {
		let case = match_data.cases[i];

		if case.has_default {
			sb::repeat(sb, "  ", depth + 1);
			sb::append(sb, "[DEFAULT]\n");
		}
		for let i = 0; i < case.cond_count; i+=1 {
			node::debug(sb, nodes, case.conds[i], depth + 1);
		}
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "THEN\n");
		node::debug(sb, nodes, case.arm, depth + 2);
	}
}

