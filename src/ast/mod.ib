const stdlib = import "@stdlib"

pub const decl = import "./declaration.ib"
const err = import "../storage/error.ib"
const errors = import "./error.ib"
const ast = import "./ast.ib"
const node = import "./node.ib"
const vec = import "../utils/vec.ib"
const ty = import "./typeident.ib"
const symbols = import "../symbol/mod.ib"
const symbol = import "../symbol/symbol.ib"
const arena = import "../utils/arena.ib"
const workstack = import "../utils/workstack.ib"
const span = import "../storage/span.ib"

const lexer = import "../lexer/mod.ib"
const sb = import "../utils/stringbuilder.ib"

pub struct Module {
	uid: int,
	// Owned string
	file: str,
	nodes: node::Nodes,
	functions: vec::Vec, // Vec<decl::Function>
	extern_fns: vec::Vec, // Vec<decl::ExternFn>
	extern_globals: vec::Vec, // Vec<decl::ExternGlobal>
	globals: vec::Vec, // Vec<decl::Global>
	imports: vec::Vec, // Vec<decl::Import>
	args: vec::Vec, // Vec<decl::Arg>

	structs: vec::Vec, // Vec<decl::ObjectDef>,
	unions: vec::Vec, // Vec<decl::ObjectDef>,
	enums: vec::Vec, // Vec<decl::EnumDef>,
	object_data: arena::Arena, // Arena<ObjectField>
	type_idents: ty::TypeIdents,
}


pub struct AstRunResult {
	success: bool,
	module: Module,
}


pub fn run(file: str, tokens: lexer::Tokens, errors: *err::Errors): AstRunResult {
	for let i = 0; i < tokens.count; i+=1 {
		stdlib::assert(tokens.items[i].span < span::count(), "token");
	}

	let module_uid = symbols::insert_module(file);

	let result = AstRunResult {
		success: true,
		module: new_module(module_uid),
	};

	let parser = ast::new(tokens, &result.module, errors);
	parser.file = file;
	result.module.file = file;

	while ast::has_next(&parser) {
	match ast::next(&parser) {
		ast::Declaration::Error => {
			result.success = false;
			workstack::clear(&parser.workstack);
		}
		_ => {
			stdlib::assert(parser.workstack.size == 0, "ast::next workstack was not cleared!");
		}
	}
	}
	return result;
}


pub fn new_module(uid: int): Module {
	return Module {
		uid, file: null,
		// NOTE: Overtime, investigate these numbers, and check how valid they are
		functions: vec::new(sizeof(decl::Function), 32),

		extern_fns: vec::new(sizeof(decl::ExternFn), 8),
		extern_globals: vec::new(sizeof(decl::ExternGlobal), 8),
		args: vec::new(sizeof(decl::Arg), 256),

		imports: vec::new(sizeof(decl::Import), 16),
		globals: vec::new(sizeof(decl::Global), 16),
		structs: vec::new(sizeof(decl::ObjectDef), 16),
		unions: vec::new(sizeof(decl::ObjectDef), 16),
		enums: vec::new(sizeof(decl::EnumDef), 16),
		object_data: arena::new(sizeof(decl::ObjectField) * 128),
		nodes: node::new(),
		type_idents: ty::new(uid),
	};
}


pub fn free_module(module: *Module, print_usage: bool) {
	let functions_usage = vec::free(&module.functions);
	let args_usage = vec::free(&module.args);
	let globals_usage = vec::free(&module.globals);
	let imports_usage = vec::free(&module.imports);
	let structs_usage = vec::free(&module.structs);
	let enums_usage = vec::free(&module.enums);
	let unions_usage = vec::free(&module.unions);
	let object_data_usage = arena::free(&module.object_data);
	let extern_fns_usage = vec::free(&module.extern_fns);
	let extern_globals_usage = vec::free(&module.extern_globals);
	if print_usage {
		stdlib::printf("Functions Usage: %d\n", functions_usage);
		stdlib::printf("Args Usage: %d\n", args_usage);
		stdlib::printf("Globals Usage: %d\n", globals_usage);
		stdlib::printf("Imports Usage: %d\n", imports_usage);
		stdlib::printf("Structs Usage: %d\n", structs_usage);
		stdlib::printf("Enums Usage: %d\n", enums_usage);
		stdlib::printf("Unions Usage: %d\n", unions_usage);
		stdlib::printf("ObjectData Usage: %d\n", object_data_usage);
		stdlib::printf("ExternFunctions Usage: %d\n", extern_fns_usage);
		stdlib::printf("ExternGlobals Usage: %d\n", extern_globals_usage);
	}
	node::free(&module.nodes);
}


fn print_declarations(module: *Module, v: *vec::Vec, print_fn: fn(*Module, *any): void) {
	for let i = 0; i < v.count; i+=1 {
		print_fn(module, vec::get(v, i));
		stdlib::putchar('\n');
	}
	if v.count > 0 {
		stdlib::putchar('\n');
	}
}


pub fn print_module(module: *Module) {
	print_declarations(module, &module.imports, decl::print_import);
	print_declarations(module, &module.extern_fns, decl::print_extern_fn);
	print_declarations(module, &module.extern_globals, decl::print_extern_global);
	print_declarations(module, &module.structs, decl::print_struct);
	print_declarations(module, &module.unions, decl::print_union);
	print_declarations(module, &module.enums, decl::print_enum);
	print_declarations(module, &module.globals, decl::print_global);
	print_declarations(module, &module.functions, decl::print_function);
}

fn debug_declarations(sb: *sb::StringBuilder, module: *Module, v: *vec::Vec, debug_fn: fn(*sb::StringBuilder, *Module, *any): void) {
	for let i = 0; i < v.count; i+=1 {
		debug_fn(sb, module, vec::get(v, i));
		sb::append(sb, "\n");
	}
}


pub fn debug_module(sb: *sb::StringBuilder, module: *Module) {
	debug_declarations(sb, module, &module.imports, decl::debug_import);
	debug_declarations(sb, module, &module.extern_fns, decl::debug_extern_fn);
	debug_declarations(sb, module, &module.extern_globals, decl::debug_extern_global);
	debug_declarations(sb, module, &module.structs, decl::debug_struct);
	debug_declarations(sb, module, &module.unions, decl::debug_union);
	debug_declarations(sb, module, &module.enums, decl::debug_enum);
	debug_declarations(sb, module, &module.globals, decl::debug_global);
	debug_declarations(sb, module, &module.functions, decl::debug_function);
}


fn create_symbols_for_kind(
	module_uid: int,
	v: *vec::Vec,
	ident_fn: fn(*any): str,
	is_public_fn: fn(*any): bool,
	span_fn: fn(*any): int,
	kind: symbol::SymbolKind,
	is_extern: bool,
) {
	for let i = 0; i < v.count; i+=1 {
		let d = vec::get(v, i);
		let symbol = symbols::insert(
			module_uid, ident_fn(d), is_public_fn(d),
			kind, span_fn(d)
		);
		symbol.is_extern = is_extern;
		symbol.shallow.unknown = d;
	}
}

fn func_ident(f: *decl::Function): str { return f.proto.identifier; }
fn func_public(f: *decl::Function): bool { return f.is_public; }
fn func_span(f: *decl::Function): int { return f.proto.span; }

fn global_ident(g: *decl::Global): str { return g.identifier; }
fn global_public(g: *decl::Global): bool { return g.is_public; }
fn global_span(g: *decl::Global): int { return g.span; }

fn extfn_ident(e: *decl::ExternFn): str { return e.proto.identifier; }
fn extfn_public(e: *decl::ExternFn): bool { return e.is_public; }
fn extfn_span(e: *decl::ExternFn): int { return e.proto.span; }

fn extglobal_ident(e: *decl::ExternGlobal): str { return e.identifier; }
fn extglobal_public(e: *decl::ExternGlobal): bool { return e.is_public; }
fn extglobal_span(e: *decl::ExternGlobal): int { return e.span; }

fn objdef_ident(o: *decl::ObjectDef): str { return o.identifier; }
fn objdef_public(o: *decl::ObjectDef): bool { return o.is_public; }
fn objdef_span(o: *decl::ObjectDef): int { return o.span; }

fn enumdef_ident(e: *decl::EnumDef): str { return e.identifier; }
fn enumdef_public(e: *decl::EnumDef): bool { return e.span; }
fn enumdef_span(e: *decl::EnumDef): int { return e.span; }

fn import_alias(e: *decl::Import): str { return e.alias; }
fn import_span(e: *decl::Import): int { return e.alias_span; }

pub fn create_symbols(module: *Module) {
	// TODO: imports?
	// Maybe it would be a bit too early for them though, instead we need to canonicalize them first
	create_symbols_for_kind(module.uid, &module.extern_fns, extfn_ident, extfn_span, extfn_public, symbol::SymbolKind::Function, true);
	create_symbols_for_kind(module.uid, &module.extern_globals, extglobal_ident, extglobal_span, extglobal_public, symbol::SymbolKind::Global, true);

	create_symbols_for_kind(module.uid, &module.globals, global_ident, global_span, global_public, symbol::SymbolKind::Global, false);
	create_symbols_for_kind(module.uid, &module.functions, func_ident, func_span, func_public, symbol::SymbolKind::Function, false);
	create_symbols_for_kind(module.uid, &module.structs, objdef_ident, objdef_span, objdef_public, symbol::SymbolKind::Struct, false);
	create_symbols_for_kind(module.uid, &module.unions, objdef_ident, objdef_span, objdef_public, symbol::SymbolKind::Union, false);
	create_symbols_for_kind(module.uid, &module.enums, enumdef_ident, enumdef_span, enumdef_public, symbol::SymbolKind::Enum, false);
}


struct IdentEntry {
	ident: str,
	span: int,
}
fn check_name_duplicates_for_kind(
	errors: *err::Errors,
	idents: *vec::Vec, 
	v: *vec::Vec, 
	ident_fn: fn(*any): str,
	span_fn: fn(*any): int,
): bool {
	let had_errors = false;
	for let i = 0; i < v.count; i+=1 {
		let d = vec::get(v, i);
		let ident = ident_fn(d);
		let span = span_fn(d);
		if ident == null { continue; }
		let had_duplicate = false;
		for let j = 0; j < idents.count; j+=1 {
			let existing: *IdentEntry = vec::get(idents, j);
			if ident == existing.ident {
				let err = err::parser_error(errors);
				err.span = span;
				errors::append_message(&errors.builder, errors::ErrorKind::DuplicateSymbol);
				err.message = sb::build(&errors.builder);
				sb::reset(&errors.builder);
				had_duplicate = true;
				break;
			}
		}
		if had_duplicate {
			had_errors = true;
		} else {
			let entry: *IdentEntry = vec::push(idents);
			*entry = IdentEntry { ident, span };
		}

	}
	return had_errors;
}

pub fn check_name_duplicates(module: *Module, errors: *err::Errors): bool {
	let count = module.functions.count +
		module.extern_fns.count +
		module.extern_globals.count +
		module.globals.count +
		module.imports.count +
		module.structs.count +
		module.unions.count +
		module.enums.count;
	let idents = vec::new(sizeof(IdentEntry), count);

	let had_errors = false;
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.extern_fns, extfn_ident, extfn_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.extern_globals, extglobal_ident, extglobal_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.globals, global_ident, global_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.functions, func_ident, func_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.structs, objdef_ident, objdef_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.unions, objdef_ident, objdef_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.enums, enumdef_ident, enumdef_span);
	had_errors = had_errors || check_name_duplicates_for_kind(errors, &idents, &module.imports, import_alias, import_span);
	vec::free(&idents);
	return had_errors;
}


