const token = import "../lexer/token.ib"
import "./ast.ib"
const err = import "./error.ib"

pub fn recover_from_error(ast: *Ast, kind: err::ErrorKind) {
	match kind {
		err::ErrorKind::TODO => {}
		err::ErrorKind::DuplicateSymbol => {}

		// NOTE: Usually means EOF
		err::ErrorKind::UnterminatedBlock | 
		err::ErrorKind::UnterminatedParen | 
		err::ErrorKind::UnterminatedBracket => skip_until(ast, shared_recovery),

		// TODO: Probably best to figure out a better recovery method for matches
		err::ErrorKind::MissingMatchArrow |
		err::ErrorKind::DuplicateDefaultMatchCase => skip_until(ast, semicolon_recovery),

		// NOTE: Errors from Expr context
		err::ErrorKind::ObjectInitNameExpected |
		err::ErrorKind::SemicolonExpected |
		err::ErrorKind::BlockExpected |
		err::ErrorKind::CommaExpected |
		err::ErrorKind::InvalidPrimary |
		err::ErrorKind::VarDeclEqExpected |
		err::ErrorKind::SizeOfMissingParenL |
		err::ErrorKind::SizeOfMissingParenR |
		err::ErrorKind::IdentifierExpected | 
		err::ErrorKind::ObjectInitFieldExpected |
		err::ErrorKind::ObjectInitCommaExpected
			 => skip_until(ast, statement_recovery),

		// NOTE: Top level errors
		err::ErrorKind::DuplicatePubForDeclaration | 
		err::ErrorKind::ImportCannotBePublic | 
		err::ErrorKind::ImportAliasEqExpected | 
		err::ErrorKind::ImportPathExpected | 
		err::ErrorKind::ImportAliasExpected | 
		err::ErrorKind::ObjectDefBraceLExpected |
		err::ErrorKind::ObjectDefCommaExpected |
		err::ErrorKind::InvalidExtern |
		err::ErrorKind::GlobalNameExpected |
		err::ErrorKind::ExternGlobalNameExpected |
		err::ErrorKind::UnknownDeclaration => skip_until(ast, shared_recovery),

		// TODO: Functions should attempt to parse body even if proto fails

		err::ErrorKind::PrototypeParenLExpected |
		err::ErrorKind::PrototypeArgsAfterVarargsNotAllowed |
		err::ErrorKind::PrototypeArgExpected |
		err::ErrorKind::PrototypeParenRExpected |
		err::ErrorKind::PrototypeNameExpected =>
			skip_until(ast, next_block_recovery),

		// TODO: Break these up into more unique cases
		// Since we will need to know where we are
		err::ErrorKind::InvalidTypeIdent |
		err::ErrorKind::TypeIdentPathExpected | 
		err::ErrorKind::TypeIdentFnParenExpected | 
		err::ErrorKind::TypeIdentExpected | 
		err::ErrorKind::MissingTypeIdent | 
		err::ErrorKind::TypeIdentFnFlowTypeRequired | 
		err::ErrorKind::TypeIdentArrayBracketRExpected => {
			match ast.typeident_context {
				TypeIdentContext::ObjectDef => skip_until(ast, object_recovery),
				TypeIdentContext::VarDeclaration => skip_until(ast, var_decl_recovery),
				TypeIdentContext::ProtoArgs => skip_until(ast, proto_arg_recovery),
				TypeIdentContext::ProtoFlowType => skip_until(ast, proto_flow_recovery),
				TypeIdentContext::SizeOf => skip_until(ast, semicolon_recovery),
				TypeIdentContext::Cast => skip_until(ast, semicolon_recovery),
			}
		}

		err::ErrorKind::ObjectDefNameExpected |
		err::ErrorKind::EnumDefNameExpected => skip_until(ast, shared_recovery),


		// NOTE: Inside an object definition like shape
		err::ErrorKind::ObjectDefFieldExpected |
		err::ErrorKind::EnumDefFieldExpected |
		err::ErrorKind::EnumDefBraceLExpected |
		err::ErrorKind::EnumDefCommaExpected |
		err::ErrorKind::ObjectDefColonExpected
			=> skip_until(ast, object_recovery),
	}
}

fn skip_until(ast: *Ast, pred: fn(token::TokenKind): bool) {
	loop {
		let t = curr(ast);
		if t == token::TokenKind::EOF { return; }
		let res = pred(t);
		match pred(t) {
			RecoveryResult::Recovered => return;
			RecoveryResult::RecoveredOnNext => {
				step(ast);
				return;
			}
			RecoveryResult::Skip => {}
		}

		step(ast);
	}
}


fn skip_until_object_field_end(ast: *Ast) {
	loop { match curr(ast) {
		token::TokenKind::EOF => return;
		token::TokenKind::Comma | 
		token::TokenKind::BraceR => {
			step(ast);
			return;
		}
		_ => step(ast),
	}}
}

enum RecoveryResult {
	Skip,
	Recovered,
	RecoveredOnNext,
}
fn semicolon_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::SemiColon |
		token::TokenKind::BraceR
			=> return RecoveryResult::Recovered;
		_ => return shared_recovery(token);
	}
}

fn statement_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::Let |
		token::TokenKind::Const |
		token::TokenKind::If |
		// NOTE: Else is not really a good spot for this
		// token::TokenKind::Else |
		token::TokenKind::While |
		token::TokenKind::Loop |
		token::TokenKind::For |
		token::TokenKind::Break |
		token::TokenKind::Continue |
		token::TokenKind::Match |
		token::TokenKind::Return
			=> return RecoveryResult::Recovered;
		token::TokenKind::SemiColon 
			=> return RecoveryResult::RecoveredOnNext;
		token::TokenKind::BraceL
			=> return RecoveryResult::Recovered;
		_ => return shared_recovery(token);
	}
}

fn next_block_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::BraceL => return RecoveryResult::Recovered;
		_ => return shared_recovery(token);
	}
}

fn object_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::BraceR |
		token::TokenKind::Comma => return RecoveryResult::RecoveredOnNext;
		_ => return shared_recovery(token);
	}
}

fn var_decl_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::Equal => return RecoveryResult::Recovered;
		_ => return semicolon_recovery(token);
	}
}

fn proto_arg_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::ParenR |
		token::TokenKind::Comma => return RecoveryResult::RecoveredOnNext;
		_ => return shared_recovery(token);
	}
}
fn proto_flow_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::BraceL => return RecoveryResult::Recovered;
		_ => return shared_recovery(token);
	}
}

pub fn shared_recovery(token: token::TokenKind): RecoveryResult {
	match token {
		token::TokenKind::EOF |
		token::TokenKind::Import |
		token::TokenKind::Fn |
		token::TokenKind::Extern |
		token::TokenKind::Struct |
		token::TokenKind::Union |
		token::TokenKind::Pub |
		token::TokenKind::Enum 
			=> return RecoveryResult::Recovered;
		_ => return RecoveryResult::Skip;
	}
}
