const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"
const workstack = import "../utils/workstack.ib"

const span = import "../storage/span.ib"
const token = import "../lexer/token.ib"

import "./ast.ib"
const err = import "./error.ib"
const node = import "./node.ib"
const ty = import "./typeident.ib"
const statement = import "./statement.ib"
const prec = import "./precedence.ib"
const object = import "./object.ib"
const parse_typeident = import "./parse_typeident.ib"


pub struct Cast {
	expr: int,
	type: *ty::TypeIdent,
	type_span: int,
}


pub struct Array {
	elem_count: int,
	elems: *int,
}


pub struct Call {
	callee: int,
	arg_count: int,
	args: *int,
}


// NOTE: Are we sure we need to use str for type?
pub struct ObjectInit {
	type: str,
	field_count: int,
	fields: *ObjectFieldInit,
}


pub struct ObjectFieldInit {
	field: str,
	field_span: int,
	value: int,
}


pub enum BinaryOp {
	None,
	Add, Sub,
	Mul, Div, Rem,

	Assign,
	AssignAdd, AssignSub,
	AssignMul, AssignDiv, AssignRem,

	EQ, NE,
	GT, GE,
	LT, LE,
	And, Or,

	BitAnd, BitOr, BitXor,
	BitShiftRight, BitShiftLeft,

	Index,

	FieldLookup,
	Path,
}

pub struct Binary {
	op: BinaryOp,
	lhs: int,
	rhs: int,
}


pub enum UnaryOp {
	Group,
	Ref,
	Deref,
	Pos,
	Neg,
	Not,
	BitNot,
}

pub struct Unary {
	op: UnaryOp,
	expr: int,
}


pub struct Literal {
	kind: LiteralKind,
	value: LiteralValue,
}


pub enum LiteralKind {
	Number,
	Float,
	String,
	Char,
	Bool,
	Null,
}


pub union LiteralValue {
	number: int,
	flt: float,
	string: str,
	chr: char,
	boolean: bool,
}


pub fn array_get(array: *Array, index: int): int {
	if index >= array.elem_count { return node::NONE; }
	return array.elems[index];
}



pub fn parse(ast: *Ast): int {
	return parse_expr_prec(ast, 0);
}


fn parse_expr_prec(ast: *Ast, min_prec: int): int {
	let lhs = primary(ast);
	if lhs == ERROR { return ERROR; }
	loop {
		let op = curr(ast);
		if op == token::TokenKind::EOF || op == token::TokenKind::SemiColon {
			break;
		}

		let infix = prec::get_infix(&ast.infix, op);
		if infix != null {
			if infix.prec < min_prec { break; }
			match infix.rhs_kind {
			prec::RHSKind::Expr => {
				step(ast); // Consume the operator
				let rhs = parse_expr_prec(ast, infix.new_prec);
				if rhs == ERROR { return ERROR; }
				// NOTE: Maybe we can support suffix for other kinds
				if infix.suffix != token::TokenKind::None {
					if !consume(ast, infix.suffix) { return error(ast, infix.suffix_err); }
				}
				lhs = binary(ast, infix.op, lhs, rhs);
			}
			prec::RHSKind::Call => {
				lhs = parse_call(ast, lhs);
				if lhs == ERROR { return ERROR; }
			}
			prec::RHSKind::Cast => {
				step(ast); // Consume the operator
				lhs = parse_cast(ast, lhs);
				if lhs == ERROR { return ERROR; }
			}
			}
		} else {
			break;
		}
	}
	return lhs;
}


fn parse_cast(ast: *Ast, lhs: int): int {
	let span_start = curr_span(ast);

	ast.typeident_context = TypeIdentContext::Cast;
	let ty_res = parse_typeident::parse(ast);
	if !ty_res.success { return ERROR; }

	let lhs_span = node_get_span(ast, lhs);
	let rhs_span = ty_res.span;

	let node = node_create(ast, node::NodeKind::Cast);
	let cast_data: *Cast = node_data(ast, node);
	cast_data.expr = lhs;
	cast_data.type = ty_res.type;
	cast_data.type_span = ty_res.span;
	node_set_span(ast, node, span::merge(lhs_span, rhs_span));
	return node;
}


fn parse_call(ast: *Ast, callee: int): int {
	let span_start = curr_span(ast);

	step(ast); // (
	let arg_count = 0;
	loop { match curr(ast) {
		token::TokenKind::EOF =>
			return error(ast, err::ErrorKind::UnterminatedParen);
		token::TokenKind::ParenR => {
			step(ast);
			break;
		}
		_ => {
			let arg = parse(ast);
			if arg == ERROR { return ERROR; }
			arg_count += 1;
			work_push(ast, arg);

			if curr(ast) == token::TokenKind::Comma {
				step(ast);
			} else if consume(ast, token::TokenKind::ParenR) {
				break;
			} else {
				return error(ast, err::ErrorKind::CommaExpected);
			}
		}
	}}

	let node = node_create(ast, node::NodeKind::Call);
	let call_data: *Call = node_data(ast, node);
	call_data.callee = callee;

	call_data.args = node::allocate_extra(&ast.module.nodes, sizeof(int) * arg_count);
	call_data.arg_count = arg_count;
	for let i = arg_count - 1; i >= 0; i-=1 {
		call_data.args[i] = work_pop(ast);
	}

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn binary(ast: *Ast, op: BinaryOp, lhs: int, rhs: int): int {
	let node = node_create(ast, node::NodeKind::Binary);
	let binary: *Binary = node_data(ast, node);
	binary.op = op;
	binary.lhs = lhs;
	binary.rhs = rhs;
	let lhs_span = node_get_span(ast, lhs);
	let rhs_span = node_get_span(ast, rhs);
	node_set_span(ast, node, span::merge(lhs_span, rhs_span));
	return node;
}


fn unary(ast: *Ast, op: UnaryOp, expr: int, span_start: int): int {
	let node = node_create(ast, node::NodeKind::Unary);
	let unary: *Unary = node_data(ast, node);
	unary.op = op;
	unary.expr = expr;
	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn parse_prefix_op(ast: *Ast): int {
	let op = curr(ast);
	let pref = prec::get_prefix(&ast.prefix, op);
	if pref == null { return ERROR; }

	let span_start = curr_span(ast);
	step(ast); // consume op

	let expr = parse_expr_prec(ast, pref.new_prec);
	if expr == ERROR { return ERROR; }

	if pref.suffix != token::TokenKind::None {
		if !consume(ast, pref.suffix) {
			return error(ast, pref.suffix_err);
		}
	}
	return unary(ast, pref.op, expr, span_start);
}


fn primary(ast: *Ast): int {
	match curr(ast) {
		token::TokenKind::LiteralInt => return literal(ast, LiteralKind::Number);
		token::TokenKind::LiteralFloat => return literal(ast, LiteralKind::Float);
		token::TokenKind::LiteralString => return literal(ast, LiteralKind::String);
		token::TokenKind::LiteralChar => return literal(ast, LiteralKind::Char);
		token::TokenKind::True => return literal_bool(ast, true);
		token::TokenKind::False => return literal_bool(ast, false);
		token::TokenKind::Null => return literal(ast, LiteralKind::Null);
		token::TokenKind::Ident => {
			let is_struct_allowed = !ast.in_condition;
			if is_struct_allowed && peek(ast, 1) == token::TokenKind::BraceL {
				return object::parse_object_init(ast);
			} else {
				return parse_ident(ast);
			}
		}
		token::TokenKind::SizeOf => return parse_sizeof(ast);
		token::TokenKind::BracketL => return parse_array_init(ast);
		_ => {
			let expr = parse_prefix_op(ast);
			if expr == ERROR { return error(ast, err::ErrorKind::InvalidPrimary); }
			return expr;
		}
	}
}

fn parse_array_init(ast: *Ast): int {
	let span_start = curr_span(ast);
	step(ast); // [

	let elem_count = 0;
	loop {
		if curr(ast) == token::TokenKind::EOF {
			return error(ast, err::ErrorKind::UnterminatedBracket);
		}
		if curr(ast) == token::TokenKind::BracketR {
			step(ast);
			break;
		}
		let elem = parse(ast);
		if elem == ERROR { return ERROR; }
		work_push(ast, elem);
		elem_count += 1;

		if curr(ast) == token::TokenKind::Comma {
			step(ast);
			continue;

		}
		if !consume(ast, token::TokenKind::BracketR) {
			return error(ast, err::ErrorKind::CommaExpected);
		}
		break;
	}

	let node = node_create(ast, node::NodeKind::Array);
	let array: *Array = node_data(ast, node);
	array.elem_count = elem_count;
	array.elems = node::allocate_extra(
		&ast.module.nodes,
		sizeof(int) * array.elem_count,
	);
	for let i = array.elem_count - 1; i >= 0; i-=1 {
		array.elems[i] = work_pop(ast);
	}

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


fn parse_sizeof(ast: *Ast): int {
	let span_start = curr_span(ast);
	step(ast); // sizeof
	if !consume(ast, token::TokenKind::ParenL) {
		return error(ast, err::ErrorKind::SizeOfMissingParenL);
	}
	ast.typeident_context = TypeIdentContext::SizeOf;
	let type_res = parse_typeident::parse(ast);
	if !type_res.success { return ERROR; }

	if !consume(ast, token::TokenKind::ParenR) {
		return error(ast, err::ErrorKind::SizeOfMissingParenR);
	}

	let node = node_create(ast, node::NodeKind::SizeOf);
	let size_of: *node::TypeData = node_data(ast, node);
	size_of.type = type_res.type;
	size_of.span = type_res.span;

	node_set_span(ast, node, span_end(ast, span_start));
	return node;
}


pub fn parse_ident(ast: *Ast): int {
	let node = node_create(ast, node::NodeKind::Ident);
	let ident: *str = node_data(ast, node);

	node_set_span(ast, node, curr_span(ast));
	if consume_ident(ast, ident, err::ErrorKind::IdentifierExpected) == ERROR { return ERROR; }

	return node;
}


fn literal(ast: *Ast, kind: LiteralKind): int {
	let node = node_create(ast, node::NodeKind::Literal);
	let literal: *Literal = node_data(ast, node);
	let token = curr_token(ast);
	literal.kind = kind;
	literal.value = *(((&token.data) as *any) as *LiteralValue);
	node_set_span(ast, node, curr_span(ast));
	step(ast);
	return node;
}


fn literal_bool(ast: *Ast, value: bool): int {
	let node = node_create(ast, node::NodeKind::Literal);
	let literal: *Literal = node_data(ast, node);
	literal.kind = LiteralKind::Bool;
	literal.value.boolean = value;

	node_set_span(ast, node, curr_span(ast));
	step(ast);
	return node;
}


// /////////////////////////////////
// ///////////// DEBUG /////////////
// /////////////////////////////////


pub fn debug_call(sb: *sb::StringBuilder, nodes: *node::Nodes, call: *Call, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "[CALL] CALLEE:\n");
	node::debug(sb, nodes, call.callee, depth + 1);
	for let i = 0; i < call.arg_count; i+=1 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "ARG[");
		sb::append_number(sb, i);
		sb::append(sb, "]\n");
		node::debug(sb, nodes, call.args[i], depth + 1);
	}
}


pub fn debug_unary(sb: *sb::StringBuilder, nodes: *node::Nodes, unary: *Unary, depth: int) {
	sb::repeat(sb, "  ", depth);
	match unary.op {
		UnaryOp::Group => sb::append(sb, "GROUP\n"),
		UnaryOp::Ref   => sb::append(sb, "REF\n"),
		UnaryOp::Deref => sb::append(sb, "DEREF\n"),
		UnaryOp::Pos   => sb::append(sb, "POS\n"),
		UnaryOp::Neg   => sb::append(sb, "NEG\n"),
		UnaryOp::Not   => sb::append(sb, "NOT\n"),
		UnaryOp::BitNot=> sb::append(sb, "BITNOT\n"),
	}
	node::debug(sb, nodes, unary.expr, depth + 1);
}


pub fn debug_binary(sb: *sb::StringBuilder, nodes: *node::Nodes, binary: *Binary, depth: int) {
	sb::repeat(sb, "  ", depth);
	match binary.op {
		BinaryOp::None    => sb::append(sb, "NONE\n"),
		BinaryOp::Add     => sb::append(sb, "ADD\n"),
		BinaryOp::Sub     => sb::append(sb, "SUB\n"),
		BinaryOp::Mul     => sb::append(sb, "MUL\n"),
		BinaryOp::Div     => sb::append(sb, "DIV\n"),
		BinaryOp::Rem     => sb::append(sb, "REM\n"),
		BinaryOp::Assign  => sb::append(sb, "ASSIGN\n"),
		BinaryOp::AssignAdd => sb::append(sb, "ASSIGN_ADD\n"),
		BinaryOp::AssignSub => sb::append(sb, "ASSIGN_SUB\n"),
		BinaryOp::AssignMul => sb::append(sb, "ASSIGN_MUL\n"),
		BinaryOp::AssignDiv => sb::append(sb, "ASSIGN_DIV\n"),
		BinaryOp::AssignRem => sb::append(sb, "ASSIGN_REM\n"),
		BinaryOp::EQ  => sb::append(sb, "EQ\n"),
		BinaryOp::NE  => sb::append(sb, "NE\n"),
		BinaryOp::GT  => sb::append(sb, "GT\n"),
		BinaryOp::GE  => sb::append(sb, "GE\n"),
		BinaryOp::LT  => sb::append(sb, "LT\n"),
		BinaryOp::LE  => sb::append(sb, "LE\n"),
		BinaryOp::And => sb::append(sb, "AND\n"),
		BinaryOp::Or  => sb::append(sb, "OR\n"),
		BinaryOp::Index       => sb::append(sb, "INDEX\n"),
		BinaryOp::FieldLookup => sb::append(sb, "FIELD_LOOKUP\n"),
		BinaryOp::Path        => sb::append(sb, "PATH\n"),
		BinaryOp::BitOr       => sb::append(sb, "BIT_OR\n"),
		BinaryOp::BitXor      => sb::append(sb, "BIT_XOR\n"),
		BinaryOp::BitAnd      => sb::append(sb, "BIT_AND\n"),
		BinaryOp::BitShiftRight => sb::append(sb, "BIT_SHIFT_RIGHT\n"),
		BinaryOp::BitShiftLeft  => sb::append(sb, "BIT_SHIFT_LEFT\n"),
	}
	node::debug(sb, nodes, binary.lhs, depth + 1);
	node::debug(sb, nodes, binary.rhs, depth + 1);
}


pub fn debug_literal(sb: *sb::StringBuilder, literal: *Literal, depth: int) {
	sb::repeat(sb, "  ", depth);
	match literal.kind {
		LiteralKind::Number => {
			sb::append(sb, "[LITERAL] NUMBER = ");
			sb::append_number(sb, literal.value.number);
		}
		LiteralKind::Float  => {
			sb::append(sb, "[LITERAL] FLOAT = ");
			sb::append_float(sb, literal.value.flt, 6);
			// TODO: change this to this once supported
			// sb::append_number(sb, literal.value.flt);
		}
		LiteralKind::String => {
			sb::append(sb, "[LITERAL] STRING = ");
			sb::append(sb, literal.value.string);
		}
		LiteralKind::Char => {
			sb::append(sb, "[LITERAL]  CHAR = ");
			sb::append_debug_char(sb, literal.value.chr);
		}
		LiteralKind::Bool => {
			if literal.value.boolean {
				sb::append(sb, "[LITERAL] TRUE");
			} else {
				sb::append(sb, "[LITERAL] FALSE");
			}
		}
		LiteralKind::Null => sb::append(sb, "[LITERAL] NULL"),
	}
	sb::append_char(sb, '\n');
}


pub fn debug_sizeof(sb: *sb::StringBuilder, nodes: *node::Nodes, size_of: *node::TypeData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "SIZEOF\n");

	sb::repeat(sb, "  ", depth);
	ty::debug(sb, nodes, size_of.type, depth);
	sb::append(sb, "\n");
}


pub fn debug_object_init(sb: *sb::StringBuilder, nodes: *node::Nodes, obj_init: *ObjectInit, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "OBJECT_INIT ");
	sb::append(sb, obj_init.type);
	sb::append(sb, "\n");
	for let i = 0; i < obj_init.field_count; i+=1 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, obj_init.fields[i].field);
		sb::append(sb, "\n");
		let value = obj_init.fields[i].value;
		if value != node::NONE {
			node::debug(sb, nodes, value, depth + 2);
		}
	}
}


pub fn debug_array(sb: *sb::StringBuilder, nodes: *node::Nodes, array: *Array, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "ARRAY\n");
	for let i = 0; i < array.elem_count; i+=1 {
		let n = array_get(array, i);
		node::debug(sb, nodes, n, depth + 1);
	}
}


pub fn debug_cast(sb: *sb::StringBuilder, nodes: *node::Nodes, cast: *Cast, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "CAST\n");
	node::debug(sb, nodes, cast.expr, depth + 1);
	sb::repeat(sb, "  ", depth);
	ty::debug(sb, nodes, cast.type, depth);
	sb::append(sb, "\n");
}


