const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"

import "./mod.ib"
import "./function.ib"
const err = import "./error.ib"

const ast_node = import "../ast/node.ib"
const ast_expr = import "../ast/expr.ib"

const node = import "./node.ib"
const ty = import "./typeident.ib"
const cast = import "./cast.ib"


pub struct Array {
	count: int,
	elems: *int, // *NodeIdx
}


pub fn typecheck(
	context: *FunctionContext,
	data: ast_expr::Array,
	span: int,
): int {
	let array = Array {
		count: data.elem_count,
		elems: node::allocate_extra(
			context.nodes,
			sizeof(int) * data.elem_count
		),
	};
	for let i = 0; i < data.elem_count; i+=1 {
		let res = node::typecheck(context, data.elems[i]);
		array.elems[i] = res.node;
	}
	let shared = find_array_type(context, array.elems, array.count, span);

	if shared != null {
	for let i = 0; i < data.elem_count; i+=1 {
		let is_ok = true;
		array.elems[i] = cast::implicit(
			context, array.elems[i], 
			shared, &is_ok
		);
		// TODO: Think about whenever I need to report anything here
	}}

	// TODO: Figure out the dimensions and len
	//        Probably will have to merge the array types into one
	let dimensions = [array.count];
	let dim_len = 1;
	let type = ty::into_array(
		&context.parent.typeidents,
		shared, dimensions, dim_len
	);
	return node::push(
		context.nodes, node::NodeKind::Array,
		type, node::NodeData { array }, span,
	);
}


