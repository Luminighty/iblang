const cast = import "./cast.ib"
const err = import "./error.ib"


pub struct Array {
	count: int,
	elems: *int, // *NodeIdx
}

pub struct Index {
	index: int, // NodeIdx
	array: int, // NodeIdx
}


pub fn typecheck(
	context: *FunctionContext,
	data: ast_expr::Array,
	span: int,
): int {
	let array = Array {
		count: data.elem_count,
		elems: node::allocate_extra(
			context.nodes,
			sizeof(int) * data.elem_count
		),
	};
	for let i = 0; i < data.elem_count; i+=1 {
		let res = node::typecheck(context, data.elems[i]);
		array.elems[i] = res.node;
	}
	let shared = find_array_type(context, array.elems, array.count, span);

	if shared != null {
	for let i = 0; i < data.elem_count; i+=1 {
		let is_ok = true;
		array.elems[i] = cast::implicit(
			context, array.elems[i], 
			shared, &is_ok
		);
		// TODO: Think about whenever I need to report anything here
	}}

	// TODO: Figure out the dimensions and len
	//        Probably will have to merge the array types into one
	let dimensions = [array.count];
	let dim_len = 1;
	let type = ty::into_array(
		&context.parent.typeidents,
		shared, dimensions, dim_len
	);
	return node::push(
		context.nodes, node::NodeKind::Array,
		type, node::NodeData { array }, span,
	);
}


pub fn typecheck_index(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	let array_res = node::typecheck(context, data.lhs);
	let idx_res = node::typecheck(context, data.rhs);
	let array = array_res.node;
	let idx = idx_res.node;

	let index = Index { array, index: idx };
	if array == node::ERROR {
		return node::push(
			context.nodes, node::NodeKind::Index,
			null, node::NodeData { index }, span,
		);
	}
	let array_data = node::get(context.nodes, array);
	
	let elem_ty: *ty::TypeIdent = null;
	match array_data.ty.kind {
		ty::TypeKind::Array => elem_ty = array_data.ty.data.array.parent,
		ty::TypeKind::Pointer => {
			if array_data.ty.data.pointer == null {
				err::error(
					context.parent,
					err::ErrorKind::IndexAnyPtr,
					array_data.span
				);
			} else {
				elem_ty = array_data.ty.data.pointer;
			}
		}
		_ => {
			err::error(
				context.parent,
				err::ErrorKind::ExprCannotBeIndexed,
				array_data.span
			);
		}
	}
	// TODO: DerefArray
	// if deref_array { array = expr_load(...) }

	if elem_ty == null || idx == node::ERROR {
		return node::push(
			context.nodes, node::NodeKind::Index,
			elem_ty, node::NodeData { index }, span,
		);
	}
	let idx_data = node::get(context.nodes, idx);
	if idx_data.ty != null && !is_index_type(idx_data.ty) {
		err::error(
			context.parent,
			err::ErrorKind::IndexWasNotInteger,
			idx_data.span
		);
	}

	// TODO: Investigate this
	// let expr = match mode.value_kind {
	// 	ValueKind::RValue => load_expr(expr, &elem_ty),
	// 	ValueKind::LValue => expr,
	// };

	return node::push(
		context.nodes, node::NodeKind::Index,
		elem_ty, node::NodeData { index }, span,
	);

}


fn is_index_type(type: *ty::TypeIdent): bool {
	if type == null { return false; }
	if type.kind != ty::TypeKind::Atomic { return false; }
	return cast::is_int(type.data.atomic);
}

