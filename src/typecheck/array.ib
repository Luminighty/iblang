fn find_array_type(
	context: *FunctionContext,
	elems: *int,
	count: int,
	span: int,
): *ty::TypeIdent {
	if context.target_ty != null {
		if context.target_ty.kind != ty::TypeKind::Array {
			err::error(
				context.parent,
				err::ErrorKind::ArrayTargetTypeWasNotArray,
				context.target_ty_span
			);
			return null;
		}
		return context.target_ty;
	}
	if count == 0 {
		err::error(
			context.parent,
			err::ErrorKind::ArrayWasEmptyWithoutTargetType,
			span
		);
		return null;
	}
	let shared: *ty::TypeIdent = null;
	for let i = 0; i < count; i+=1 {
		if elems[i] == node::ERROR { continue; }
		let node_data = node::get(context.nodes, elems[i]);
		let ty = node_data.ty;
		if ty == null { continue; }
		if shared == null {
			shared = ty;
			continue;
		}

		let new_shared = cast::shared_type(shared, ty);
		if new_shared == null {
			// TODO: Figure out what to report
			continue;
		}
		shared = new_shared;
	}
	return shared;
}


// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////


pub fn debug_array(sb: *sb::StringBuilder, nodes: *node::Nodes, array: *Array, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "ARRAY\n");
	for let i = 0; i < array.count; i+=1 {
		let n = array_get(array, i);
		node::debug(sb, nodes, n, depth + 1);
	}
}

fn array_get(array: *Array, index: int): int {
	if index >= array.count { return node::NONE; }
	return array.elems[index];
}

pub fn debug_index(sb: *sb::StringBuilder, nodes: *node::Nodes, index: *Index, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "INDEX\n");
	node::debug(sb, nodes, index.array, depth + 2);
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "  [IDX]\n");
	node::debug(sb, nodes, index.index, depth + 2);
}

