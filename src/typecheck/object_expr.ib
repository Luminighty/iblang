const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"

const symbols = import "../symbol/mod.ib"
const symbol = import "../symbol/symbol.ib"
import "./mod.ib"
import "./function.ib"

const ast_node = import "../ast/node.ib"
const ast_expr = import "../ast/expr.ib"
const statement = import "../ast/statement.ib"

const node = import "./node.ib"
const expr = import "./expr.ib"
const err = import "./error.ib"
const cast = import "./cast.ib"
const ty = import "./typeident.ib"
const obj_def = import "./object_def.ib"
const path = import "./path.ib"


// NOTE: Are we sure we need to use str for type?
pub struct ObjectInit {
	type: *symbol::Symbol, // SymbolUId
	field_count: int,
	fields: *ObjectFieldInit,
}


pub struct ObjectFieldInit {
	field: str,
	field_span: int,
	value: int, // NodeIdx
}

pub struct FieldLookup {
	object: int, // NodeIdx,
	field: str,
	field_span: int,
}



pub fn typecheck_objectinit(
	context: *FunctionContext,
	data: ast_expr::ObjectInit,
	span: int,
): int {
	let object = object_init(context, data, span);
	// TODO: Report UnknownSymbolForObjectInit instead of IdentSymbolNotFound
	if object.type == null {
		return node::ERROR;
	}

	let kind = node::NodeKind::StructInit;
	match object.type.kind {
		symbol::SymbolKind::Struct => {
			kind = node::NodeKind::StructInit;
			typecheck_struct_init(context, &object, span);
		}
		symbol::SymbolKind::Union => {
			kind = node::NodeKind::UnionInit;
			typecheck_union_init(context, &object, span);
		}
		_ => {
			return err::error(
				context.parent,
				err::ErrorKind::SymbolCannotBeConstructed,
				span,
			);
		}
	}

	return node::push(
		context.nodes, kind,
		object.type.type, node::NodeData { object }, span,
	);
}


fn typecheck_struct_init(context: *FunctionContext, init: *ObjectInit, span: int) {
	// NOTE: Zero Init
	if init.field_count == 0 { return; }
	let object_def = init.type.deep.object_def;
	for let i = 0; i < object_def.field_count; i+=1 {
		let found = false;
		let init_index = 0;
		for init_index; init_index < init.field_count && !found; init_index+=1 {
			found = object_def.fields[i].field == init.fields[init_index].field;
		}
		if found { continue; }
		err::object_missing_field(
			context.parent,
			object_def.fields[i].field,
			span
		);
	}

	for let i = 0; i < init.field_count; i+=1 {
		let found = false;
		let obj_def_idx = 0;
		for obj_def_idx = 0; obj_def_idx < object_def.field_count; obj_def_idx+=1 {
			if init.fields[i].field == object_def.fields[obj_def_idx].field {
				found = true;
				break;
			}
		}
		if !found {
			// TODO: Try to find alternatives
			err::error(
				context.parent,
				err::ErrorKind::UndefinedObjectField,
				init.fields[i].field_span
			);
			continue;
		}
		// NOTE: Some weird error that I want to investigate if it shows up
		if init.fields[i].value < 0 {
			err::error(context.parent, err::ErrorKind::UnknownError, init.fields[i].field_span); 
			return;
		}

		let is_ok = true;
		init.fields[i].value = cast::implicit(
			context,
			init.fields[i].value,
			object_def.fields[obj_def_idx].type,
			&is_ok
		);
		if !is_ok {
			err::error(
				context.parent,
				err::ErrorKind::ObjectInitFieldTypeMismatch,
				init.fields[i].field_span,
			);
		}
	}
}


fn typecheck_union_init(context: *FunctionContext, init: *ObjectInit, span: int) {
	// NOTE: Zero Init
	if init.field_count == 0 { return; }
	if init.field_count > 1 {
		err::error(
			context.parent,
			err::ErrorKind::UnionInitOnlyOneFieldAllowed,
			span,
		);
		return;
	}
	let object_def = init.type.deep.object_def;

	let field = init.fields[0];
	let field_def = obj_def::get_field(object_def, field.field);
	if field_def == null {
		// TODO: Try to find alternatives
		err::error(
			context.parent,
			err::ErrorKind::UndefinedObjectField,
			field.field_span,
		);
		return;
	}

	let is_ok = true;
	field.value = cast::implicit(
		context,
		field.value,
		field_def.type,
		&is_ok
	);
	if !is_ok {
		err::error(
			context.parent,
			err::ErrorKind::ObjectInitFieldTypeMismatch,
			field.field_span,
		);
	}
}



fn object_init(context: *FunctionContext, data: ast_expr::ObjectInit, span: int): ObjectInit {
	let type = path::resolve_path_symbol(context, data.type, span);

	let field_count = data.field_count;
	let init = ObjectInit {
		type, field_count,
		fields: node::allocate_extra(
			context.nodes,
			sizeof(ObjectFieldInit) * field_count
		),
	};
	for let i = 0; i < field_count; i+=1 {
		let field = &data.fields[i];
		let value_res = node::typecheck(context, field.value);
		let value = value_res.node;

		init.fields[i] = ObjectFieldInit {
			field: field.field,
			field_span: field.field_span,
			value,
		};

		for let j = 0; j < i; j+=1 {
			if init.fields[i].field == init.fields[j].field {
				err::error(
					context.parent,
					err::ErrorKind::DuplicateObjectField,
					field.field_span,
				);
				// TODO: Maybe mark it as errored so we won't report multiple errors for the same field?
			}
		}
	}
	return init;
}


pub fn typecheck_field_lookup(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	let object_res = node::typecheck(context, data.lhs);
	let object = object_res.node;
	if object == node::ERROR { return node::ERROR; }

	let field = ast_node::get(&context.module.nodes, data.rhs);
	if field.kind != ast_node::NodeKind::Ident {
		return err::error(
			context.parent,
			err::ErrorKind::ObjectFieldWasNotIdentifier,
			field.span,
		);
	}
	let field_span = field.span;
	let field = field.data.ident;

	let kind = node::NodeKind::StructFieldLookup;
	let object_data = node::get(context.nodes, object);
	let object_ty = object_data.ty;
	let def: *obj_def::ObjectDef = null;
	if object_ty == null { return node::ERROR; }

	// NOTE: AutoDeref
	if object_ty.kind == ty::TypeKind::Pointer {
		let inner_ty = object_ty.data.pointer;
		if ty::is_object(inner_ty) {
			object = expr::autoderef(context, object);
			object_data = node::get(context.nodes, object);
			object_ty = object_data.ty;
		}
	}

	match object_ty.kind {
		ty::TypeKind::Compound => {
		let symbol = object_ty.data.compound;
		match symbol.kind {
			symbol::SymbolKind::Struct => {
				kind = node::NodeKind::StructFieldLookup;
				def = symbol.deep.object_def;
			}
			symbol::SymbolKind::Union => {
				kind = node::NodeKind::UnionFieldLookup;
				def = symbol.deep.object_def;
			}
			_ => {}
		}}
		_ => {}
	}

	if def == null {
		return err::error(
			context.parent,
			err::ErrorKind::ObjectExpected,
			object_data.span,
		);
	}
	let obj_idx = obj_def::get_field_idx(def, field);
	if obj_idx == obj_def::FIELD_IDX_NONE {
		err::error(
			context.parent,
			err::ErrorKind::ObjectFieldNotFound,
			field_span,
		);
	}
	let type = def.fields[obj_idx].type;

	let field_lookup = FieldLookup {
		object, // NodeIdx,
		field,
		field_span,
	};
	return node::push(
		context.nodes, kind,
		type, node::NodeData { field_lookup }, span,
	);
}


pub fn debug_struct_init(sb: *sb::StringBuilder, nodes: *node::Nodes, obj_init: *ObjectInit, depth: int) {
	debug_init(sb, nodes, obj_init, depth, "STRUCT_INIT ");
}

pub fn debug_union_init(sb: *sb::StringBuilder, nodes: *node::Nodes, obj_init: *ObjectInit, depth: int) {
	debug_init(sb, nodes, obj_init, depth, "UNION_INIT ");
}

pub fn debug_init(sb: *sb::StringBuilder, nodes: *node::Nodes, obj_init: *ObjectInit, depth: int, key: str) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, key);
	symbol::debug_head(sb, obj_init.type);
	sb::append(sb, "\n");
	if obj_init.field_count == 0 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "[ZERO_INIT]\n");
	}
	for let i = 0; i < obj_init.field_count; i+=1 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, obj_init.fields[i].field);
		sb::append(sb, "\n");
		let value = obj_init.fields[i].value;
		if value != node::NONE {
			node::debug(sb, nodes, value, depth + 2);
		}
	}
}

pub fn debug_struct_lookup(sb: *sb::StringBuilder, nodes: *node::Nodes, lookup: *FieldLookup, depth: int) {
	debug_lookup(sb, nodes, lookup, depth, "STRUCT_FIELD_LOOKUP\n");
}

pub fn debug_union_lookup(sb: *sb::StringBuilder, nodes: *node::Nodes, lookup: *FieldLookup, depth: int) {
	debug_lookup(sb, nodes, lookup, depth, "UNION_FIELD_LOOKUP\n");
}

pub fn debug_lookup(sb: *sb::StringBuilder, nodes: *node::Nodes, lookup: *FieldLookup, depth: int, key: str) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, key);
	node::debug(sb, nodes, lookup.object, depth + 1);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "[FIELD] ");
	sb::append(sb, lookup.field);
	sb::append(sb, "\n");
}
