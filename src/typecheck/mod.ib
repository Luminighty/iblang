const stdlib = import "@stdlib"

const utils = import "../utils/mod.ib"
const vec = import "../utils/vec.ib"
const sb = import "../utils/stringbuilder.ib"
const workstack = import "../utils/workstack.ib"

const ast = import "../ast/declaration.ib"
const ast_mod = import "../ast/mod.ib"

const symbol = import "../symbol/mod.ib"
const errors = import "../storage/error.ib"

pub const module = import "./module.ib"
const ty = import "./typeident.ib"
const function = import "./function.ib"
const obj_def = import "./object_def.ib"
const enums = import "./enums.ib"
const global = import "./global.ib"
const err = import "./error.ib"

pub struct TypecheckContext {
	ast_modules: *vec::Vec, // Vec<ast::Module>
	modules: *vec::Vec, // Vec<Module>
	typeidents: ty::TypeIdents,

	errors: *errors::Errors,
	err_builder: sb::StringBuilder,
	workstack: workstack::WorkStack,

	typecheck_stack: vec::Vec, // Vec<symbol::UID>
}


pub fn context(errors: *errors::Errors, ast_modules: *vec::Vec, modules: *vec::Vec): TypecheckContext {
	return TypecheckContext {
		ast_modules, modules, errors,

		typeidents: ty::new(),
		err_builder: sb::new(),
		workstack: workstack::WorkStack{},
		typecheck_stack: vec::new(sizeof(symbol::UID), 64),
	};
}

pub fn context_free(context: *TypecheckContext) {
	sb::free(&context.err_builder);
	workstack::free(&context.workstack);
	vec::free(&context.typecheck_stack);
	ty::free(&context.typeidents);
}


pub fn run(context: *TypecheckContext) {
	// stdlib::printf("extern_fns\n");
	typecheck_declaration_group(
		context, ast_mod::extern_fns, ast_mod::extfn_decl,
		function::typecheck_extern,
	);
	// stdlib::printf("extern_globals\n");
	typecheck_declaration_group(
		context, ast_mod::extern_globals, ast_mod::extglobal_decl,
		global::typecheck_extern,
	);
	// stdlib::printf("enums\n");
	typecheck_declaration_group(
		context, ast_mod::enums, ast_mod::enumdef_decl,
		enums::typecheck_def,
	);
	// stdlib::printf("structs\n");
	typecheck_declaration_group(
		context, ast_mod::structs, ast_mod::objdef_decl,
		obj_def::typecheck_struct,
	);
	// stdlib::printf("unions\n");
	typecheck_declaration_group(
		context, ast_mod::unions, ast_mod::objdef_decl,
		obj_def::typecheck_union,
	);
	// stdlib::printf("globals\n");
	typecheck_declaration_group(
		context, ast_mod::globals, ast_mod::global_decl,
		global::typecheck
	);
	// stdlib::printf("FUNCTION HEADS\n");
	typecheck_declaration_group(
		context, ast_mod::functions, ast_mod::func_decl,
		function::typecheck_function_head
	);
	// stdlib::printf("FUNCTION BODY\n");
	typecheck_declaration_group(
		context, ast_mod::functions, ast_mod::func_decl,
		function::typecheck_function
	);
	// symbol::debug_all_head();
}

fn typecheck_declaration_group(
	context: *TypecheckContext,
	get_decl_vec: fn(*ast_mod::Module): *vec::Vec,
	decl_fn: fn(*any): *ast::Declaration,
	typecheck_fn: fn(*TypecheckContext, symbol::UID): void,
) {
	for let i = 0; i < context.ast_modules.count; i+=1 {
		let m: *ast_mod::Module = vec::get(context.ast_modules, i);
		let decs = get_decl_vec(m);
		if decs.count == 0 { continue; }
		stdlib::assert(m.uid == i, "ast_mod.uid does not match idx");
		for let j = 0; j < decs.count; j+=1 {
			let declaration = decl_fn(vec::get(decs, j));
			// ast::print_declaration(declaration);
			typecheck_fn(context, declaration.symbol);
			workstack::assert_empty(&context.workstack);
		}
	}
}


pub fn create_modules(ast_modules: *vec::Vec): vec::Vec {
	let modules = vec::new(sizeof(module::Module), ast_modules.count);
	for let i = 0; i < ast_modules.count; i+=1 {
		let ast_mod: *ast_mod::Module = vec::get(ast_modules, i);
		let module: *module::Module = vec::push(&modules);
		stdlib::assert(ast_mod.uid == i, "ast_mod.uid does not match idx");
		*module = module::new(ast_mod);
	}
	return modules;
}


pub fn typecheck_symbol(context: *TypecheckContext, symbol: symbol::UID) {
	symbol::assert_exists(symbol);
	if symbol::stage_eq(symbol, symbol::symbol::SymbolStage::Typechecked) { return; }
	if symbol::stage_eq(symbol, symbol::symbol::SymbolStage::TypecheckInProgress) {
		err::cyclic_dependency(context, symbol);
		return;
	}

	match symbol::kind(symbol) {
		symbol::symbol::SymbolKind::Function => {
			function::typecheck_function_head(context, symbol);
		}
		symbol::symbol::SymbolKind::Struct => {
			obj_def::typecheck_struct(context, symbol);
		}
		symbol::symbol::SymbolKind::Union => {
			obj_def::typecheck_union(context, symbol);
		}
		symbol::symbol::SymbolKind::Enum => {
			enums::typecheck_def(context, symbol);
		}
		symbol::symbol::SymbolKind::Global => {
			global::typecheck(context, symbol);
		}
	}
}


pub fn typecheck_symbol_body(context: *TypecheckContext, symbol: symbol::UID) {
	match symbol::kind(symbol) {
		symbol::symbol::SymbolKind::Function => {
			function::typecheck_function(context, symbol);
		}
		symbol::symbol::SymbolKind::Struct => {}
		symbol::symbol::SymbolKind::Union => {}
		symbol::symbol::SymbolKind::Enum => {}
		symbol::symbol::SymbolKind::Global => {}
	}
}

pub fn start_typechecking(context: *TypecheckContext, symbol: symbol::UID) {
	let elem: *symbol::UID = vec::push(&context.typecheck_stack);
	*elem = symbol;
}

pub fn finish_typechecking(context: *TypecheckContext, symbol: symbol::UID) {
	let elem: *symbol::UID = vec::pop(&context.typecheck_stack);
	stdlib::assert(symbol::eq(*elem, symbol), "Did not finish typechecking the actual symbol");
}

// TODO: Probably I could just lock uid in as an index, and I wouldn't have to worry about this
pub fn find_ast_module(context: *TypecheckContext, uid: int): *ast_mod::Module {
	for let i = 0; i < context.ast_modules.count; i+=1 {
		let module: *ast_mod::Module = vec::get(context.ast_modules, i);
		if module.uid == uid { return module; }
	}
	return null;
}


pub fn find_module(context: *TypecheckContext, uid: int): *module::Module {
	for let i = 0; i < context.modules.count; i+=1 {
		let module: *module::Module = vec::get(context.modules, i);
		if module.uid == uid { return module; }
	}
	return null;
}


fn debug_declarations(
	sb: *sb::StringBuilder, module: *module::Module, decls: *vec::Vec,
	debug_fn: fn(*sb::StringBuilder, *module::Module, *any): void,
) {
	for let i = 0; i < decls.count; i+=1 {
		let d = vec::get(decls, i);
		debug_fn(sb, module, d);
	}
	if decls.count > 0 {
		sb::append(sb, "\n");
	}
}


pub fn debug_module(sb: *sb::StringBuilder, module: *module::Module) {
	sb::append(sb, "# MODULE: ");
	sb::append(sb, module.file);
	sb::append(sb, "\n\n");
	// debug_declarations(sb, module, &module.imports, decl::debug_import);

	debug_declarations(sb, module, &module.extern_fns, function::debug_extern);
	debug_declarations(sb, module, &module.extern_globals, global::debug_extern_global);

	debug_declarations(sb, module, &module.structs, obj_def::debug_struct);
	debug_declarations(sb, module, &module.unions, obj_def::debug_union);
	debug_declarations(sb, module, &module.enums, enums::debug_enum);
	debug_declarations(sb, module, &module.globals, global::debug_global);

	debug_declarations(sb, module, &module.functions, function::debug);
	sb::append(sb, "\n");
}


pub fn free_modules(modules: *vec::Vec, print_usage: bool) {
	for let i = 0; i < modules.count; i+=1 {
		let m: *module::Module = vec::get(modules, i);
		module::free(m, print_usage);
	}
	vec::free(modules);
}
