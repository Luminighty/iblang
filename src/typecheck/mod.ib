const stdlib = import "@stdlib"

const utils = import "../utils/mod.ib"
const vec = import "../utils/vec.ib"
const sb = import "../utils/stringbuilder.ib"
const workstack = import "../utils/workstack.ib"

const ast = import "../ast/declaration.ib"
const ast_mod = import "../ast/mod.ib"

const symbol = import "../symbol/symbol.ib"
const errors = import "../storage/error.ib"

pub const module = import "./module.ib"
const ty = import "./typeident.ib"
const function = import "./function.ib"
const obj_def = import "./obj_def.ib"

pub struct TypecheckContext {
	ast_modules: *vec::Vec, // Vec<ast::Module>
	modules: *vec::Vec, // Vec<Module>
	typeidents: ty::TypeIdents,

	errors: *errors::Errors,
	err_builder: sb::StringBuilder,
	workstack: workstack::WorkStack,

	typecheck_stack: vec::Vec, // Vec<*symbol::Symbol>
}


pub fn context(errors: *errors::Errors, ast_modules: *vec::Vec, modules: *vec::Vec): TypecheckContext {
	return TypecheckContext {
		ast_modules, modules, errors,

		typeidents: ty::new(),
		err_builder: sb::new(),
		workstack: workstack::WorkStack{},
		typecheck_stack: vec::new(sizeof(*symbol::Symbol), 64),
	};
}


pub fn run(context: *TypecheckContext) {
	for let i = 0; i < context.ast_modules.count; i+=1 {
		let m: *ast_mod::Module = vec::get(context.ast_modules, i);
		for let j = 0; j < m.structs.count; j+=1 {
			let o: *ast::ObjectDef = vec::get(&m.structs, j);
			obj_def::typecheck_struct(context, o.declaration.symbol);
		}
	}

	for let i = 0; i < context.ast_modules.count; i+=1 {
		let m: *ast_mod::Module = vec::get(context.ast_modules, i);
		for let j = 0; j < m.functions.count; j+=1 {
			let f: *ast::Function = vec::get(&m.functions, j);
			function::typecheck_function_head(context, f.declaration.symbol);
		}
	}

	for let i = 0; i < context.ast_modules.count; i+=1 {
		let m: *ast_mod::Module = vec::get(context.ast_modules, i);
		for let j = 0; j < m.functions.count; j+=1 {
			let f: *ast::Function = vec::get(&m.functions, j);
			function::typecheck_function(context, f.declaration.symbol);
		}
	}
}


pub fn create_modules(ast_modules: *vec::Vec): vec::Vec {
	let modules = vec::new(sizeof(module::Module), ast_modules.count);
	for let i = 0; i < ast_modules.count; i+=1 {
		let module: *module::Module = vec::push(&modules);
		let ast_mod: *ast_mod::Module = vec::get(ast_modules, i);
		*module = module::new(ast_mod);
	}
	return modules;
}


pub fn typecheck_symbol(context: *TypecheckContext, symbol: *symbol::Symbol) {
	stdlib::assert(symbol != null, "typecheck::run symbol was null!");

	if symbol.stage >= symbol::SymbolStage::Typechecked { return; }
	match symbol.kind {
		symbol::SymbolKind::Function => {
			function::typecheck_function_head(context, symbol);
		}
		symbol::SymbolKind::Struct => {
			obj_def::typecheck_struct(context, symbol);
		}
		symbol::SymbolKind::Union => {
			utils::todo("typecheck::Union");
		}
		symbol::SymbolKind::Enum => {
			utils::todo("typecheck::Enum");
		}
		symbol::SymbolKind::Global => {
			utils::todo("typecheck::Global");
		}
	}
}


pub fn typecheck_symbol_body(context: *TypecheckContext, symbol: *symbol::Symbol) {
	match symbol.kind {
		symbol::SymbolKind::Function => {
			function::typecheck_function(context, symbol);
		}
		symbol::SymbolKind::Struct => {}
		symbol::SymbolKind::Union => {}
		symbol::SymbolKind::Enum => {}
		symbol::SymbolKind::Global => {}
	}
}

pub fn start_typechecking(context: *TypecheckContext, symbol: *symbol::Symbol) {
	let elem: **symbol::Symbol = vec::push(&context.typecheck_stack);
	*elem = symbol;
}

pub fn finish_typechecking(context: *TypecheckContext, symbol: *symbol::Symbol) {
	let elem: **symbol::Symbol = vec::pop(&context.typecheck_stack);
	stdlib::assert(*elem == symbol, "Did not finish typechecking the actual symbol");
}

// TODO: Probably I could just lock uid in as an index, and I wouldn't have to worry about this
pub fn find_ast_module(context: *TypecheckContext, uid: int): *ast_mod::Module {
	for let i = 0; i < context.ast_modules.count; i+=1 {
		let module: *ast_mod::Module = vec::get(context.ast_modules, i);
		if module.uid == uid { return module; }
	}
	return null;
}


pub fn find_module(context: *TypecheckContext, uid: int): *module::Module {
	for let i = 0; i < context.modules.count; i+=1 {
		let module: *module::Module = vec::get(context.modules, i);
		if module.uid == uid { return module; }
	}
	return null;
}


fn debug_declarations(
	sb: *sb::StringBuilder, module: *module::Module, decls: *vec::Vec,
	debug_fn: fn(*sb::StringBuilder, *module::Module, *any): void,
) {
	for let i = 0; i < decls.count; i+=1 {
		let d = vec::get(decls, i);
		debug_fn(sb, module, d);
	}
}


pub fn debug_module(sb: *sb::StringBuilder, module: *module::Module) {
	sb::append(sb, "# MODULE: ");
	sb::append(sb, module.file);
	sb::append(sb, "\n\n");
	// debug_declarations(sb, module, &module.imports, decl::debug_import);
	// debug_declarations(sb, module, &module.extern_fns, decl::debug_extern_fn);
	// debug_declarations(sb, module, &module.extern_globals, decl::debug_extern_global);
	debug_declarations(sb, module, &module.structs, obj_def::debug_struct);
	// debug_declarations(sb, module, &module.unions, decl::debug_union);
	// debug_declarations(sb, module, &module.enums, decl::debug_enum);
	// debug_declarations(sb, module, &module.globals, decl::debug_global);
	debug_declarations(sb, module, &module.functions, function::debug);
	sb::append(sb, "\n");
}

