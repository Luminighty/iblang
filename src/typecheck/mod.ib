const stdlib = import "@stdlib"

const utils = import "../utils/mod.ib"
const vec = import "../utils/vec.ib"
const sb = import "../utils/stringbuilder.ib"
const workstack = import "../utils/workstack.ib"

const ast = import "../ast/declaration.ib"
const ast_mod = import "../ast/mod.ib"

const symbol = import "../symbol/symbol.ib"
const errors = import "../storage/error.ib"

const module = import "./module.ib"
const ty = import "./typeident.ib"
const function = import "./function.ib"

pub struct TypecheckContext {
	ast_modules: *vec::Vec, // Vec<ast::Module>
	modules: vec::Vec, // Vec<Module>
	typeidents: ty::TypeIdents,

	errors: *errors::Errors,
	err_builder: sb::StringBuilder,
	workstack: workstack::WorkStack,

	typecheck_queue: vec::Vec, // Vec<*symbol::Symbol>
}


pub fn context(errors: *errors::Errors, ast_modules: *vec::Vec): TypecheckContext {
	let context = TypecheckContext {
		ast_modules,
		modules: vec::new(sizeof(module::Module), ast_modules.count),
		typeidents: ty::new(),

		errors,
		err_builder: sb::new(),
		workstack: workstack::WorkStack{},

		typecheck_queue: vec::new(sizeof(*symbol::Symbol), 32),
	};
	for let i = 0; i < ast_modules.count; i+=1 {
		let module: *module::Module = vec::push(&context.modules);
		let ast_mod: *ast_mod::Module = vec::get(context.ast_modules, i);
		*module = module::new(ast_mod);
	}
	return context;
}


pub fn run(context: *TypecheckContext, entry: *symbol::Symbol) {
	typecheck_symbol(context, entry);
	while context.typecheck_queue.count > 0 {
		let symbol: **symbol::Symbol = vec::pop(&context.typecheck_queue);
		(*symbol).name;
		typecheck_symbol_body(context, *symbol);
	}
}


pub fn queue_typecheck_symbol(context: *TypecheckContext, symbol: *symbol::Symbol) {
	let queue: **symbol::Symbol = vec::push(&context.typecheck_queue);
	*queue = symbol;
}


pub fn typecheck_symbol(context: *TypecheckContext, symbol: *symbol::Symbol) {
	stdlib::assert(symbol != null, "typecheck::run symbol was null!");

	if symbol.stage >= symbol::SymbolStage::Typechecked { return; }
	match symbol.kind {
		symbol::SymbolKind::Function => {
			function::typecheck_function_head(context, symbol);
		}
		symbol::SymbolKind::Struct => {
			utils::todo("typecheck::Struct");
		}
		symbol::SymbolKind::Union => {
			utils::todo("typecheck::Union");
		}
		symbol::SymbolKind::Enum => {
			utils::todo("typecheck::Enum");
		}
		symbol::SymbolKind::Global => {
			utils::todo("typecheck::Global");
		}
	}
}


pub fn typecheck_symbol_body(context: *TypecheckContext, symbol: *symbol::Symbol) {
	match symbol.kind {
		symbol::SymbolKind::Function => {
			function::typecheck_function(context, symbol);
		}
		symbol::SymbolKind::Struct => {}
		symbol::SymbolKind::Union => {}
		symbol::SymbolKind::Enum => {}
		symbol::SymbolKind::Global => {}
	}
}

// TODO: Probably I could just lock uid in as an index, and I wouldn't have to worry about this
pub fn find_ast_module(context: *TypecheckContext, uid: int): *ast_mod::Module {
	for let i = 0; i < context.ast_modules.count; i+=1 {
		let module: *ast_mod::Module = vec::get(context.ast_modules, i);
		if module.uid == uid { return module; }
	}
	return null;
}

pub fn find_module(context: *TypecheckContext, uid: int): *module::Module {
	for let i = 0; i < context.modules.count; i+=1 {
		let module: *module::Module = vec::get(&context.modules, i);
		if module.uid == uid { return module; }
	}
	return null;
}

