const stdlib = import "@stdlib"

const vec = import "../utils/vec.ib"
const ty = import "./typeident.ib"


struct Variable {
	key: str,
	is_error: bool,
	ty: *ty::TypeIdent,
	mutable: bool,
	id: int,
}
pub struct VarBindings {
	variables: vec::Vec, // vec::Vec<Variable>
	blocks: vec::Vec, // vec::Vec<int>
	last_id: int,
}

pub fn new(): VarBindings {
	return VarBindings {
		variables: vec::new(sizeof(Variable), 64),
		blocks: vec::new(sizeof(int), 64),
		last_id: 0,
	};
}

pub fn free(binds: *VarBindings) {
	vec::free(&binds.variables);
	vec::free(&binds.blocks);
}


pub fn start(binds: *VarBindings) {
	let value: *int = vec::push(&binds.blocks);
	*value = binds.variables.count;
}


pub fn end(binds: *VarBindings) {
	stdlib::assert(binds.blocks.count > 0, "var_bindings::end without blocks!");
	let block_start = *(vec::pop(&binds.blocks) as *int);
	binds.variables.count = block_start;
}


pub fn insert(binds: *VarBindings, key: str, ty: *ty::TypeIdent, mutable: bool): int {
	let var: *Variable = vec::push(&binds.variables);
	binds.last_id += 1;
	*var = Variable {
		key, ty, mutable,
		id: binds.last_id,
		is_error: false,
	};
	return var.id;
}


pub fn insert_error(binds: *VarBindings, key: str, ty: *ty::TypeIdent, mutable: bool): int {
	let var: *Variable = vec::push(&binds.variables);
	binds.last_id += 1;
	*var = Variable {
		key, ty, mutable,
		id: binds.last_id,
		is_error: true,
	};
	return var.id;
}


pub struct VarResult {
    found: bool,
    id: int, key: str,
    ty: *ty::TypeIdent,
    mutable: bool, is_error: bool,
}
pub fn get(binds: *VarBindings, key: str): VarResult {
	let res = VarResult {};
	for let i = binds.variables.count - 1; i >= 0; i-=1 {
		let var: *Variable = vec::get(&binds.variables, i);
		if var.key == key {
			res.found = true;
			res.ty = var.ty;
			res.mutable = var.mutable;
			res.id = var.id;
			res.key = var.key;
			res.is_error = var.is_error;
			break;
		}
	}
	return res;
}


pub fn print(binds: *VarBindings) {
	stdlib::printf("VarBindings: ");
	let next_block = 0;
	let block_idx = 0;
	for let i = 0; i < binds.variables.count; i+=1 {
		if next_block == i {
			stdlib::printf("[BLOCK] ");
		}
		let var: *Variable = vec::get(&binds.variables, i);
		stdlib::printf("[%s@%d] ", var.key, var.id);
		
		if block_idx < binds.blocks.count {
			next_block = *(vec::get(&binds.blocks, block_idx) as *int);
			block_idx += 1;
		}
	}
	stdlib::printf("\n");
}

