pub enum NodeKind {
	None,

	// Expr
	Literal, Ident,
	Binary, Unary, Cast,
	Array, ObjectInit,
	Call,
	SizeOf,

	// Statements
	Block,
	ConstDecl, VarDecl,
	Break, Continue, Return,
	If, Match,
	Loop, For,
}

union NodeData {
	// ExprData
	ident: str,
	literal: literal::Literal,
	// unary: expr::Unary,
	// binary: expr::Binary,
	// call: expr::Call,
	// array: expr::Array,
	// object: expr::ObjectInit,
	// cast: expr::Cast,
	// size_of: TypeData,

	// StatementData

	expr: int,
	// var_declaration: statement::VarDeclaration,
	block: statement::BlockData,
	// retrn: statement::ReturnData,
	// if_data: statement::IfData,
	// for_data: *statement::ForData,
	// match_data: statement::MatchData,
	// loop_data: statement::LoopData,
}



pub struct Node {
	kind: NodeKind,
	span: int,
	data: NodeData,
	ty: *ty::TypeIdent,
}


pub fn typecheck(context: *FunctionContext, node: int): int {
	let node = ast_node::get(&context.module.nodes, node);

	match node.kind {
	ast_node::NodeKind::None => utils::todo("nodes::NodeKind::None"),

	ast_node::NodeKind::Literal    => return literal::typecheck(context, node.data.literal, node.span);
	ast_node::NodeKind::Ident      => return typecheck_ident(context, node.data.ident, node.span);
	ast_node::NodeKind::Binary     => return binary::typecheck(context, node.data.binary, node.span);
	ast_node::NodeKind::Unary      => return typecheck_unary(context, node.data.unary, node.span);
	ast_node::NodeKind::Cast       => return typecheck_cast(context, node.data.cast, node.span);
	ast_node::NodeKind::Array      => return typecheck_array(context, node.data.array, node.span);
	ast_node::NodeKind::Call       => return typecheck_call(context, node.data.call, node.span);
	ast_node::NodeKind::SizeOf     => return typecheck_sizeof(context, node.data.size_of, node.span);
	ast_node::NodeKind::ObjectInit => return typecheck_objectinit(context, node.data.object, node.span);

	ast_node::NodeKind::Block     => return typecheck_block(context, node.data.block, node.span);
	ast_node::NodeKind::ConstDecl => return typecheck_vardecl(context, node.data.var_declaration, true, node.span);
	ast_node::NodeKind::VarDecl   => return typecheck_vardecl(context, node.data.var_declaration, false, node.span);
	ast_node::NodeKind::Break     => return typecheck_break(context, node.span);
	ast_node::NodeKind::Continue  => return typecheck_continue(context, node.span);
	ast_node::NodeKind::Return    => return typecheck_return(context, node.data.retrn, node.span);
	ast_node::NodeKind::If        => return typecheck_if(context, node.data.if_data, node.span);
	ast_node::NodeKind::Match     => return typecheck_match(context, node.data.match_data, node.span);
	ast_node::NodeKind::Loop      => return typecheck_loop(context, node.data.loop_data, node.span);
	ast_node::NodeKind::For       => return typecheck_for(context, node.data.for_data, node.span);
	}
}


// //////////////////////////////////////////
// //////////      STATEMENTS      //////////
// //////////////////////////////////////////

fn typecheck_block(
	context: *FunctionContext,
	data: ast_statement::BlockData,
	span: int,
): int {
	let node = nodes::push(&context.nodes, NodeKind::Block, null, span);
	let node_data = nodes::get(&context.nodes, node);

	let nodes: *int = nodes::allocate_extra(&context.nodes, sizeof(int) * data.count);
	let has_errors = false;
	for let i = 0; i < data.count; i+=1 {
		let res = typecheck(context, data.nodes[i]);
		nodes[i] = res;
		if res == ERROR { has_errors = true; continue; }
	}
	if has_errors { return ERROR; }
	node_data.data.block.count = data.count;
	node_data.data.block.nodes = nodes;
	return node;
}


