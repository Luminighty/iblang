const sb = import "../utils/stringbuilder.ib"
const vec = import "../utils/vec.ib"
const arena = import "../utils/arena.ib"

const symbol = import "../symbol/mod.ib"

import "./mod.ib"
import "./function.ib"
import "./misc.ib"

const ast_node = import "../ast/node.ib"
const ast_statement = import "../ast/statement.ib"
const ast_expr = import "../ast/expr.ib"

const ty = import "./typeident.ib"
const binary = import "./binary.ib"
const unary = import "./unary.ib"
const literal = import "./literal.ib"
const expr = import "./expr.ib"
const statement = import "./statement.ib"
const array = import "./array.ib"
const object = import "./object.ib"
const cast = import "./cast.ib"


pub const NONE = 0;
pub const ERROR = -1;
// TODO: Probably should remove this
pub const SUCCESS = 1;


pub enum NodeKind {
	None,

	// Expr
	Literal, Variable,
	Binary, Unary, Cast,
	Assign,
	Array, ObjectInit,
	Call,
	SizeOf,

	// Statements
	Block,
	ConstDecl, VarDecl, Symbol,
	Break, Continue, Return,
	If, Match,
	Loop, For,
}

pub union NodeData {
	// ExprData
	variable: expr::Variable,
	literal: literal::Literal,
	unary: unary::Unary,
	binary: binary::Binary,
	call: expr::Call,
	assign: binary::Assign,
	// array: expr::Array,
	// object: expr::ObjectInit,
	cast: cast::Cast,
	// size_of: TypeData,
	symbol: *symbol::symbol::Symbol,

	// StatementData

	expr: int,
	var_declaration: statement::VarDeclaration,
	block: statement::BlockData,
	retrn: statement::ReturnData,
	if_data: statement::IfData,
	for_data: *statement::ForData,
	// match_data: statement::MatchData,
	loop_data: statement::LoopData,
}



pub struct Node {
	kind: NodeKind,
	data: NodeData,
	ty: *ty::TypeIdent,
	span: int,
}

// WARN: flow_all and flow_any relies on this sorting
pub enum NodeFlow { Some, Continue, Break, Return, Never,  }
pub struct NodeResult {
	flow: NodeFlow,
	node: int,
}
pub fn typecheck(context: *FunctionContext, node: int): NodeResult {
	let node = ast_node::get(&context.module.nodes, node);

	match node.kind {
	ast_node::NodeKind::None => {
		stdlib::assert(0, "typecheck::node::NodeKind::None");
		return NodeResult{}; // TODO: Fix this
	}

	ast_node::NodeKind::Literal    => return some(literal::typecheck(context, node.data.literal, node.span));
	ast_node::NodeKind::Binary     => return some(binary::typecheck(context, node.data.binary, node.span));
	ast_node::NodeKind::Unary      => return unary::typecheck(context, node.data.unary, node.span);

	ast_node::NodeKind::Ident      => return some(expr::typecheck_ident(context, node.data.ident, node.span));
	ast_node::NodeKind::Cast       => return some(cast::typecheck(context, node.data.cast, node.span));
	ast_node::NodeKind::Call       => return expr::typecheck_call(context, node.data.call, node.span);
	ast_node::NodeKind::SizeOf     => return some(expr::typecheck_sizeof(context, node.data.size_of, node.span));

	ast_node::NodeKind::ObjectInit => return some(object::typecheck_objectinit(context, node.data.object, node.span));
	ast_node::NodeKind::Array      => return some(array::typecheck(context, node.data.array, node.span));

	ast_node::NodeKind::Block      => return statement::typecheck_block(context, node.data.block, node.span);
	ast_node::NodeKind::ConstDecl  => return statement::typecheck_vardecl(context, node.data.var_declaration, false, node.span);
	ast_node::NodeKind::VarDecl    => return statement::typecheck_vardecl(context, node.data.var_declaration, true, node.span);
	ast_node::NodeKind::Break      => return statement::typecheck_break(context, node.span);
	ast_node::NodeKind::Continue   => return statement::typecheck_continue(context, node.span);
	ast_node::NodeKind::Return     => return statement::typecheck_return(context, node.data.retrn, node.span);
	ast_node::NodeKind::If         => return statement::typecheck_if(context, node.data.if_data, node.span);
	ast_node::NodeKind::Match      => return statement::typecheck_match(context, node.data.match_data, node.span);
	ast_node::NodeKind::Loop       => return statement::typecheck_loop(context, node.data.loop_data, node.span);
	ast_node::NodeKind::For        => return statement::typecheck_for(context, node.data.for_data, node.span);
	}
}


pub fn some(node: int):   NodeResult { return result(node, NodeFlow::Some); }
pub fn result(node: int, flow: NodeFlow): NodeResult { return NodeResult{ node, flow }; }


fn assert_nodeflow_sort() {
	stdlib::assert(NodeFlow::Some < NodeFlow::Never, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Some < NodeFlow::Return, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Some < NodeFlow::Break, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Some < NodeFlow::Continue, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Continue < NodeFlow::Never, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Continue < NodeFlow::Return, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Continue < NodeFlow::Break, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Break < NodeFlow::Never, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Break < NodeFlow::Return, "NodeFlow invalid sorting");
	stdlib::assert(NodeFlow::Return < NodeFlow::Never, "NodeFlow invalid sorting");
}

pub fn flow_from_typeident(type: ty::FlowType): NodeFlow {
	match type.kind {
		ty::FlowTypeKind::Never => return NodeFlow::Never;
		ty::FlowTypeKind::Void => return NodeFlow::Some;
		ty::FlowTypeKind::Some => return NodeFlow::Some;
	}
}
// The resulting flow if any of the branches may be taken
pub fn flow_any(lhs: NodeFlow, rhs: NodeFlow): NodeFlow {
	assert_nodeflow_sort();
	if lhs < rhs { return lhs; }
	return rhs;
}
// The resulting flow when all of the "branches" are taken (think sequential like a block)
pub fn flow_all(lhs: NodeFlow, rhs: NodeFlow): NodeFlow {
	assert_nodeflow_sort();
	if lhs > rhs { return lhs; }
	return rhs;
}

// ///////////////////////////
// ////////// Nodes //////////
// ///////////////////////////

pub struct Nodes {
	nodes: vec::Vec, // Vec<Node>,
	extras: arena::Arena, // Arena<>,
}

pub fn new(): Nodes {
	let nodes = vec::new(sizeof(Node), 256);
	let extras = arena::new(256);
	vec::push(&nodes); // NONE
	return Nodes { nodes, extras };
}

pub fn get(nodes: *Nodes, index: int): *Node { return vec::get(&nodes.nodes, index); }
pub fn try_get(nodes: *Nodes, index: int): *Node { 
	if index == ERROR || index == NONE { return null; }
	return vec::get(&nodes.nodes, index);
}

pub fn push_simple(
	nodes: *Nodes,
	kind: NodeKind,
	span: int,
): int {
	return push(nodes, kind, null, NodeData { expr: NONE }, span);
}
pub fn push(
	nodes: *Nodes,
	kind: NodeKind,
	ty: *ty::TypeIdent,
	data: NodeData,
	span: int,
): int {
	let index = nodes.nodes.count;
	let node: *Node = vec::push(&nodes.nodes);
	node.kind = kind;
	node.ty = ty;
	node.data = data;
	node.span = span;
	return index;
}

pub fn allocate_extra(nodes: *Nodes, size: int): *any {
	return arena::allocate(&nodes.extras, size);
}


// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////

pub fn debug(sb: *sb::StringBuilder, nodes: *Nodes, node: int, depth: int) {
	stdlib::assert(node != NONE, "node::debug got NONE");

	let n = get(nodes, node);
	let data: *any = &n.data;
	match n.kind {
		NodeKind::None => {}
		// Expr
		NodeKind::Literal => literal::debug(sb, data, depth),
		_ => {
			utils::todo("node::debug");
		}
		NodeKind::Variable => expr::debug_variable(sb, nodes, data, depth),
		NodeKind::Symbol => expr::debug_symbol(sb, nodes, data, depth),
		NodeKind::Binary => binary::debug(sb, nodes, data, depth),
		NodeKind::Unary => unary::debug_unary(sb, nodes, data, depth),
		NodeKind::Assign => binary::debug_assign(sb, nodes, data, depth),
		NodeKind::Cast => cast::debug(sb, nodes, data, depth),
		// NodeKind::Array => expr::debug_array(sb, nodes, data, depth),
		// NodeKind::ObjectInit => expr::debug_object_init(sb, nodes, data, depth),
		NodeKind::Call => expr::debug_call(sb, nodes, data, depth),
		// NodeKind::SizeOf => expr::debug_sizeof(sb, nodes, data),

		// Statements
		NodeKind::Block => statement::debug_block(sb, nodes, data, depth),
		NodeKind::ConstDecl => statement::debug_var_decl(sb, nodes, false, data, depth),
		NodeKind::VarDecl => statement::debug_var_decl(sb, nodes, true, data, depth),
		NodeKind::Break => debug_simple(sb, "BREAK", depth),
		NodeKind::Continue => debug_simple(sb, "CONTINUE", depth),
		NodeKind::Return => statement::debug_return(sb, nodes, data, depth),
		NodeKind::If => statement::debug_if(sb, nodes, data, depth),
		// NodeKind::Match => statement::debug_match(sb, nodes, data, depth),
		NodeKind::Loop => statement::debug_loop(sb, nodes, data, depth),
		NodeKind::For => statement::debug_for(sb, nodes, data, depth),
	}
}

pub fn debug_simple(sb: *sb::StringBuilder, label: str, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, label);
	sb::append(sb, "\n");
}
