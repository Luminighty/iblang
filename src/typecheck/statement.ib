pub fn typecheck_block(
	context: *FunctionContext,
	data: ast_statement::BlockData,
	span: int,
): int {
	let block = BlockData {
		count: data.count,
		nodes: node::allocate_extra(&context.nodes, sizeof(int) * data.count),
	};

	let has_errors = false;
	for let i = 0; i < data.count; i+=1 {
		let res = node::typecheck(context, data.nodes[i]);
		block.nodes[i] = res;
		if res == node::ERROR { has_errors = true; continue; }
	}
	if has_errors { return node::ERROR; }

	return node::push(
		&context.nodes,
		node::NodeKind::Block,
		null, node::NodeData { block }, span
	);
}


pub fn typecheck_vardecl(
	context: *FunctionContext,
	data: ast_statement::VarDeclaration,
	mutable: bool,
	span: int,
): int {
	let ident = ast_node::get(&context.module.nodes, data.ident);
	stdlib::assert(ident.kind == ast_node::NodeKind::Ident, "VarDecl expected identifier.");
	let ident_span = ident.span;
	let ident: str = ident.data.ident;

	let value = node::typecheck(context, data.value);

	let expected_ty: *ty::TypeIdent = null;
	let had_typehint = false;
	if data.type != null {
		had_typehint = true;
		expected_ty = ty::typecheck(
			context.parent,
			data.type.type,
			data.type.span
		);
	}

	let typehint_errored = had_typehint && expected_ty == null;
	if value == node::ERROR || typehint_errored {
		bind::insert_error(&context.bindings, ident, null, mutable);
		return node::ERROR;
	}
	
	let value_data = node::get(&context.nodes, value);
	let value_ty = value_data.ty;

	if had_typehint && expected_ty != value_ty {
		bind::insert_error(&context.bindings, ident, expected_ty, mutable);
		return err::error(
			context.parent, 
			err::ErrorKind::VarDeclTypeMismatch, 
			data.type.span
		);
	}

	// let ty = data.type;
	let type = value_ty;
	// TODO: Validate ty == value.ty

	let var_id = bind::insert(&context.bindings, ident, type, mutable);

	let kind = node::NodeKind::VarDecl;
	if !mutable { kind = node::NodeKind::ConstDecl; }

	let var_declaration = VarDeclaration { ident, value, type, var_id };

	return node::push(
		&context.nodes, kind,
		type, node::NodeData { var_declaration }, span,
	);
}


