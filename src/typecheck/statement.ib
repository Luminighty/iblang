// 	arm: int,
// }


fn block_get(block: *BlockData, index: int): int {
	if index >= block.count { return nodes::NONE; }
	return block.nodes[index];
}


pub fn print_block(sb: *sb::StringBuilder, nodes: *nodes::Nodes, block: *BlockData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "BLOCK\n");
	for let i = 0; i < block.count; i+=1 {
		let n = block_get(block, i);
		stdlib::assert(n != nodes::NONE, "statement::print_block");
		node::print(sb, nodes, n, depth + 1);
	}
}
