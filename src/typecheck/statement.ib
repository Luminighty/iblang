const stdlib = import "@stdlib"

const sb = import "../utils/stringbuilder.ib"
const node = import "./node.ib"
const nodes = import "./nodes.ib"


pub struct ForData {
	init: int,
	cond: int,
	acc: int,
	body: int,
}


pub struct LoopData {
	has_cond: bool,
	cond: int,
	body: int,
}


pub struct IfData {
	cond: int,
	then: int,
	otherwise: int,
}


pub struct BlockData {
	count: int,
	nodes: *int,
}


pub struct VarDeclaration {
	ident: int,
	value: int,
	// type: *node::TypeData,
}


pub struct ReturnData {
	has_value: bool,
	value: int,
}

