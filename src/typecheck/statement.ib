pub fn typecheck_block(
	context: *FunctionContext,
	data: ast_statement::BlockData,
	span: int,
): int {
	let node = node::push(&context.nodes, node::NodeKind::Block, null, span);
	let node_data = node::get(&context.nodes, node);

	let nodes: *int = node::allocate_extra(&context.nodes, sizeof(int) * data.count);
	let has_errors = false;
	for let i = 0; i < data.count; i+=1 {
		let res = node::typecheck(context, data.nodes[i]);
		nodes[i] = res;
		if res == node::ERROR { has_errors = true; continue; }
	}
	if has_errors { return node::ERROR; }
	node_data.data.block.count = data.count;
	node_data.data.block.nodes = nodes;
	return node;
}


pub fn typecheck_vardecl(
	context: *FunctionContext,
	data: ast_statement::VarDeclaration,
	mutable: bool,
	span: int,
): int {
	let ident = ast_node::get(&context.module.nodes, data.ident);
	stdlib::assert(ident.kind == ast_node::NodeKind::Ident, "VarDecl expected identifier.");
	let ident: str = ident.data.ident;

	// TODO: Add commented sections once I have actual typeident checking
	let value = node::typecheck(context, data.value);
	// let ty = typeident::typecheck(context, data.type);

	if value == node::ERROR {
		// bind::insert_error(&context.bindings, ident, ty, mutable);
		bind::insert_error(&context.bindings, ident, null, mutable);
		return node::ERROR;
	}
	
	let value_data = node::get(&context.nodes, value);
	let value_ty = value_data.ty;

	// let ty = data.type;
	let ty = value_ty;
	// TODO: Validate ty == value.ty

	bind::insert(&context.bindings, ident, ty, mutable);

	let kind = node::NodeKind::VarDecl;
	if !mutable { kind = node::NodeKind::ConstDecl; }

	let node = node::push(&context.nodes, kind, ty, span);
	let node_data = node::get(&context.nodes, node);
	node_data.data.var_declaration.ident = ident;
	node_data.data.var_declaration.value = value;
	node_data.data.var_declaration.type = ty;
	return node;
}


