const ast_node = import "../ast/node.ib"
const ast_statement = import "../ast/statement.ib"

const node = import "./node.ib"
const err = import "./error.ib"
const bind = import "./var_bindings.ib"
const ty = import "./typeident.ib"


pub struct ForData {
	init: int,
	cond: int,
	acc: int,
	body: int,
}


pub struct LoopData {
	has_cond: bool,
	cond: int,
	body: int,
}


pub struct IfData {
	cond: int,
	then: int,
	otherwise: int,
}


pub struct BlockData {
	count: int,
	nodes: *int,
}


// NOTE: Might need to add a unique id so that codegen doesn't have to match varbindings
pub struct VarDeclaration {
	ident: str,
	var_id: int,
	value: int,
	type: *ty::TypeIdent,
}


pub struct ReturnData {
	has_value: bool,
	value: int,
}

