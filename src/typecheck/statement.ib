// MISC

fn block_get(block: *BlockData, index: int): int {
	if index >= block.count { return node::NONE; }
	return block.nodes[index];
}


pub fn print_block(sb: *sb::StringBuilder, nodes: *node::Nodes, block: *BlockData, depth: int) {
	for let i = 0; i < block.count; i+=1 {
		let n = block_get(block, i);
		stdlib::assert(n != node::NONE, "statement::print_block");
		node::print(sb, nodes, n, depth + 1);
		sb::append(sb, "\n");
	}
}



pub fn print_var_decl(sb: *sb::StringBuilder, nodes: *node::Nodes, mutable: bool, data: *VarDeclaration, depth: int) {
	if mutable {
		sb::append(sb, "let ");
	} else {
		sb::append(sb, "const ");
	}
	sb::append(sb, data.ident);
	// TODO: print type
	sb::append(sb, ": todo");
	sb::append(sb, " = ");
	node::print(sb, nodes, data.value, depth + 1);
	sb::append(sb, ";");
}

