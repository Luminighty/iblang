pub fn typecheck_block(
	context: *FunctionContext,
	data: ast_statement::BlockData,
	span: int,
): node::NodeResult {
	let block = BlockData {
		count: data.count,
		nodes: node::allocate_extra(context.nodes, sizeof(int) * data.count),
	};
	let flow = node::NodeFlow::Some;

	bind::start(&context.bindings);
	// let has_errors = false;
	for let i = 0; i < data.count; i+=1 {
		let res = node::typecheck(context, data.nodes[i]);
		block.nodes[i] = res.node;
		flow = node::flow_all(flow, res.flow);
		// has_errors = has_errors || res.node == node::ERROR;
	}
	// bind::print(&context.bindings);
	bind::end(&context.bindings);

	// if has_errors { return node::some(node::ERROR); }
	return node::result(
		node::push(
			context.nodes,
			node::NodeKind::Block,
			null, node::NodeData { block }, span
		),
		flow
	);
}


pub fn typecheck_vardecl(
	context: *FunctionContext,
	data: ast_statement::VarDeclaration,
	mutable: bool,
	span: int,
): node::NodeResult {
	let ident = ast_node::get(&context.module.nodes, data.ident);
	stdlib::assert(ident.kind == ast_node::NodeKind::Ident, "VarDecl expected identifier.");
	let ident_span = ident.span;
	let ident: str = ident.data.ident;

	let value_res = node::typecheck(context, data.value);
	let value = value_res.node;

	let expected_ty: *ty::TypeIdent = null;
	let had_typehint = false;
	if data.type != null {
		had_typehint = true;
		expected_ty = ty::typecheck(
			context.parent,
			data.type.type,
			data.type.span
		);
	}

	let typehint_errored = had_typehint && expected_ty == null;
	if value == node::ERROR || typehint_errored {
		bind::insert_error(&context.bindings, ident, null, mutable);
		return node::some(node::ERROR);
	}
	
	let value_data = node::get(context.nodes, value);
	let value_ty = value_data.ty;

	if had_typehint && expected_ty != value_ty {
		// TODO: try_cast before erroring
		bind::insert_error(&context.bindings, ident, expected_ty, mutable);
		return node::some(err::error(
			context.parent, 
			err::ErrorKind::VarDeclTypeMismatch, 
			data.type.span
		));
	}

	let type = value_ty;
	let var_id = bind::insert(&context.bindings, ident, type, mutable);

	let kind = node::NodeKind::VarDecl;
	if !mutable { kind = node::NodeKind::ConstDecl; }

	let var_declaration = VarDeclaration { ident, value, type, var_id };

	return node::some(node::push(
		context.nodes, kind,
		type, node::NodeData { var_declaration }, span,
	));
}


pub fn typecheck_return(
	context: *FunctionContext,
	data: ast_statement::ReturnData,
	span: int,
): node::NodeResult {
	let has_value = data.has_value;
	let value = node::NONE;
	if has_value {
		let value_res = node::typecheck(context, data.value);
		value = value_res.node;
	}
	match context.return_ty.kind {
		ty::FlowTypeKind::Some => {
			if !has_value {
				err::error(
					context.parent,
					err::ErrorKind::ReturnSomeExpected,
					span
				);
			} else if value != node::ERROR {
				let value_data = node::get(context.nodes, value);
				if value_data.ty != context.return_ty.type {
					err::error(
						context.parent,
						err::ErrorKind::ReturnTypeMismatch,
						value_data.span
					);
				}
			}
		}
		ty::FlowTypeKind::Void => {
			if has_value {
				err::error(
					context.parent,
					err::ErrorKind::ReturnVoidExpected,
					span
				);
			}
		}
		ty::FlowTypeKind::Never => {
			err::error(
				context.parent,
				err::ErrorKind::ReturnNeverExpected,
				span
			);
		}
	}
	let retrn = ReturnData {
		has_value, value,
	};
	return node::result(
		node::push(
			context.nodes, node::NodeKind::Return,
			null, node::NodeData { retrn }, span,
		), 
		node::NodeFlow::Return
	);

}


pub fn typecheck_if(
	context: *FunctionContext,
	data: ast_statement::IfData,
	span: int,
): node::NodeResult {
	let flow = node::NodeFlow::Some;

	let cond_res = node::typecheck(context, data.cond);
	let cond = cond_res.node;
	let then_res = node::typecheck(context, data.then);
	let then = then_res.node;

	let otherwise = node::NONE;
	if data.otherwise != ast_node::NONE {
		let otherwise_res = node::typecheck(context, data.otherwise);
		otherwise = otherwise_res.node;
		flow = node::flow_any(then_res.flow, otherwise_res.flow);
	}

	if cond == node::ERROR { return node::result(node::ERROR, flow); }

	let cond_data = node::get(context.nodes, cond);
	if cond_data.ty != context.parent.typeidents.boolean {
		err::error(
			context.parent, 
			err::ErrorKind::IfCondNotBool, 
			cond_data.span
		);
	}

	let if_data = IfData { cond, then, otherwise };
	return node::result(
		node::push(
			context.nodes, node::NodeKind::If,
			null, node::NodeData { if_data }, span,
		),
		flow,
	);
}


pub fn typecheck_match(
	context: *FunctionContext,
	data: ast_statement::MatchData,
	span: int,
): node::NodeResult {
	return node::some(err::error(context.parent, err::ErrorKind::TODO, span));
}


pub fn typecheck_loop(
	context: *FunctionContext,
	data: ast_statement::LoopData,
	span: int,
): node::NodeResult {
	let has_cond = data.has_cond;
	let cond = node::NONE;
	let base_flow = node::NodeFlow::Never;
	if has_cond {
		let cond_res = node::typecheck(context, data.cond);
		cond = cond_res.node;
		base_flow = cond_res.flow;

		// TODO: Once I have early exits on &&, I could refactor this
		//      To something like `cond_data != null && cond_data.ty != ty_boolean`
		let cond_ty: *ty::TypeIdent = null;
		if cond != node::ERROR {
			let cond_data = node::get(context.nodes, cond);
			if cond_data.ty != context.parent.typeidents.boolean {
				err::error(
					context.parent,
					err::ErrorKind::LoopCondNotBool,
					cond_data.span
				);
			}
		}
	}
	let flow = base_flow;

	context.loop_depth += 1;
	let body_res = node::typecheck(context, data.body);
	let body = body_res.node;
	context.loop_depth -= 1;

	match body_res.flow {
		node::NodeFlow::Some |
		node::NodeFlow::Continue |
		node::NodeFlow::Return |
		node::NodeFlow::Never
			=> {}
		node::NodeFlow::Break => {
			flow = node::NodeFlow::Some;
		}
	}

	let loop_data = LoopData {
		has_cond, cond, body,
	};
	return node::result(node::push(
		context.nodes, node::NodeKind::Loop,
		null, node::NodeData { loop_data }, span,
	), flow);

}


pub fn typecheck_for(
	context: *FunctionContext,
	data: *ast_statement::ForData,
	span: int,
): node::NodeResult {
	bind::start(&context.bindings);
	let init_res = node::typecheck(context, data.init);
	let init = init_res.node;
	
	let cond_res = node::typecheck(context, data.cond);
	let cond = cond_res.node;

	let acc_res = node::typecheck(context, data.acc);
	let acc = acc_res.node;

	context.loop_depth += 1;
	let body_res = node::typecheck(context, data.body);
	let body = body_res.node;
	context.loop_depth -= 1;
	bind::end(&context.bindings);
	
	if cond != node::ERROR {
		let cond_data = node::get(context.nodes, cond);
		if cond_data.ty != context.parent.typeidents.boolean {
			err::error(
				context.parent,
				err::ErrorKind::LoopCondNotBool,
				cond_data.span
			);
		}
	}

	let for_data: *ForData = node::allocate_extra(context.nodes, sizeof(ForData));
	*for_data = ForData { init, cond, acc, body };
	return node::some(node::push(
		context.nodes, node::NodeKind::For,
		null, node::NodeData { for_data }, span,
	));
}


pub fn typecheck_break(context: *FunctionContext, span: int): node::NodeResult {
	if context.loop_depth == 0 {
		err::error(context.parent, err::ErrorKind::BreakOutsideLoop, span);
	}
	return node::result(
		node::push_simple(context.nodes, node::NodeKind::Break, span),
		node::NodeFlow::Break,
	);
}


pub fn typecheck_continue(context: *FunctionContext, span: int): node::NodeResult {
	if context.loop_depth == 0 {
		err::error(context.parent, err::ErrorKind::ContinueOutsideLoop, span);
	}
	return node::result(
		node::push_simple(context.nodes, node::NodeKind::Continue, span),
		node::NodeFlow::Continue,
	);
}


// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////

fn block_get(block: *BlockData, index: int): int {
	if index >= block.count { return node::NONE; }
	return block.nodes[index];
}


pub fn debug_block(sb: *sb::StringBuilder, nodes: *node::Nodes, block: *BlockData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "BLOCK\n");
	for let i = 0; i < block.count; i+=1 {
		let n = block_get(block, i);
		stdlib::assert(n != node::NONE, "statement::print_block");
		node::debug(sb, nodes, n, depth + 1);
	}
}



pub fn debug_var_decl(sb: *sb::StringBuilder, nodes: *node::Nodes, mutable: bool, data: *VarDeclaration, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "VAR_DECL ");
	if mutable { sb::append(sb, "LET "); } 
	else {       sb::append(sb, "CONST "); }
	sb::append(sb, data.ident);
	sb::append(sb, "@");
	sb::append_number(sb, data.var_id);
	sb::append(sb, "\n");

	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "TYPE: ");
	ty::debug(sb, nodes, data.type, depth);
	sb::append(sb, "\n");
	node::debug(sb, nodes, data.value, depth + 1);
}


pub fn debug_if(sb: *sb::StringBuilder, nodes: *node::Nodes, if_data: *IfData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "IF\n");
	node::debug(sb, nodes, if_data.cond, depth + 1);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "THEN\n");
	node::debug(sb, nodes, if_data.then, depth + 2);
	if if_data.otherwise {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "ELSE\n");
		node::debug(sb, nodes, if_data.otherwise, depth + 2);
	}
}


pub fn debug_loop(sb: *sb::StringBuilder, nodes: *node::Nodes, loop_data: *LoopData, depth: int) {
	sb::repeat(sb, "  ", depth);
	if loop_data.has_cond {
		sb::append(sb, "WHILE\n");
		node::debug(sb, nodes, loop_data.cond, depth + 1);
	} else {
		sb::append(sb, "LOOP\n");
	}
	node::debug(sb, nodes, loop_data.body, depth + 1);
}


pub fn debug_return(sb: *sb::StringBuilder, nodes: *node::Nodes, return_data: *ReturnData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "RETURN\n");
	if return_data.has_value {
		node::debug(sb, nodes, return_data.value, depth + 1);
	}
}


pub fn debug_for(sb: *sb::StringBuilder, nodes: *node::Nodes, for_data: **ForData, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "FOR\n");
	let for_data = *for_data;
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "INIT\n");
	node::debug(sb, nodes, for_data.init, depth + 2);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "COND\n");
	node::debug(sb, nodes, for_data.cond, depth + 2);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "ACC\n");
	node::debug(sb, nodes, for_data.acc, depth + 2);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "BODY\n");
	node::debug(sb, nodes, for_data.body, depth + 2);
}
