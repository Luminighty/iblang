const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"

import "./mod.ib"
import "./misc.ib"
import "./function.ib"

const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const node = import "./node.ib"
const statement = import "../ast/statement.ib"
const expr = import "../ast/expr.ib"
const utils = import "../utils/mod.ib"


pub enum UnaryOp {
	Group,
	Ref,
	Deref,
	Pos,
	Neg,
	Not,
	BitNot,
}

pub struct Unary {
	op: UnaryOp,
	expr: int, // NodeIdx
}


pub fn typecheck(
	context: *FunctionContext,
	data: ast_expr::Unary,
	span: int,
): node::NodeResult {
	match data.op {
		ast_expr::UnaryOp::Group =>  return node::typecheck(context, data.expr);
		ast_expr::UnaryOp::Ref =>    return   into_ref(context, data.expr, span);
		ast_expr::UnaryOp::Deref =>  return into_deref(context, data.expr, span);
		ast_expr::UnaryOp::Pos =>    return unary_arith(context, data.expr, UnaryOp::Pos,    span);
		ast_expr::UnaryOp::Neg =>    return unary_arith(context, data.expr, UnaryOp::Neg,    span);
		ast_expr::UnaryOp::BitNot => return unary_arith(context, data.expr, UnaryOp::BitNot, span);
		ast_expr::UnaryOp::Not =>    return unary_not(context, data.expr, span);
	}
}


fn into_ref(
	context: *FunctionContext,
	expr: int,
	span: int,
): node::NodeResult {
	utils::todo("unary::into_deref");
}


fn into_deref(
	context: *FunctionContext,
