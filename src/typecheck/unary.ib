const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"

import "./mod.ib"
import "./function.ib"

const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const err = import "./error.ib"
const node = import "./node.ib"
const statement = import "../ast/statement.ib"
const expr = import "../ast/expr.ib"
const utils = import "../utils/mod.ib"
const ty = import "./typeident.ib"


pub enum UnaryOp {
	Group,
	Pos,
	Neg,
	Not,
	BitNot,
}

pub struct Unary {
	op: UnaryOp,
	expr: int, // NodeIdx
}


pub fn typecheck(
	context: *FunctionContext,
	data: ast_expr::Unary,
	span: int,
): node::NodeResult {
	match data.op {
		ast_expr::UnaryOp::Group =>  return node::typecheck(context, data.expr);
		ast_expr::UnaryOp::Ref =>    return   into_ref(context, data.expr, span);
		ast_expr::UnaryOp::Deref =>  return into_deref(context, data.expr, span);
		ast_expr::UnaryOp::Pos =>    return unary_arith(context, data.expr, UnaryOp::Pos,    span);
		ast_expr::UnaryOp::Neg =>    return unary_arith(context, data.expr, UnaryOp::Neg,    span);
		ast_expr::UnaryOp::BitNot => return unary_arith(context, data.expr, UnaryOp::BitNot, span);
		ast_expr::UnaryOp::Not =>    return unary_not(context, data.expr, span);
	}
}


fn into_ref(
	context: *FunctionContext,
	expr: int,
	span: int,
): node::NodeResult {
	let expr_res = node::typecheck(context, expr);
	let expr = expr_res.node;
	// NOTE: I could try to inject an *any here as the type
	if expr == node::ERROR { return expr_res; }
	let expr_data = node::get(context.nodes, expr);
	let expr_ty = ty::pointer(&context.parent.typeidents, expr_data.ty);

	return node::result(
		node::push(
			context.nodes,
			node::NodeKind::Ref,
			expr_ty, node::NodeData { ref: expr }, span,
		),
		expr_res.flow
	);
}


fn into_deref(
	context: *FunctionContext,
	expr: int,
	span: int,
): node::NodeResult {
	let expr_res = node::typecheck(context, expr);
	let expr = expr_res.node;
	// NOTE: I could try to inject an *any here as the type
	if expr == node::ERROR { return expr_res; }
	let expr_data = node::get(context.nodes, expr);

	let ty = expr_data.ty;
	if ty.kind == ty::TypeKind::Pointer {
		if ty.data.pointer == null {
			return node::some(err::error(
				context.parent,
				err::ErrorKind::DerefAnyPtr,
				span,
			));
		}
		// TODO: Check if inner is is_object and RValue => ObjectCopy
		return node::some(
			node::push(
				context.nodes,
				node::NodeKind::Deref,
				ty.data.pointer, node::NodeData { deref: expr }, span,
			),
		);
	}

	return node::some(err::error(
		context.parent,
		err::ErrorKind::DerefNonPointer,
		span,
	));
}


fn unary_arith(
	context: *FunctionContext,
	expr: int,
	op: UnaryOp,
	span: int,
): node::NodeResult {
	let expr_res = node::typecheck(context, expr);
	let expr = expr_res.node;

	// TODO: Maybe I can return a numeric type here
	//       But need to think about it
	if expr == node::ERROR { return expr_res; }
	let expr_data = node::get(context.nodes, expr);
	if !ty::is_numeric(expr_data.ty) {
		err::error(
			context.parent,
			err::ErrorKind::UnaryNumericExpected,
			span
		);
	}

	let unary = Unary { op, expr };
	return node::result(
		node::push(
			context.nodes,
			node::NodeKind::Unary,
			expr_data.ty, node::NodeData { unary }, span,
		),
		expr_res.flow
	);
}


fn unary_not(
	context: *FunctionContext,
	expr: int,
	span: int,
): node::NodeResult {
	let expr_res = node::typecheck(context, expr);
	let expr = expr_res.node;

	// TODO: Maybe I can return a boolean type here
	//        But need to think about it, since 
	//        I would have to push the unary node too
	if expr == node::ERROR { return expr_res; }
	let expr_data = node::get(context.nodes, expr);
	if expr_data.ty != context.parent.typeidents.boolean {
		err::error(
			context.parent,
			err::ErrorKind::UnaryNotBoolExpected,
			span
		);
	}
	let ty = context.parent.typeidents.boolean;
	let unary = Unary { op: UnaryOp::Not, expr };
	return node::some(node::push(
		context.nodes,
		node::NodeKind::Unary,
		ty, node::NodeData { unary }, span,
	));
}


pub fn debug_unary(sb: *sb::StringBuilder, nodes: *node::Nodes, unary: *Unary, depth: int) {
	sb::repeat(sb, "  ", depth);
	match unary.op {
		UnaryOp::Group => sb::append(sb, "GROUP\n"),
		UnaryOp::Pos   => sb::append(sb, "POS\n"),
		UnaryOp::Neg   => sb::append(sb, "NEG\n"),
		UnaryOp::Not   => sb::append(sb, "NOT\n"),
		UnaryOp::BitNot=> sb::append(sb, "BITNOT\n"),
	}
	node::debug(sb, nodes, unary.expr, depth + 1);
}


pub fn debug_deref(sb: *sb::StringBuilder, nodes: *node::Nodes, expr: *int, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "DEREF\n");
	node::debug(sb, nodes, *expr, depth + 1);
}


pub fn debug_ref(sb: *sb::StringBuilder, nodes: *node::Nodes, expr: *int, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "REF\n");
	node::debug(sb, nodes, *expr, depth + 1);
}

