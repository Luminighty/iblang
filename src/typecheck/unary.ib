	span: int,
): node::NodeResult {
	utils::todo("unary::into_deref");
}


fn unary_arith(
	context: *FunctionContext,
	expr: int,
	op: UnaryOp,
	span: int,
): node::NodeResult {
	let expr_res = node::typecheck(context, expr);
	let expr = expr_res.node;

	if expr == node::ERROR { return expr_res; }
	let expr_data = node::get(context.nodes, expr);

	let unary = Unary { op, expr };
	return node::result(
		node::push(
			context.nodes,
			node::NodeKind::Unary,
			expr_data.ty, node::NodeData { unary }, span,
		),
		expr_res.flow
	);
}


fn unary_not(
	context: *FunctionContext,
	expr: int,
	span: int,
): node::NodeResult {
	utils::todo("unary::into_deref");
}


pub fn debug_unary(sb: *sb::StringBuilder, nodes: *node::Nodes, unary: *Unary, depth: int) {
	sb::repeat(sb, "  ", depth);
	match unary.op {
		UnaryOp::Group => sb::append(sb, "GROUP\n"),
		UnaryOp::Ref   => sb::append(sb, "REF\n"),
		UnaryOp::Deref => sb::append(sb, "DEREF\n"),
		UnaryOp::Pos   => sb::append(sb, "POS\n"),
		UnaryOp::Neg   => sb::append(sb, "NEG\n"),
		UnaryOp::Not   => sb::append(sb, "NOT\n"),
		UnaryOp::BitNot=> sb::append(sb, "BITNOT\n"),
	}
	node::debug(sb, nodes, unary.expr, depth + 1);
}


