const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"
const vec = import "../utils/vec.ib"
const arena = import "../utils/arena.ib"

const symbol = import "../symbol/symbol.ib"
const ast = import "../ast/declaration.ib"

import "./mod.ib"
const ty = import "./typeident.ib"
const mod = import "./module.ib"
const type_size_align = import "./type_size_align.ib"


pub struct ObjectField {
	field: str,
	field_span: int,
	type: *ty::TypeIdent,
	type_span: int,
	offset: int,
}


pub struct ObjectDef {
	name: str,
	span: int,
	field_count: int,
	fields: *ObjectField,
	align: int,
	size: int,
	symbol: *symbol::Symbol,
}


pub fn get_field(def: *ObjectDef, field: str): *ObjectField {
	for let i = 0; i < def.field_count; i+=1 {
		if def.fields[i].field == field {
			return &def.fields[i];
		}
	}
	return null;
}

pub const FIELD_IDX_NONE = -1;
pub fn get_field_idx(def: *ObjectDef, field: str): int {
	for let i = 0; i < def.field_count; i+=1 {
		if def.fields[i].field == field {
			return i;
		}
	}
	return FIELD_IDX_NONE;
}

pub fn typecheck_struct(
	context: *TypecheckContext,
	symbol: *symbol::Symbol,
) {
	if symbol.stage == symbol::SymbolStage::Typechecked { return; }
	symbol.stage = symbol::SymbolStage::TypecheckInProgress;

	let temp_ty = ty::TypeIdent {
		kind: ty::TypeKind::Compound,
		data: ty::TypeData { compound: symbol }
	};
	symbol.type = ty::find_or_insert(&context.typeidents, &temp_ty);

	let module = find_module(context, symbol.module);
	let def: *ObjectDef = vec::push(&module.structs);

	start_typechecking(context, symbol);

	let def = typecheck_obj_def(context, symbol, module, def);
	struct_alignment(context, def);
	symbol.stage = symbol::SymbolStage::Typechecked;

	finish_typechecking(context, symbol);
}

fn struct_alignment(context: *TypecheckContext, def: *ObjectDef) {
	let max_align = 1;
	let offset = 0;
	for let i = 0; i < def.field_count; i+=1 {
		let res = type_size_align::typeident(context, def.fields[i].type);
		
		if res.align > max_align { max_align = res.align; }
		offset = get_aligned_offset(offset, res.align);
		def.fields[i].offset = offset;
		offset += res.size;
	}
	let size = get_aligned_offset(offset, max_align);
	if size < 1 { size = 1; }
	def.align = max_align;
	def.size = size;
}


pub fn typecheck_union(
	context: *TypecheckContext,
	symbol: *symbol::Symbol,
) {
	if symbol.stage == symbol::SymbolStage::Typechecked { return; }
	symbol.stage = symbol::SymbolStage::TypecheckInProgress;

	let temp_ty = ty::TypeIdent {
		kind: ty::TypeKind::Compound,
		data: ty::TypeData { compound: symbol }
	};
	symbol.type = ty::find_or_insert(&context.typeidents, &temp_ty);

	let module = find_module(context, symbol.module);
	let def: *ObjectDef = vec::push(&module.unions);

	start_typechecking(context, symbol);

	let def = typecheck_obj_def(context, symbol, module, def);
	union_alignment(context, def);
	symbol.stage = symbol::SymbolStage::Typechecked;

	finish_typechecking(context, symbol);
}

fn union_alignment(context: *TypecheckContext, def: *ObjectDef) {
	let max_align = 1;
	let max_size = 0;
	for let i = 0; i < def.field_count; i+=1 {
		let res = type_size_align::typeident(context, def.fields[i].type);
		
		if res.align > max_align { max_align = res.align; }
		if res.size > max_size { max_size = res.size; }
		def.fields[i].offset = 0;
	}
	// let size = get_aligned_offset(offset, max_align);
	if max_size < 1 { max_size = 1; }
	def.align = max_align;
	def.size = max_size;
}


fn typecheck_obj_def(
	context: *TypecheckContext,
	symbol: *symbol::Symbol,
	module: *mod::Module,
	def: *ObjectDef,
): *ObjectDef {
	let ast_def = symbol.shallow.object_def;

	let name = ast_def.declaration.name;
	let span = ast_def.declaration.span;
	let field_count = ast_def.field_count;
	let fields = typecheck_fields(context, module, ast_def);

	*def = ObjectDef {
		name, span, symbol,
		field_count, fields,
		align: 1, size: 1,
	};
	symbol.deep.object_def = def;
	return def;
}

fn get_aligned_offset(offset: int, align: int): int {
	let padding = offset % align;
	if padding == 0 { return offset; }
	return offset + align - padding;
}


fn typecheck_fields(
	context: *TypecheckContext,
	module: *mod::Module,
	ast_def: *ast::ObjectDef
): *ObjectField {
	let fields: *ObjectField = arena::allocate(
		&module.object_data,
		sizeof(ObjectField) * ast_def.field_count
	);
	for let i = 0; i < ast_def.field_count; i+=1 {
		let field = ast_def.fields[i].field;
		let field_span = ast_def.fields[i].field_span;
		let type_span = ast_def.fields[i].type_span;
		let type = ty::typecheck(
			context,
			module.uid,
			ast_def.fields[i].type,
			type_span
		);

		fields[i] = ObjectField {
			field, field_span,
			type, type_span,
			offset: 0,
		};
	}
	return fields;
}


pub fn debug_struct(sb: *sb::StringBuilder, module: *mod::Module, obj: *ObjectDef) {
	debug_object_def(sb, module, obj, "STRUCT");
}

pub fn debug_union(sb: *sb::StringBuilder, module: *mod::Module, obj: *ObjectDef) {
	debug_object_def(sb, module, obj, "UNION");
}


fn debug_object_def(sb: *sb::StringBuilder, module: *mod::Module, obj: *ObjectDef, kind: str) {
	// if obj.declaration.is_public { sb::append(sb, "PUB "); }
	sb::append(sb, kind);
	sb::append(sb, " : ");
	sb::append(sb, obj.name);
	sb::append(sb, " ");
	type_size_align::debug(sb, obj.size, obj.align);
	sb::append(sb, "\n");
	for let i = 0; i < obj.field_count; i+=1 {
		sb::append(sb, "  .");
		sb::append_number(sb, obj.fields[i].offset);
		sb::append(sb, "\t");
		sb::append(sb, obj.fields[i].field);
		sb::append(sb, "\t: ");
		ty::debug(
			sb, &module.nodes,
			obj.fields[i].type,
			obj.fields[i].type_span
		);
		sb::append(sb, "\n");
	}
	sb::append(sb, "\n");
}

