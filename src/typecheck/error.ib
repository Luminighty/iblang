const stdlib = import "@stdlib"

const errors = import "../storage/error.ib"
const sb = import "../utils/stringbuilder.ib"


import "./mod.ib"
const node = import "./node.ib"

pub enum ErrorKind {
	TODO,

	VariableNotFound,

	VarDeclTypeMismatch,
}


pub fn error(context: *TypecheckContext, kind: ErrorKind, span: int): int {
	let err = errors::type_error(context.errors);

	err.span = span;
	// err.span_options.range = err::span_range(kind);

	append_message(&context.err_builder, kind);
	let msg = sb::build(&context.err_builder);
	sb::reset(&context.err_builder);

	err.message = msg;

	return node::ERROR;
}


fn append_message(sb: *sb::StringBuilder, error: ErrorKind) {
	match error {
	ErrorKind::TODO => sb::append(sb, "TODO: Not implemented yet!"),

	ErrorKind::VariableNotFound => sb::append(sb, "VariableNotFound"),
	ErrorKind::VarDeclTypeMismatch => sb::append(sb, "VarDeclTypeMismatch"),
	}
}

