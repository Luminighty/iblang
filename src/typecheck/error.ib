const stdlib = import "@stdlib"

const errors = import "../storage/error.ib"
const symbol = import "../symbol/symbol.ib"

const vec = import "../utils/vec.ib"
const sb = import "../utils/stringbuilder.ib"


import "./mod.ib"
const node = import "./node.ib"

pub enum ErrorKind {
	TODO,
	ConstEvalNotSupported,

	// Exprs
	VariableNotFound,
	CallNotFunction,
	CallArgCountIncorrect,
	CallArgTypeNotMatched,
	AssignTypeMismatch,
	BinaryTypeMismatch,
	InvalidCast,
	DerefAnyPtr,
	DerefNonPointer,
	UnaryNotBoolExpected,
	UnaryNumericExpected,
	InvalidPathElement,

	ArrayTargetTypeWasNotArray,
	ArrayWasEmptyWithoutTargetType,
	IndexAnyPtr,
	ExprCannotBeIndexed,
	IndexWasNotInteger,

	PathSymbolWasPrivate,
	PathModuleNotFound,
	PathEnumExpected,

	// TODO: This might not be an error in the future
	//       but please come up with a better name
	TypeIdentSkippedName,
	TypeIdentSymbolWasPrivate,
	TypeIdentModuleNotFound,

	DuplicateObjectField,
	UndefinedObjectField,
	SymbolCannotBeConstructed,
	UnknownSymbolForObjectInit,
	ObjectInitFieldTypeMismatch,
	ObjectFieldWasNotIdentifier,
	ObjectExpected,
	ObjectFieldNotFound,
	UnionInitOnlyOneFieldAllowed,

	EnumDuplicateField,
	EnumFieldWasNotNumber,

	// Statements
	VarDeclTypeMismatch,
	VarDeclValueFlowWasNotSome,
	IfCondNotBool,
	LoopCondNotBool,
	// NOTE: Would be nice to be able to point to mention
	//        both the return type and the type we got
	ReturnSomeExpected,
	ReturnVoidExpected,
	ReturnNeverExpected,
	ReturnTypeMismatch,
	BreakOutsideLoop,
	ContinueOutsideLoop,

	FunctionInvalidFlow,
}


pub fn error(context: *TypecheckContext, kind: ErrorKind, span: int): int {
	append_message(&context.err_builder, kind);
	_error(context, span);
	return node::ERROR;
}

pub fn object_missing_field(context: *TypecheckContext, field: str, span: int) {
	let sb = &context.err_builder;
	sb::append(sb, "Missing field: ");
	sb::append(sb, field);
	_error(context, span);
}

pub fn cyclic_dependency(context: *TypecheckContext, symbol: *symbol::Symbol) {
	let sb = &context.err_builder;
	sb::append(sb, "Circular Dependency: ");
	let start = 0;
	for let i = 0; i < context.typecheck_stack.count; i+=1 {
		let s = vec::get(&context.typecheck_stack, i);
		if s == symbol { start = i; break; }
	}
	sb::append(sb, symbol.name);
	for let i = start + 1; i < context.typecheck_stack.count; i+=1 {
		let s: **symbol::Symbol = vec::get(&context.typecheck_stack, i);
		sb::append(sb, " -> ");
		sb::append(sb, (*s).name);
	}
	let span = symbol.span;
	// TODO: Maybe use field span for objects, but it'd be a bit tricky now

	_error(context, symbol.span);
}

pub fn warn_unused_variable(context: *TypecheckContext, span: int) {
	sb::append(&context.err_builder, "Unused Variable");
	_warn(context, span);
}

fn _error(context: *TypecheckContext, span: int) {
	let err = errors::type_error(context.errors);
	err.span = span;
	err.message = sb::build(&context.err_builder);
	sb::reset(&context.err_builder);
}

fn _warn(context: *TypecheckContext, span: int) {
	let warn = errors::type_warn(context.errors);
	warn.span = span;
	warn.message = sb::build(&context.err_builder);
	sb::reset(&context.err_builder);
}


fn append_message(sb: *sb::StringBuilder, error: ErrorKind) {
	match error {
	ErrorKind::TODO => sb::append(sb, "TODO: Not implemented yet!"),

	ErrorKind::VariableNotFound => sb::append(sb, "VariableNotFound"),
	ErrorKind::VarDeclTypeMismatch => sb::append(sb, "VarDeclTypeMismatch"),
	ErrorKind::VarDeclValueFlowWasNotSome => sb::append(sb, "VarDeclValueFlowWasNotSome"),
	ErrorKind::IfCondNotBool => sb::append(sb, "IfCondNotBool"),
	ErrorKind::LoopCondNotBool => sb::append(sb, "LoopCondNotBool"),

	ErrorKind::ReturnSomeExpected => sb::append(sb, "ReturnSomeExpected"),
	ErrorKind::ReturnVoidExpected => sb::append(sb, "ReturnVoidExpected"),
	ErrorKind::ReturnNeverExpected => sb::append(sb, "ReturnNeverExpected"),
	ErrorKind::ReturnTypeMismatch => sb::append(sb, "ReturnTypeMismatch"),
	ErrorKind::FunctionInvalidFlow => sb::append(sb, "FunctionInvalidFlow"),
	ErrorKind::BreakOutsideLoop => sb::append(sb, "BreakOutsideLoop"),
	ErrorKind::ContinueOutsideLoop => sb::append(sb, "ContinueOutsideLoop"),

	ErrorKind::CallNotFunction => sb::append(sb, "CallNotFunction"),
	ErrorKind::CallArgCountIncorrect => sb::append(sb, "CallArgCountIncorrect"),
	ErrorKind::CallArgTypeNotMatched => sb::append(sb, "CallArgTypeNotMatched"),

	ErrorKind::AssignTypeMismatch => sb::append(sb, "AssignTypeMismatch"),
	ErrorKind::BinaryTypeMismatch => sb::append(sb, "BinaryTypeMismatch"),
	ErrorKind::InvalidCast => sb::append(sb, "InvalidCast"),
	ErrorKind::DerefAnyPtr => sb::append(sb, "DerefAnyPtr"),
	ErrorKind::DerefNonPointer => sb::append(sb, "DerefNonPointer"),
	ErrorKind::UnaryNotBoolExpected => sb::append(sb, "UnaryNotBoolExpected"),
	ErrorKind::UnaryNumericExpected => sb::append(sb, "UnaryNumericExpected"),

	ErrorKind::ArrayTargetTypeWasNotArray => sb::append(sb, "ArrayTargetTypeWasNotArray"),
	ErrorKind::ArrayWasEmptyWithoutTargetType => sb::append(sb, "ArrayWasEmptyWithoutTargetType"),
	ErrorKind::IndexAnyPtr => sb::append(sb, "IndexAnyPtr"),
	ErrorKind::ExprCannotBeIndexed => sb::append(sb, "ExprCannotBeIndexed"),
	ErrorKind::IndexWasNotInteger => sb::append(sb, "IndexWasNotInteger"),
	ErrorKind::DuplicateObjectField => sb::append(sb, "DuplicateObjectField"),
	ErrorKind::UndefinedObjectField => sb::append(sb, "UndefinedObjectField"),
	ErrorKind::SymbolCannotBeConstructed => sb::append(sb, "SymbolCannotBeConstructed"),
	ErrorKind::UnknownSymbolForObjectInit => sb::append(sb, "UnknownSymbolForObjectInit"),
	ErrorKind::ObjectInitFieldTypeMismatch => sb::append(sb, "ObjectInitFieldTypeMismatch"),
	ErrorKind::ObjectFieldWasNotIdentifier => sb::append(sb, "ObjectFieldWasNotIdentifier"),
	ErrorKind::ObjectExpected => sb::append(sb, "ObjectExpected"),
	ErrorKind::ObjectFieldNotFound => sb::append(sb, "ObjectFieldNotFound"),
	ErrorKind::UnionInitOnlyOneFieldAllowed => sb::append(sb, "UnionInitOnlyOneFieldAllowed"),
	ErrorKind::ConstEvalNotSupported => sb::append(sb, "ConstEvalNotSupported"),
	ErrorKind::EnumDuplicateField => sb::append(sb, "EnumDuplicateField"),
	ErrorKind::EnumFieldWasNotNumber => sb::append(sb, "EnumFieldWasNotNumber"),
	ErrorKind::InvalidPathElement => sb::append(sb, "InvalidPathElement"),
	ErrorKind::TypeIdentSkippedName => sb::append(sb, "TypeIdentSkippedName"),
	ErrorKind::TypeIdentSymbolWasPrivate => sb::append(sb, "TypeIdentSymbolWasPrivate"),
	ErrorKind::TypeIdentModuleNotFound => sb::append(sb, "TypeIdentModuleNotFound"),
	ErrorKind::PathEnumExpected => sb::append(sb, "Path resolved as enum variant, but symbol was not an enum."),
	ErrorKind::PathSymbolWasPrivate => sb::append(sb, "PathSymbolWasPrivate"),
	ErrorKind::PathModuleNotFound => sb::append(sb, "PathModuleNotFound"),

	}
}

