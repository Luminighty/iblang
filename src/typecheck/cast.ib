const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"

const symbol = import "../symbol/mod.ib"

import "./mod.ib"
import "./function.ib"
const err = import "./error.ib"

const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const ty = import "./typeident.ib"
const bind = import "./var_bindings.ib"
const node = import "./node.ib"


// TODO: Look into signed | unsigned casting differences
// 	Probably unsigned to larger signed is fine
// 	But anything else could be explicit
pub enum CastMethod {
	Keep,
	Truncate,
	Extend,
	// NOTE: We may need more info now that we'll have more int/float sizes + unsiged
	// 	We'll cross that bridge when we get there
	FloatToInt,
	IntToFloat,
	ArrayDecay,
	Deref,
}


pub struct Cast {
	expr: int, // NodeIdx
	into: *ty::TypeIdent,
	method: CastMethod,
}


pub fn explicit(
	context: *FunctionContext,
	data: ast_expr::Cast,
	span: int,
): int {
	let expr_res = node::typecheck(context, data.expr);
	let expr = expr_res.node;
	if expr == node::ERROR { return node::ERROR; }
	let expr_data = node::get(context.nodes, expr);

	let from = expr_data.ty;
	let into = ty::typecheck(context.parent, context.module.uid, data.type, data.type_span);
	if into == null { return node::ERROR; }

	let cast = Cast {
		expr, into, method: CastMethod::Keep,
	};
	if expr == node::ERROR {
		return node::push(
			context.nodes,
			node::NodeKind::Cast,
			into, node::NodeData { cast }, span,
		);
	}
	
	let is_ok = true;
	cast.method = cast_method(from, into, true, &is_ok);
	if !is_ok {
		err::error(context.parent, err::ErrorKind::InvalidCast, span);
	}

	return node::push(
		context.nodes,
		node::NodeKind::Cast,
		into, node::NodeData { cast }, span,
	);
}

struct ImplicitResult {
	is_ok: bool,
	expr: int,
}
pub fn implicit(
	context: *FunctionContext,
	expr: int, // Typechecked Expr
	into: *ty::TypeIdent,
	res_ok: *bool
): int {
	if expr == node::ERROR { return node::ERROR; }
	if expr == node::NONE { return node::NONE; }

	let expr_data = node::get(context.nodes, expr);
	let span = expr_data.span;
	let from = expr_data.ty;

	if from == into || into == null || from == null {
		*res_ok = true;
		return expr;
	}
	let method = cast_method(from, into, false, res_ok);
	let cast = Cast {
		expr, into, method,
	};
	return node::push(
		context.nodes,
		node::NodeKind::Cast,
		into, node::NodeData { cast }, span,
	);
}


// NOTE: Dummy value, since I will have to use res_ok
const CAST_INVALID = CastMethod::Keep;
fn cast_method(
	from: *ty::TypeIdent,
	into: *ty::TypeIdent,
	is_explicit: bool,
	res_ok: *bool
): CastMethod {
	*res_ok = true;
	if from == into { return CastMethod::Keep; }
	if from == null || into == null { return CastMethod::Keep; }

	if from.kind == ty::TypeKind::Atomic && into.kind == ty::TypeKind::Atomic {
		return try_cast_atomic(from.data.atomic, into.data.atomic, is_explicit, res_ok);
	}

	if from.kind == ty::TypeKind::Pointer && into.kind == ty::TypeKind::Pointer {
		let has_anyptr = from.data.pointer == null || into.data.pointer == null;
		if has_anyptr || is_explicit { return CastMethod::Keep; }
		// NOTE: This cannot be null, due to the any_ptr check above
		let _into_inner = into.data.pointer;

		*res_ok = false;
		return CAST_INVALID;
	}

	if from.kind == ty::TypeKind::Pointer && into.kind == ty::TypeKind::Atomic && is_explicit {
		if is_int(into.data.atomic) {
			return try_cast_atomic(ty::AtomicType::U64, into.data.atomic, is_explicit, res_ok);
		}
	}
	if from.kind == ty::TypeKind::Atomic && into.kind == ty::TypeKind::Pointer && is_explicit {
		if is_int(from.data.atomic) {
			return try_cast_atomic(from.data.atomic, ty::AtomicType::U64, is_explicit, res_ok);
		}
	}

	if from.kind == ty::TypeKind::Function && into.kind == ty::TypeKind::Function {
		return try_cast_function(&from.data.function, &into.data.function, is_explicit, res_ok);
	}

	// NOTE: I think this was just a quirk in the rust version, as I was storing Ptr(Funcs)
	// let has_fn = from.kind == ty::TypeKind::Function || into.kind == ty::TypeKind::Function;
	// let has_ptr = from.kind == ty::TypeKind::Pointer || into.kind == ty::TypeKind::Pointer;

	let is_from_enum = ty::is_enum(from);
	let is_into_enum = ty::is_enum(into);
	if is_from_enum || is_into_enum {
		return try_cast_enum(from, is_from_enum, into, is_into_enum, is_explicit, res_ok);
	}

	if from.kind == ty::TypeKind::Array && into.kind == ty::TypeKind::Pointer {
		if from.data.array.parent == into.data.pointer {
			return CastMethod::ArrayDecay;
		}
		*res_ok = false;
		return CAST_INVALID;
	}

	*res_ok = false;
	return CAST_INVALID;
}

pub fn try_cast_enum(from: *ty::TypeIdent, is_from_enum: bool, into: *ty::TypeIdent, is_into_enum: bool, is_explicit: bool, res_ok: *bool): CastMethod {
	let from_bits = 0;
	if is_from_enum {
		let enum_def = symbol::get_deep(from.data.compound).enum_def;
		from_bits = enum_def.size * 8; // NOTE: Bytes to bits
	} else if from.kind == ty::TypeKind::Atomic && is_explicit {
		// NOTE: casting atomic to enum should be explicit
		from_bits = atomic_bits(from.data.atomic);
	} else {
		// NOTE: Was not Int or Enum
		*res_ok = false;
		return CAST_INVALID;
	}
	let into_bits = 0;
	if is_into_enum {
		let enum_def = symbol::get_deep(into.data.compound).enum_def;
		into_bits = enum_def.size * 8; // NOTE: Bytes to bits
	} else if into.kind == ty::TypeKind::Atomic {
		into_bits = atomic_bits(into.data.atomic);
	} else {
		// NOTE: Was not Int or Enum
		*res_ok = false;
		return CAST_INVALID;
	}

	// NOTE: Casting from enum into enum should be explicit
	if is_into_enum && is_from_enum && !is_explicit {
		*res_ok = false;
		return CAST_INVALID;
	}

	if from_bits < into_bits {
		return CastMethod::Extend;
	} else if from_bits > into_bits {
		return CastMethod::Truncate;
	} else {
		// NOTE: Maybe we will need a Unsigned to signed / signed to unsigned
		return CastMethod::Keep;
	}
}


pub fn try_cast_function(from: *ty::FunctionType, into: *ty::FunctionType, _is_explicit: bool, res_ok: *bool): CastMethod {
	match from.return_ty.kind {
	ty::FlowTypeKind::Never => {} // Kinda weird, but if it floats your boat
	ty::FlowTypeKind::Void => {
		if into.return_ty.kind == ty::FlowTypeKind::Some {
			*res_ok = false;
			return CAST_INVALID;
		}
	}
	ty::FlowTypeKind::Some => {
		if into.return_ty.kind != ty::FlowTypeKind::Some {
			*res_ok = false;
			return CAST_INVALID;
		}
		// TODO: Maybe make this more constrainted
		let shared = shared_type(from.return_ty.type, into.return_ty.type);
		if shared == null {
			*res_ok = false;
			return CAST_INVALID;
		}
	}
	}

	if into.has_varargs && !from.has_varargs {
		*res_ok = false;
		return CAST_INVALID;
	}
	if from.args_length > into.args_length {
		*res_ok = false;
		return CAST_INVALID;
	}
	// append(fmt: str, ...) => append_robot(fmt: str, name: str, uid: int)
	if !from.has_varargs && from.args_length < into.args_length {
		*res_ok = false;
		return CAST_INVALID;
	}
	// NOTE: At this point, from has less args or has varargs, so we need to validate the argtypes
	for let i = 0; i < from.args_length; i+=1 {
		let shared = shared_type(from.args[i], into.args[i]);
		if shared == null {
			*res_ok = false;
			return CAST_INVALID;
		}
	}
	return CastMethod::Keep;
}


pub fn try_cast_atomic(from: ty::AtomicType, into: ty::AtomicType, is_explicit: bool, res_ok: *bool): CastMethod {
	if from == into { return CastMethod::Keep; }
	// NOTE: You may not convert between numbers and bool
	// TODO: Maybe allow explicit bool -> int or int to bool
	//        But probably a ternary operator would suffice 
	//        bool ? 1 : 0   vs    bool as int
	if from == ty::AtomicType::Bool || into == ty::AtomicType::Bool {
		*res_ok = false;
		return CAST_INVALID;
	}
	if is_float(from) && is_int(into) { return CastMethod::FloatToInt; }
	if is_int(from) && is_float(into) { return CastMethod::IntToFloat; }

	let from_bits = atomic_bits(from);
	let into_bits = atomic_bits(into);
	
	if is_sint(from) && is_uint(into) && !is_explicit {
		*res_ok = false;
		return CAST_INVALID;
	}

	// They are either both floats or both ints, so we can just extend/trunc
	if from_bits < into_bits {
		return CastMethod::Extend;
	} else if from_bits > into_bits {
		if is_explicit { return CastMethod::Truncate; }
		*res_ok = false;
		return CAST_INVALID;
	} else {
		// NOTE: i32 -> u32 needs to be explicit
		let has_uint = is_uint(from) || is_uint(into);
		let has_sint = is_sint(from) || is_sint(into);
		if has_uint && has_sint && !is_explicit {
			*res_ok = false;
			return CAST_INVALID;
		}
		return CastMethod::Keep;
	}
}


pub fn shared_type(lhs: *ty::TypeIdent, rhs: *ty::TypeIdent): *ty::TypeIdent {
	if lhs == rhs { return lhs; }
	if lhs == null || rhs == null { return null; }
	if lhs.kind == ty::TypeKind::Atomic   && rhs.kind == ty::TypeKind::Atomic   { return shared_atomic(lhs, rhs); }
	if lhs.kind == ty::TypeKind::Pointer  && rhs.kind == ty::TypeKind::Pointer  { return lhs; }
	if lhs.kind == ty::TypeKind::Pointer  && rhs.kind == ty::TypeKind::Function { return lhs; }
	if lhs.kind == ty::TypeKind::Function && rhs.kind == ty::TypeKind::Pointer  { return lhs; }
	// NOTE: Enums should probably need explicit casting
	return null;
}


fn shared_atomic(lhs: *ty::TypeIdent, rhs: *ty::TypeIdent): *ty::TypeIdent {
	let lhsa = lhs.data.atomic;
	let rhsa = rhs.data.atomic;
	if lhsa == rhsa { return lhs; }

	if lhsa == ty::AtomicType::Bool || rhsa == ty::AtomicType::Bool {
		return null;
	}

	let larger_ty = lhs;
	if atomic_bits(rhsa) > atomic_bits(lhsa) { larger_ty = rhs; }

	// NOTE: What about signed to unsigned
	if is_int(lhsa) && is_int(rhsa) { return larger_ty; }
	if is_float(lhsa) && is_float(rhsa) { return larger_ty; }

	if is_float(lhsa) || is_int(rhsa) { return lhs; }
	if is_int(lhsa) || is_float(rhsa) { return rhs; }

	return null;
}


pub fn is_float(atomic: ty::AtomicType): bool {
	match atomic {
		ty::AtomicType::F32 |
		ty::AtomicType::F64
			=> return true;
		_ => return false;
	}
}


pub fn is_int(atomic: ty::AtomicType): bool {
	return is_uint(atomic) || is_sint(atomic);
}

pub fn is_uint(atomic: ty::AtomicType): bool {
	match atomic {
		ty::AtomicType::U8  |
		ty::AtomicType::U16 |
		ty::AtomicType::U32 |
		ty::AtomicType::U64 |
		ty::AtomicType::U128 
			=> return true;
		_ => return false;
	}
}


pub fn is_sint(atomic: ty::AtomicType): bool {
	match atomic {
		ty::AtomicType::I8  |
		ty::AtomicType::I16 |
		ty::AtomicType::I32 |
		ty::AtomicType::I64 |
		ty::AtomicType::I128 
			=> return true;
		_ => return false;
	}
}


fn atomic_bits(atomic: ty::AtomicType): int {
	match atomic {
		ty::AtomicType::Bool =>  return 1;

		ty::AtomicType::U8   =>  return 8;
		ty::AtomicType::U16  => return 16;
		ty::AtomicType::U32  => return 32;
		ty::AtomicType::U64  => return 64;
		ty::AtomicType::U128 =>return 128;

		ty::AtomicType::I8 =>  return 8;
		ty::AtomicType::I16 => return 16;
		ty::AtomicType::I32 => return 32;
		ty::AtomicType::I64 => return 64;
		ty::AtomicType::I128 =>return 128;

		ty::AtomicType::F32 => return 32;
		ty::AtomicType::F64 => return 64;
	}
}


pub fn debug(sb: *sb::StringBuilder, nodes: *node::Nodes, cast: *Cast, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "CAST Method: ");
	match cast.method {
		CastMethod::Keep => sb::append(sb, "Keep"),
		CastMethod::Truncate => sb::append(sb, "Truncate"),
		CastMethod::Extend => sb::append(sb, "Extend"),
		CastMethod::FloatToInt => sb::append(sb, "FloatToInt"),
		CastMethod::IntToFloat => sb::append(sb, "IntToFloat"),
		CastMethod::ArrayDecay => sb::append(sb, "ArrayDecay"),
		CastMethod::Deref => sb::append(sb, "Deref"),
	}
	sb::append(sb, "\n");
	node::debug(sb, nodes, cast.expr, depth + 1);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "CAST_INTO ");
	ty::debug(sb, cast.into, depth + 1);
	sb::append(sb, "\n");
}

