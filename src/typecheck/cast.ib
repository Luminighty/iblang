pub enum CastMethod {
    Keep,
    Truncate,
    Extend,
    FloatToInt,
    IntToFloat,
    ArrayDecay,
    Deref,
}


pub struct ImplicitCast {
	expr: int, // NodeIdx
	target: *ty::TypeIdent,
	method: CastMethod,
}

pub struct ExplicitCast {
	expr: int, // NodeIdx
	type: *ty::TypeIdent,
	method: CastMethod,
	type_span: int,
}


