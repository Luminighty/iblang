const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"

const symbol = import "../symbol/mod.ib"

import "./mod.ib"
import "./function.ib"
const err = import "./error.ib"

const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const ty = import "./typeident.ib"
const bind = import "./var_bindings.ib"
const node = import "./node.ib"


// TODO: Look into signed | unsigned casting differences
pub enum CastMethod {
	Keep,
	Truncate,
	Extend,
	// NOTE: We may need more info now that we'll have more int/float sizes + unsiged
	// 	We'll cross that bridge when we get there
	FloatToInt,
	IntToFloat,
	ArrayDecay,
	Deref,
}


pub struct Cast {
	expr: int, // NodeIdx
	into: *ty::TypeIdent,
	method: CastMethod,
}


pub fn explicit(
	context: *FunctionContext,
	data: ast_expr::Cast,
	span: int,
): int {
	let expr_res = node::typecheck(context, data.expr);
	let expr = expr_res.node;
	let expr_data = node::get(context.nodes, expr);

	let from = expr_data.ty;
	let into = ty::typecheck(context.parent, data.type, data.type_span);
	if into == null { return node::ERROR; }

	let cast = Cast {
		expr, into, method: CastMethod::Keep,
	};
	if expr == node::ERROR {
		return node::push(
			context.nodes,
			node::NodeKind::Cast,
			into, node::NodeData { cast }, span,
		);
	}
	
	let is_ok = true;
	cast.method = cast_method(from, into, true, &is_ok);
	if !is_ok {
		err::error(context.parent, err::ErrorKind::InvalidCast, span);
	}

	return node::push(
		context.nodes,
		node::NodeKind::Cast,
		into, node::NodeData { cast }, span,
	);
}

struct ImplicitResult {
	is_ok: bool,
	expr: int,
}
pub fn implicit(
	context: *FunctionContext,
	expr: int, // Typechecked Expr
	into: *ty::TypeIdent,
	res_ok: *bool
): int {
	let expr_data = node::get(context.nodes, expr);
	let span = expr_data.span;
	let from = expr_data.ty;

	if from == into {
		*res_ok = true;
		return expr;
	}
	let method = cast_method(from, into, false, res_ok);
	let cast = Cast {
		expr, into, method,
	};
	return node::push(
		context.nodes,
		node::NodeKind::Cast,
		into, node::NodeData { cast }, span,
	);
}


// NOTE: Dummy value, since I will have to use res_ok
const CAST_INVALID = CastMethod::Keep;
fn cast_method(
	from: *ty::TypeIdent, 
	into: *ty::TypeIdent, 
	is_explicit: bool,
	res_ok: *bool
): CastMethod {
	*res_ok = true;
	if from == into { return CastMethod::Keep; }

	if from.kind == ty::TypeKind::Atomic && into.kind == ty::TypeKind::Atomic {
		return try_cast_atomic(from.data.atomic, into.data.atomic, is_explicit, res_ok);
	}

	if from.kind == ty::TypeKind::Pointer && into.kind == ty::TypeKind::Pointer {
		let has_anyptr = from.data.pointer == null || into.data.pointer == null;
		if has_anyptr || is_explicit { return CastMethod::Keep; }
		// NOTE: This cannot be null, due to the any_ptr check above
		let into_inner = into.data.pointer;

		*res_ok = false;
		return CAST_INVALID;
	}

	if from.kind == ty::TypeKind::Pointer && into.kind == ty::TypeKind::Atomic {
		return try_cast_atomic(ty::AtomicType::U64, into.data.atomic, is_explicit, res_ok);
	}

	let has_fn = from.kind == ty::TypeKind::Function || into.kind == ty::TypeKind::Function;
	let has_ptr = from.kind == ty::TypeKind::Pointer || into.kind == ty::TypeKind::Pointer;
	if has_fn && has_ptr {
		// TODO: Try to validate fn -> fn args/return maybe?
		// 	But if they are the exact same, from == into would catch it
		// 	So this needs to be investigated with real usecases
		//	Maybe allow if explicit, or if it is *any
		return CastMethod::Keep;
	}

	// TODO: Enum | int -> int | Enum

	// TODO: *Foo[] -> *Foo (Decay?)
	// TODO: *Foo[] -> Foo[] (Keey?)

	// TODO: Foo[] -> *Foo (Decay)
	*res_ok = false;
	return CAST_INVALID;
}


pub fn try_cast_atomic(from: ty::AtomicType, into: ty::AtomicType, is_explicit: bool, res_ok: *bool): CastMethod {
	if from == into { return CastMethod::Keep; }
	// NOTE: You may not convert between numbers and bool
	if from == ty::AtomicType::Bool || into == ty::AtomicType::Bool {
		*res_ok = false;
		return CAST_INVALID;
	}
	if is_float(from) && is_int(into) { return CastMethod::FloatToInt; }
	if is_int(from) && is_float(into) { return CastMethod::IntToFloat; }

	let from_bits = atomic_bits(from);
	let into_bits = atomic_bits(into);
	// They are either both floats or both ints, so we can just extend/trunc
	if from_bits < into_bits {
		return CastMethod::Extend;
	} else if from_bits > into_bits {
		return CastMethod::Truncate;
	} else {
		// NOTE: Maybe we will need a Unsigned to signed / signed to unsigned
		return CastMethod::Keep;
	}
}


pub fn shared_type(lhs: *ty::TypeIdent, rhs: *ty::TypeIdent): *ty::TypeIdent {
	if lhs == rhs { return lhs; }
	if lhs.kind == ty::TypeKind::Atomic   && rhs.kind == ty::TypeKind::Atomic   { return shared_atomic(lhs, rhs); }
	if lhs.kind == ty::TypeKind::Pointer  && rhs.kind == ty::TypeKind::Pointer  { return lhs; }
	if lhs.kind == ty::TypeKind::Pointer  && rhs.kind == ty::TypeKind::Function { return lhs; }
	if lhs.kind == ty::TypeKind::Function && rhs.kind == ty::TypeKind::Pointer  { return lhs; }
	return null;
}


fn shared_atomic(lhs: *ty::TypeIdent, rhs: *ty::TypeIdent): *ty::TypeIdent {
	let lhsa = lhs.data.atomic;
	let rhsa = rhs.data.atomic;
	if lhsa == rhsa { return lhs; }

	if lhsa == ty::AtomicType::Bool || rhsa == ty::AtomicType::Bool {
		return null;
	}

	let larger_ty = lhs;
	if atomic_bits(rhsa) > atomic_bits(lhsa) { larger_ty = rhs; }

	// NOTE: What about signed to unsigned
	if is_int(lhsa) && is_int(rhsa) { return larger_ty; }
	if is_float(lhsa) && is_float(rhsa) { return larger_ty; }

	if is_float(lhsa) || is_int(rhsa) { return lhs; }
	if is_int(lhsa) || is_float(rhsa) { return rhs; }

	return null;
}


fn is_float(atomic: ty::AtomicType): bool {
	match atomic {
		ty::AtomicType::F32 |
		ty::AtomicType::F64
			=> return true;
		_ => return false;
	}
}


fn is_int(atomic: ty::AtomicType): bool {
	return is_uint(atomic) || is_sint(atomic);
}

fn is_uint(atomic: ty::AtomicType): bool {
	match atomic {
		ty::AtomicType::U8  |
		ty::AtomicType::U16 |
		ty::AtomicType::U32 |
		ty::AtomicType::U64 |
		ty::AtomicType::U128 
			=> return true;
		_ => return false;
	}
}


fn is_sint(atomic: ty::AtomicType): bool {
	match atomic {
		ty::AtomicType::I8  |
		ty::AtomicType::I16 |
		ty::AtomicType::I32 |
		ty::AtomicType::I64 |
		ty::AtomicType::I128 
			=> return true;
		_ => return false;
	}
}


fn atomic_bits(atomic: ty::AtomicType): int {
	match atomic {
		ty::AtomicType::Bool => return 1;
		ty::AtomicType::U8   =>  return 8;
		ty::AtomicType::U16  => return 16;
		ty::AtomicType::U32  => return 32;
		ty::AtomicType::U64  => return 64;
		ty::AtomicType::U128 =>return 128;

		ty::AtomicType::I8 =>  return 8;
		ty::AtomicType::I16 => return 16;
		ty::AtomicType::I32 => return 32;
		ty::AtomicType::I64 => return 64;
		ty::AtomicType::I128 =>return 128;

		ty::AtomicType::F32 => return 32;
		ty::AtomicType::F64 => return 64;
	}

}


pub fn debug(sb: *sb::StringBuilder, nodes: *node::Nodes, cast: *Cast, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "CAST Method: ");
	match cast.method {
		CastMethod::Keep => sb::append(sb, "Keep"),
		CastMethod::Truncate => sb::append(sb, "Truncate"),
		CastMethod::Extend => sb::append(sb, "Extend"),
		CastMethod::FloatToInt => sb::append(sb, "FloatToInt"),
		CastMethod::IntToFloat => sb::append(sb, "IntToFloat"),
		CastMethod::ArrayDecay => sb::append(sb, "ArrayDecay"),
		CastMethod::Deref => sb::append(sb, "Deref"),
	}
	sb::append(sb, "\n");
	node::debug(sb, nodes, cast.expr, depth + 1);
	sb::repeat(sb, "  ", depth + 1);
	sb::append(sb, "CAST_INTO ");
	ty::debug(sb, nodes, cast.into, depth + 1);
	sb::append(sb, "\n");
}

