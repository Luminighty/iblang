const expr = import "../ast/expr.ib"
const utils = import "../utils/mod.ib"


pub enum BinaryOp {
	None,
	Add, Sub,
	Mul, Div, Rem,

	Assign,
	AssignAdd, AssignSub,
	AssignMul, AssignDiv, AssignRem,

	EQ, NE,
	GT, GE,
	LT, LE,
	And, Or,

	BitAnd, BitOr, BitXor,
	BitShiftRight, BitShiftLeft,

	Index,

	FieldLookup,
	Path,
}


pub struct Binary {
	op: BinaryOp,
	lhs: int, // NodeIdx
	rhs: int, // NodeIdx
}


pub fn typecheck(
	context: *FunctionContext,
	data: expr::Binary,
	span: int,
): int {
	match data.op {
	expr::BinaryOp::None =>
		stdlib::assert(false, "BinaryOp::None"),

	expr::BinaryOp::Index
		=> return index(context, data);
	expr::BinaryOp::Assign
		=> return assign(context, data);

	expr::BinaryOp::Add |
	expr::BinaryOp::Sub |
	expr::BinaryOp::Mul |
	expr::BinaryOp::Div |
	expr::BinaryOp::Rem
		=> return arith(context, data);

	expr::BinaryOp::AssignAdd |
	expr::BinaryOp::AssignSub |
	expr::BinaryOp::AssignMul |
	expr::BinaryOp::AssignDiv |
	expr::BinaryOp::AssignRem
		=> return assign_arith(context, data);

	expr::BinaryOp::EQ |
	expr::BinaryOp::NE |
	expr::BinaryOp::GT |
	expr::BinaryOp::GE |
	expr::BinaryOp::LT |
	expr::BinaryOp::LE
		=> return pred(context, data);

	expr::BinaryOp::And |
	expr::BinaryOp::Or
		=> return pred_bool(context, data);

	expr::BinaryOp::BitOr |
	expr::BinaryOp::BitXor |
	expr::BinaryOp::BitAnd |
	expr::BinaryOp::BitShiftRight |
	expr::BinaryOp::BitShiftLeft
		=> return bit_op(context, data);

	expr::BinaryOp::FieldLookup
		=> return field_lookup(context, data);
	expr::BinaryOp::Path
		=> return path(context, data);
	}

	return 0;
}


