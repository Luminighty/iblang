const ast_node = import "../ast/node.ib"

const node = import "./node.ib"
const ty = import "./typeident.ib"
const array = import "./array.ib"
const object = import "./object.ib"


pub enum BinaryOp {
	None,
	Add, Sub,
	Mul, Div, Rem,

	Assign,
	AssignAdd, AssignSub,
	AssignMul, AssignDiv, AssignRem,

	EQ, NE,
	GT, GE,
	LT, LE,
	And, Or,

	BitAnd, BitOr, BitXor,
	BitShiftRight, BitShiftLeft,

	Index,

	FieldLookup,
	Path,
}


pub struct Binary {
	op: BinaryOp,
	lhs: int, // NodeIdx
	rhs: int, // NodeIdx
}


pub fn typecheck(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	match data.op {
	ast_expr::BinaryOp::None =>
		stdlib::assert(false, "BinaryOp::None"),

	ast_expr::BinaryOp::Add |
	ast_expr::BinaryOp::Sub |
	ast_expr::BinaryOp::Mul |
	ast_expr::BinaryOp::Div |
	ast_expr::BinaryOp::Rem
		=> return arith(context, data, span);

	ast_expr::BinaryOp::AssignAdd |
	ast_expr::BinaryOp::AssignSub |
	ast_expr::BinaryOp::AssignMul |
	ast_expr::BinaryOp::AssignDiv |
	ast_expr::BinaryOp::AssignRem
		=> return assign_arith(context, data, span);

	ast_expr::BinaryOp::EQ |
	ast_expr::BinaryOp::NE |
	ast_expr::BinaryOp::GT |
	ast_expr::BinaryOp::GE |
	ast_expr::BinaryOp::LT |
	ast_expr::BinaryOp::LE
		=> return pred(context, data, span);

	ast_expr::BinaryOp::And |
	ast_expr::BinaryOp::Or
		=> return pred_bool(context, data, span);

	ast_expr::BinaryOp::BitOr |
	ast_expr::BinaryOp::BitXor |
	ast_expr::BinaryOp::BitAnd |
	ast_expr::BinaryOp::BitShiftRight |
	ast_expr::BinaryOp::BitShiftLeft
		=> return bit_op(context, data, span);

	ast_expr::BinaryOp::Index
		=> return array::typecheck_index(context, data, span);
	ast_expr::BinaryOp::Assign
		=> return assign(context, data, span);
	ast_expr::BinaryOp::FieldLookup
		=> return object::typecheck_field_lookup(context, data, span);
	ast_expr::BinaryOp::Path
		=> return path(context, data, span);
	}

	return 0;
}


fn assign(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	utils::todo("Not Implemented: assign");
}


fn arith(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	return basic(context, data, span);
}


fn assign_arith(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	utils::todo("Not Implemented: assign_arith");
}


fn pred(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	let node = basic(context, data, span);
	if node == node::ERROR { return node; }
	let node_data = node::get(context.nodes, node);
	node_data.ty = ty::atomic(&context.parent.typeidents, ty::AtomicType::Bool);
	return node;
}


fn pred_bool(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	return basic(context, data, span);
}


fn path(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	utils::todo("Not Implemented: path");
}


fn bit_op(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	return basic(context, data, span);
}


fn basic(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {

	let lhs_res = node::typecheck(context, data.lhs);
	let rhs_res = node::typecheck(context, data.rhs);
	let lhs = lhs_res.node;
	let rhs = rhs_res.node;

	if lhs == node::ERROR || rhs == node::ERROR { return node::ERROR; }

	let lhs_data = node::get(context.nodes, lhs);
	let rhs_data = node::get(context.nodes, rhs);

	// TODO: Attempt to find shared type
	if lhs_data.ty != rhs_data.ty { return node::ERROR; }

	let ty = lhs_data.ty;
	let binary = Binary {
		op: from_ast_op(data.op),
		lhs, rhs
	};
	return node::push(
		context.nodes,
		node::NodeKind::Binary,
		ty, node::NodeData { binary }, span,
	);
	// let lhs = typecheck_expr(global_context, context, lhs, mode)?;
	// let lhs_type = unwrap_typeident(context.module_id, expr_type(&lhs), lhs_span)?;
	//
	// let lhs_span = lhs.span;
	// let rhs_span = rhs.span;
	//
	// let rhs = typecheck_expr(global_context, context, rhs, mode)?;
	// let rhs_type = unwrap_typeident(context.module_id, expr_type(&rhs), rhs_span)?;
	//
	// let common_type = match TypeIdent::shared_type(&lhs_type, &rhs_type) {
	// Ok(ty) => ty,
	// Err(_) => {
	// return Err(TypecheckError::new(
	// TypecheckErrorKind::BinaryTypeMismatch {
	// op: *op,
	// lhs: lhs_type,
	// rhs: rhs_type,
	// },
	// context.module_id,
	// span,
	// ));
	// }
	// };
	//
	// let mut lhs = try_cast(context, lhs, lhs_type, common_type.clone(), false)?;
	// let mut rhs = try_cast(context, rhs, rhs_type, common_type.clone(), false)?;
	// lhs.value_kind = ValueKind::RValue;
	// rhs.value_kind = ValueKind::RValue;
	//
	// Ok((lhs, rhs, common_type))
}

fn from_ast_op(op: ast_expr::BinaryOp): BinaryOp {
	match op {
	ast_expr::BinaryOp::None => return BinaryOp::None;
	ast_expr::BinaryOp::Add => return BinaryOp::Add;
	ast_expr::BinaryOp::Sub => return BinaryOp::Sub;
	ast_expr::BinaryOp::Mul => return BinaryOp::Mul;
	ast_expr::BinaryOp::Div => return BinaryOp::Div;
	ast_expr::BinaryOp::Rem => return BinaryOp::Rem;
	ast_expr::BinaryOp::Assign => return BinaryOp::Assign;
	ast_expr::BinaryOp::AssignAdd => return BinaryOp::AssignAdd;
	ast_expr::BinaryOp::AssignSub => return BinaryOp::AssignSub;
	ast_expr::BinaryOp::AssignMul => return BinaryOp::AssignMul;
	ast_expr::BinaryOp::AssignDiv => return BinaryOp::AssignDiv;
	ast_expr::BinaryOp::AssignRem => return BinaryOp::AssignRem;
	ast_expr::BinaryOp::EQ => return BinaryOp::EQ;
	ast_expr::BinaryOp::NE => return BinaryOp::NE;
	ast_expr::BinaryOp::GT => return BinaryOp::GT;
	ast_expr::BinaryOp::GE => return BinaryOp::GE;
	ast_expr::BinaryOp::LT => return BinaryOp::LT;
	ast_expr::BinaryOp::LE => return BinaryOp::LE;
	ast_expr::BinaryOp::And => return BinaryOp::And;
	ast_expr::BinaryOp::Or => return BinaryOp::Or;
	ast_expr::BinaryOp::BitAnd => return BinaryOp::BitAnd;
	ast_expr::BinaryOp::BitOr => return BinaryOp::BitOr;
	ast_expr::BinaryOp::BitXor => return BinaryOp::BitXor;
	ast_expr::BinaryOp::BitShiftRight => return BinaryOp::BitShiftRight;
	ast_expr::BinaryOp::BitShiftLeft => return BinaryOp::BitShiftLeft;
	ast_expr::BinaryOp::Index => return BinaryOp::Index;
	ast_expr::BinaryOp::FieldLookup => return BinaryOp::FieldLookup;
	ast_expr::BinaryOp::Path => return BinaryOp::Path;
	}
}

