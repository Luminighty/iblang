fn basic(
	context: *FunctionContext,
	data: expr::Binary
): int {

	let lhs = node::typecheck(context, data.lhs);
	let rhs = node::typecheck(context, data.rhs);

	if lhs == node::ERROR || rhs == node::ERROR { return node::ERROR; }

	return node::NONE;
