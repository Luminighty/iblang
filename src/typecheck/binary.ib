const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"

import "./mod.ib"
import "./misc.ib"
import "./function.ib"

const ast_statement = import "../ast/statement.ib"
const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const err = import "./error.ib"
const node = import "./node.ib"
const expr = import "./expr.ib"
const ty = import "./typeident.ib"
const array = import "./array.ib"
const object = import "./object.ib"


pub enum BinaryOp {
	None,
	Add, Sub,
	Mul, Div, Rem,

	EQ, NE,
	GT, GE,
	LT, LE,
	And, Or,

	BitAnd, BitOr, BitXor,
	BitShiftRight, BitShiftLeft,

	Index,

	FieldLookup,
	Path,
}

pub enum AssignOp {
	None, Add, Sub, Mul, Div, Rem,
}


pub struct Binary {
	op: BinaryOp,
	lhs: int, // NodeIdx
	rhs: int, // NodeIdx
}

pub struct Assign {
	target: int, // NodeIdx
	value: int, // NodeIdx
	op: AssignOp,
}


pub fn typecheck(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	match data.op {
	ast_expr::BinaryOp::None =>
		stdlib::assert(false, "BinaryOp::None"),

	ast_expr::BinaryOp::Add |
	ast_expr::BinaryOp::Sub |
	ast_expr::BinaryOp::Mul |
	ast_expr::BinaryOp::Div |
	ast_expr::BinaryOp::Rem
		=> return arith(context, data, span);

	ast_expr::BinaryOp::Assign    => return assign(context, data, AssignOp::None, span);
	ast_expr::BinaryOp::AssignAdd => return assign(context, data, AssignOp::Add, span);
	ast_expr::BinaryOp::AssignSub => return assign(context, data, AssignOp::Sub, span);
	ast_expr::BinaryOp::AssignMul => return assign(context, data, AssignOp::Mul, span);
	ast_expr::BinaryOp::AssignDiv => return assign(context, data, AssignOp::Div, span);
	ast_expr::BinaryOp::AssignRem => return assign(context, data, AssignOp::Rem, span);

	ast_expr::BinaryOp::EQ |
	ast_expr::BinaryOp::NE |
	ast_expr::BinaryOp::GT |
	ast_expr::BinaryOp::GE |
	ast_expr::BinaryOp::LT |
	ast_expr::BinaryOp::LE
		=> return pred(context, data, span);

	ast_expr::BinaryOp::And |
	ast_expr::BinaryOp::Or
		=> return pred_bool(context, data, span);

	ast_expr::BinaryOp::BitOr |
	ast_expr::BinaryOp::BitXor |
	ast_expr::BinaryOp::BitAnd |
	ast_expr::BinaryOp::BitShiftRight |
	ast_expr::BinaryOp::BitShiftLeft
		=> return bit_op(context, data, span);

	ast_expr::BinaryOp::Index
		=> return array::typecheck_index(context, data, span);
	ast_expr::BinaryOp::FieldLookup
		=> return object::typecheck_field_lookup(context, data, span);
	ast_expr::BinaryOp::Path
		=> return expr::typecheck_path(context, data, span);
	}

	return 0;
}


fn assign(
	context: *FunctionContext,
	data: ast_expr::Binary,
	op: AssignOp,
	span: int,
): int {
	let target_res = node::typecheck(context, data.lhs);
	let value_res = node::typecheck(context, data.rhs);
	let target = target_res.node;
	let value = value_res.node;

	if target == node::ERROR || value == node::ERROR { return node::ERROR; }
	let target_data = node::get(context.nodes, target);
	let value_data = node::get(context.nodes, value);

	// TODO: Attempt to cast value into target
	if target_data.ty != value_data.ty {
		err::error(
			context.parent,
			err::ErrorKind::AssignTypeMismatch,
			span,
		);
	}

	let assign = Assign {
		op, target, value
	};
	return node::push(
		context.nodes,
		node::NodeKind::Assign,
		target_data.ty, node::NodeData { assign }, span,
	);
}


fn arith(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	return basic(context, data, span);
}


fn pred(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	let node = basic(context, data, span);
	if node == node::ERROR { return node; }
	let node_data = node::get(context.nodes, node);
	node_data.ty = ty::atomic(&context.parent.typeidents, ty::AtomicType::Bool);
	return node;
}


fn pred_bool(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	return basic(context, data, span);
}


fn bit_op(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	return basic(context, data, span);
}


fn basic(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	let lhs_res = node::typecheck(context, data.lhs);
	let rhs_res = node::typecheck(context, data.rhs);
	let lhs = lhs_res.node;
	let rhs = rhs_res.node;

	if lhs == node::ERROR || rhs == node::ERROR { return node::ERROR; }

	let lhs_data = node::get(context.nodes, lhs);
	let rhs_data = node::get(context.nodes, rhs);

	// TODO: Attempt to find shared type
	if lhs_data.ty != rhs_data.ty {
		err::error(
			context.parent,
			err::ErrorKind::BinaryTypeMismatch,
			span,
		);
	}

	let ty = lhs_data.ty;
	let binary = Binary {
		op: from_ast_op(data.op),
		lhs, rhs
	};
	return node::push(
		context.nodes,
		node::NodeKind::Binary,
		ty, node::NodeData { binary }, span,
	);
}

fn from_ast_op(op: ast_expr::BinaryOp): BinaryOp {
	match op {
	ast_expr::BinaryOp::None => return BinaryOp::None;
	ast_expr::BinaryOp::Add => return BinaryOp::Add;
	ast_expr::BinaryOp::Sub => return BinaryOp::Sub;
	ast_expr::BinaryOp::Mul => return BinaryOp::Mul;
	ast_expr::BinaryOp::Div => return BinaryOp::Div;
	ast_expr::BinaryOp::Rem => return BinaryOp::Rem;
	ast_expr::BinaryOp::Assign |
	ast_expr::BinaryOp::AssignAdd |
	ast_expr::BinaryOp::AssignSub |
	ast_expr::BinaryOp::AssignMul |
	ast_expr::BinaryOp::AssignDiv |
	ast_expr::BinaryOp::AssignRem => {
		stdlib::assert(0, "Assign op is not Binaryop during typechecking.");
		return BinaryOp::None;
	}
	ast_expr::BinaryOp::EQ => return BinaryOp::EQ;
	ast_expr::BinaryOp::NE => return BinaryOp::NE;
	ast_expr::BinaryOp::GT => return BinaryOp::GT;
	ast_expr::BinaryOp::GE => return BinaryOp::GE;
	ast_expr::BinaryOp::LT => return BinaryOp::LT;
	ast_expr::BinaryOp::LE => return BinaryOp::LE;
	ast_expr::BinaryOp::And => return BinaryOp::And;
	ast_expr::BinaryOp::Or => return BinaryOp::Or;
	ast_expr::BinaryOp::BitAnd => return BinaryOp::BitAnd;
	ast_expr::BinaryOp::BitOr => return BinaryOp::BitOr;
	ast_expr::BinaryOp::BitXor => return BinaryOp::BitXor;
	ast_expr::BinaryOp::BitShiftRight => return BinaryOp::BitShiftRight;
	ast_expr::BinaryOp::BitShiftLeft => return BinaryOp::BitShiftLeft;
	ast_expr::BinaryOp::Index => return BinaryOp::Index;
	ast_expr::BinaryOp::FieldLookup => return BinaryOp::FieldLookup;
	ast_expr::BinaryOp::Path => return BinaryOp::Path;
	}
}

// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////


pub fn debug(sb: *sb::StringBuilder, nodes: *node::Nodes, binary: *Binary, depth: int) {
	sb::repeat(sb, "  ", depth);
	match binary.op {
		BinaryOp::None    => sb::append(sb, "NONE\n"),
		BinaryOp::Add     => sb::append(sb, "ADD\n"),
		BinaryOp::Sub     => sb::append(sb, "SUB\n"),
		BinaryOp::Mul     => sb::append(sb, "MUL\n"),
		BinaryOp::Div     => sb::append(sb, "DIV\n"),
		BinaryOp::Rem     => sb::append(sb, "REM\n"),
		BinaryOp::EQ  => sb::append(sb, "EQ\n"),
		BinaryOp::NE  => sb::append(sb, "NE\n"),
		BinaryOp::GT  => sb::append(sb, "GT\n"),
		BinaryOp::GE  => sb::append(sb, "GE\n"),
		BinaryOp::LT  => sb::append(sb, "LT\n"),
		BinaryOp::LE  => sb::append(sb, "LE\n"),
		BinaryOp::And => sb::append(sb, "AND\n"),
		BinaryOp::Or  => sb::append(sb, "OR\n"),
		BinaryOp::Index       => sb::append(sb, "INDEX\n"),
		BinaryOp::FieldLookup => sb::append(sb, "FIELD_LOOKUP\n"),
		BinaryOp::Path        => sb::append(sb, "PATH\n"),
		BinaryOp::BitOr       => sb::append(sb, "BIT_OR\n"),
		BinaryOp::BitXor      => sb::append(sb, "BIT_XOR\n"),
		BinaryOp::BitAnd      => sb::append(sb, "BIT_AND\n"),
		BinaryOp::BitShiftRight => sb::append(sb, "BIT_SHIFT_RIGHT\n"),
		BinaryOp::BitShiftLeft  => sb::append(sb, "BIT_SHIFT_LEFT\n"),
	}
	node::debug(sb, nodes, binary.lhs, depth + 1);
	node::debug(sb, nodes, binary.rhs, depth + 1);
}


pub fn debug_assign(sb: *sb::StringBuilder, nodes: *node::Nodes, assign: *Assign, depth: int) {
	sb::repeat(sb, "  ", depth);
	match assign.op {
		AssignOp::None    => sb::append(sb, "ASSIGN\n"),
		AssignOp::Add     => sb::append(sb, "ASSIGN_ADD\n"),
		AssignOp::Sub     => sb::append(sb, "ASSIGN_SUB\n"),
		AssignOp::Mul     => sb::append(sb, "ASSIGN_MUL\n"),
		AssignOp::Div     => sb::append(sb, "ASSIGN_DIV\n"),
		AssignOp::Rem     => sb::append(sb, "ASSIGN_REM\n"),
	}
	node::debug(sb, nodes, assign.target, depth + 1);
	node::debug(sb, nodes, assign.value, depth + 1);
}

