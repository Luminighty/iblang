}


// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////


pub fn debug_variable(sb: *sb::StringBuilder, nodes: *node::Nodes, var: *Variable, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "VAR@");
	sb::append_number(sb, var.id);
	sb::append(sb, " [ident=");
	sb::append(sb, var.ident);
	sb::append(sb, "]");
	// TODO: Add type
	sb::append(sb, "\n");
}

pub fn debug_symbol(sb: *sb::StringBuilder, nodes: *node::Nodes, symbol: **symbol::symbol::Symbol, depth: int) {
	let symbol = *symbol;
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "SYMBOL@");
	sb::append_number(sb, symbol.uid);
	sb::append(sb, " [name=");
	sb::append(sb, symbol.name);
	sb::append(sb, ",module=");
	sb::append_number(sb, symbol.module);
	sb::append(sb, "]");
	sb::append(sb, "\n");
}


pub fn debug_call(sb: *sb::StringBuilder, nodes: *node::Nodes, call: *Call, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "[CALL] CALLEE:\n");
	node::debug(sb, nodes, call.callee, depth + 2);
	for let i = 0; i < call.arg_count; i+=1 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "ARG[");
		sb::append_number(sb, i);
		sb::append(sb, "]\n");
		node::debug(sb, nodes, call.args[i], depth + 2);
	}
}

