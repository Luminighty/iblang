const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"
const vec = import "../utils/vec.ib"

const symbol = import "../symbol/mod.ib"
import "./mod.ib"
import "./function.ib"
const err = import "./error.ib"

const ast = import "../ast/ast.ib"
const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const ty = import "./typeident.ib"
const bind = import "./var_bindings.ib"
const node = import "./node.ib"
const type_size_align = import "./type_size_align.ib"
const literal = import "./literal.ib"
const enums = import "./enums.ib"
const cast = import "./cast.ib"
const path = import "./path.ib"

pub struct Call {
	callee: int, // NodeIdx
	arg_count: int,
	args: *int, // *NodeIdx
}

pub struct Variable {
	id: int,
	ident: str,
}

pub struct EnumValue {
	symbol: *symbol::symbol::Symbol,
	field_idx: int,
	value: int, // This is an actual int!
}


pub fn typecheck_call(
	context: *FunctionContext,
	data: ast_expr::Call,
	span: int,
): node::NodeResult {
	let callee_res = node::typecheck(context, data.callee);
	let callee = callee_res.node;
	if callee == node::ERROR { return node::some(node::ERROR); }

	let callee_data = node::get(context.nodes, callee);
	if callee_data.ty == null { return node::some(node::ERROR); }

	if callee_data.ty.kind != ty::TypeKind::Function {
		return node::some(err::error(
			context.parent,
			err::ErrorKind::CallNotFunction,
			callee_data.span
		));
	}
	let fn_type = callee_data.ty.data.function;

	let call = Call {
		callee,
		arg_count: data.arg_count,
		args: node::allocate_extra(context.nodes, sizeof(int) * data.arg_count),
	};
	if data.arg_count < fn_type.args_length {
		err::error(
			context.parent,
			err::ErrorKind::CallArgCountIncorrect,
			callee_data.span
		);
	}
	if data.arg_count > fn_type.args_length && !fn_type.has_varargs {
		err::error(
			context.parent,
			err::ErrorKind::CallArgCountIncorrect,
			callee_data.span
		);
	}
	for let i = 0; i < data.arg_count; i+=1 {
		let arg_res = node::typecheck(context, data.args[i]);
		let arg = arg_res.node;
		call.args[i] = arg;
		if arg == node::ERROR { continue; }
		let arg_data = node::get(context.nodes, arg);
		// NOTE: We can skip varargs. If we did not have varargs, 
		//         then CallArgCountIncorrect catches it
		if i >= fn_type.args_length {
			continue;
		}
		let cast_res = true;
		call.args[i] = cast::implicit(context, call.args[i], fn_type.args[i], &cast_res);
		if !cast_res {
			err::error(
				context.parent,
				err::ErrorKind::CallArgTypeNotMatched,
				arg_data.span
			);
		}
	}

	return node::result(
		node::push(
			context.nodes,
			node::NodeKind::Call,
			fn_type.return_ty.type, node::NodeData { call }, span
		),
		node::flow_from_typeident(fn_type.return_ty)
	);
}

pub fn typecheck_ident(
	context: *FunctionContext,
	ident: str,
	span: int,
): int {
	if context.path_stack.count == 0 {
		let binding = bind::get(&context.bindings, ident);
		if binding.found {
			if binding.is_error && binding.ty == null {
				// NOTE: If we managed to infer the type, lets use that,
				//         otherwise just cause a silent error
				return node::ERROR;
			}
			let variable = Variable {
				id: binding.id,
				ident: binding.key,
			};
			return node::push(
				context.nodes, node::NodeKind::Variable,
				binding.ty, node::NodeData { variable }, span
			);
		}
	}

	let res_node = path::resolve_path_node(context, ident, span);
	if res_node == node::ERROR { return node::ERROR; }
	if res_node != node::NONE { return res_node; }

	// TODO: Try to find alternative symbols/variables to suggest
	return err::error(context.parent, err::ErrorKind::VariableNotFound, span);
}



pub fn typecheck_sizeof(
	context: *FunctionContext,
	data: ast_node::TypeData,
	span: int,
): int {
	let type = ty::typecheck(context.parent, context.module.uid, data.type, span);
	let size = 0;
	if type != null {
		let res = type_size_align::typeident(context.parent, type);
		size = res.size;
	}

	let value = literal::LiteralValue { number: size };
	let literal = literal::Literal { value, kind: literal::LiteralKind::U64 };
	return node::push(
		context.nodes,
		node::NodeKind::Literal,
		ty::atomic(&context.parent.typeidents, ty::AtomicType::U64), node::NodeData { literal }, span,
	);
}


pub fn load_expr(context: *FunctionContext, expr: int): int {
	if expr == node::ERROR { return node::ERROR; }

	let expr_data = node::get(context.nodes, expr);
	if expr_data.ty.kind == ty::TypeKind::Compound {
		let symbol = expr_data.ty.data.compound;
		match symbol.kind {
			symbol::symbol::SymbolKind::Struct |
			symbol::symbol::SymbolKind::Union
				=> return node::push(
					context.nodes,
					node::NodeKind::ObjectCopy,
					expr_data.ty, node::NodeData { expr },
					expr_data.span
				);
			_ => {}
		}
	}
	return node::push(
		context.nodes,
		node::NodeKind::Load,
		expr_data.ty, node::NodeData { expr }, expr_data.span
	);
}


pub fn autoderef(context: *FunctionContext, expr: int): int {
	stdlib::assert(expr != node::ERROR, "node::ERROR passed to autoderef");
	let expr_data = node::get(context.nodes, expr);
	stdlib::assert(
		expr_data.ty.kind == ty::TypeKind::Pointer,
		"autoderef was not pointer!"
	);
	let inner_ty = expr_data.ty.data.pointer;
	return node::push(
		context.nodes,
		node::NodeKind::Deref,
		inner_ty, node::NodeData { deref: expr }, expr_data.span
	);
}

// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////


pub fn debug_variable(sb: *sb::StringBuilder, nodes: *node::Nodes, var: *Variable, ty: *ty::TypeIdent, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "VAR@");
	sb::append_number(sb, var.id);
	sb::append(sb, " [ident=");
	sb::append(sb, var.ident);
	sb::append(sb, ",ty=");
	ty::debug(sb, nodes, ty, depth);
	sb::append(sb, "]");
	sb::append(sb, "\n");
}

pub fn debug_symbol(sb: *sb::StringBuilder, _nodes: *node::Nodes, symbol: **symbol::symbol::Symbol, depth: int) {
	sb::repeat(sb, "  ", depth);
	symbol::symbol::debug_head(sb, *symbol);
	sb::append(sb, "\n");
}


pub fn debug_call(sb: *sb::StringBuilder, nodes: *node::Nodes, call: *Call, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "[CALL] CALLEE:\n");
	node::debug(sb, nodes, call.callee, depth + 2);
	for let i = 0; i < call.arg_count; i+=1 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "ARG[");
		sb::append_number(sb, i);
		sb::append(sb, "]\n");
		node::debug(sb, nodes, call.args[i], depth + 2);
	}
}

pub fn debug_enum_val(sb: *sb::StringBuilder, _nodes: *node::Nodes, enum_val: *EnumValue, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "ENUM_VALUE\n");
	sb::repeat(sb, "  ", depth + 1);
	symbol::symbol::debug_head(sb, enum_val.symbol);
	sb::append(sb, "\n");

	let field = &enum_val.symbol.deep.enum_def.fields[enum_val.field_idx];
	sb::repeat(sb, "  ", depth + 2);
	sb::append(sb, field.field);
	sb::append(sb, "\t:= ");
	sb::append_number(sb, field.value);
	sb::append(sb, "\n");
}


pub fn debug_load(sb: *sb::StringBuilder, nodes: *node::Nodes, expr: *int, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "LOAD\n");
	node::debug(sb, nodes, *expr, depth + 1);
}

pub fn debug_object_copy(sb: *sb::StringBuilder, nodes: *node::Nodes, expr: *int, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "OBJECT_COPY\n");
	node::debug(sb, nodes, *expr, depth + 1);
}
