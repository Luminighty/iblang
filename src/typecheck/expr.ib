): int {
	utils::todo("Not Implemented: typecheck_sizeof");
}


pub fn typecheck_ident(
	context: *FunctionContext,
	ident: str,
	span: int,
): int {
	let binding = bind::get(&context.bindings, ident);
	if binding.found {
		if binding.is_error && binding.ty == null {
			// NOTE: If we managed to infer the type, lets use that,
			//         otherwise just cause a silent error
			return node::ERROR;
		}
		let variable = Variable {
			id: binding.id,
			ident: binding.key,
		};
		return node::push(
			context.nodes, node::NodeKind::Variable,
			binding.ty, node::NodeData { variable }, span
		);
	}

	let symbol = symbol::find_symbol(context.module.uid, ident);
	if symbol != null {
		typecheck_symbol(context.parent, symbol);
		return node::push(
			context.nodes, node::NodeKind::Symbol,
			symbol.type, node::NodeData { symbol }, span
		);
	}

	// TODO: Try to find symbols (Functions, globals, object types(?))
	return err::error(context.parent, err::ErrorKind::VariableNotFound, span);
}


