// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////


pub fn debug_variable(sb: *sb::StringBuilder, nodes: *node::Nodes, var: *Variable, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "VAR@");
	sb::append_number(sb, var.id);
	sb::append(sb, " [ident=");
	sb::append(sb, var.ident);
	sb::append(sb, "]");
	// TODO: Add type
	sb::append(sb, "\n");
}
