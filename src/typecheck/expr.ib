const stdlib = import "@stdlib"
const utils = import "../utils/mod.ib"
const sb = import "../utils/stringbuilder.ib"
const vec = import "../utils/vec.ib"

const symbol = import "../symbol/mod.ib"
import "./mod.ib"
import "./function.ib"
const err = import "./error.ib"

const ast_expr = import "../ast/expr.ib"
const ast_node = import "../ast/node.ib"

const ty = import "./typeident.ib"
const bind = import "./var_bindings.ib"
const node = import "./node.ib"
const type_size_align = import "./type_size_align.ib"
const literal = import "./literal.ib"
const enums = import "./enums.ib"

pub struct Call {
	callee: int, // NodeIdx
	arg_count: int,
	args: *int, // *NodeIdx
}

pub struct Variable {
	id: int,
	ident: str,
}

pub struct EnumValue {
	symbol: *symbol::symbol::Symbol,
	field_idx: int,
}


pub fn typecheck_call(
	context: *FunctionContext,
	data: ast_expr::Call,
	span: int,
): node::NodeResult {
	let callee_res = node::typecheck(context, data.callee);
	let callee = callee_res.node;
	if callee == node::ERROR { return node::some(node::ERROR); }

	let callee_data = node::get(context.nodes, callee);

	if callee_data.ty.kind != ty::TypeKind::Function {
		return node::some(err::error(
			context.parent,
			err::ErrorKind::CallNotFunction,
			callee_data.span
		));
	}
	let fn_type = callee_data.ty.data.function;

	let call = Call {
		callee,
		arg_count: data.arg_count,
		args: node::allocate_extra(context.nodes, sizeof(int) * data.arg_count),
	};
	if data.arg_count < fn_type.args_length {
		err::error(
			context.parent,
			err::ErrorKind::CallArgCountIncorrect,
			callee_data.span
		);
	}
	if data.arg_count > fn_type.args_length && !fn_type.has_varargs {
		err::error(
			context.parent,
			err::ErrorKind::CallArgCountIncorrect,
			callee_data.span
		);
	}
	for let i = 0; i < data.arg_count; i+=1 {
		let arg_res = node::typecheck(context, data.args[i]);
		let arg = arg_res.node;
		call.args[i] = arg;
		let arg_data = node::get(context.nodes, arg);
		// NOTE: We can skip varargs. If we did not have varargs, 
		//         then CallArgCountIncorrect catches it
		if i >= fn_type.args_length {
			continue;
		}
		// TODO: Implicit cast
		if arg_data.ty != fn_type.args[i] {
			err::error(
				context.parent,
				err::ErrorKind::CallArgTypeNotMatched,
				arg_data.span
			);
		}
	}

	return node::result(
		node::push(
			context.nodes,
			node::NodeKind::Call,
			fn_type.return_ty.type, node::NodeData { call }, span
		),
		node::flow_from_typeident(fn_type.return_ty)
	);
}

pub fn typecheck_ident(
	context: *FunctionContext,
	ident: str,
	span: int,
): int {
	let binding = bind::get(&context.bindings, ident);
	if binding.found {
		if binding.is_error && binding.ty == null {
			// NOTE: If we managed to infer the type, lets use that,
			//         otherwise just cause a silent error
			return node::ERROR;
		}
		let variable = Variable {
			id: binding.id,
			ident: binding.key,
		};
		return node::push(
			context.nodes, node::NodeKind::Variable,
			binding.ty, node::NodeData { variable }, span
		);
	}

	let symbol = symbol::find_symbol(context.module.uid, ident);
	if symbol != null {
		typecheck_symbol(context.parent, symbol);
		symbol.used = true;
		return node::push(
			context.nodes, node::NodeKind::Symbol,
			symbol.type, node::NodeData { symbol }, span
		);
	}

	// TODO: Try to find alternative symbols/variables to suggest
	return err::error(context.parent, err::ErrorKind::VariableNotFound, span);
}


pub fn typecheck_sizeof(
	context: *FunctionContext,
	data: ast_node::TypeData,
	span: int,
): int {
	let type = ty::typecheck(context.parent, context.module.uid, data.type, span);
	let size = 0;
	if type != null {
		let res = type_size_align::typeident(context.parent, type);
		size = res.size;
	}

	let value = literal::LiteralValue { number: size };
	let literal = literal::Literal { value, kind: literal::LiteralKind::U64 };
	return node::push(
		context.nodes,
		node::NodeKind::Literal,
		type, node::NodeData { literal }, span,
	);
}


pub fn typecheck_path(
	context: *FunctionContext,
	data: ast_expr::Binary,
	span: int,
): int {
	let lhs = recursive_path(context, data.lhs, span);
	let rhs_data = ast_node::get(&context.module.nodes, data.rhs);
	if rhs_data.kind != ast_node::NodeKind::Ident {
		return err::error(context.parent, err::ErrorKind::InvalidPathElement, rhs_data.span);
	}
	let ident = rhs_data.data.ident;
	let node: *str = vec::push(&context.path_stack);
	*node = ident;
	let result = symbol::resolve_path(context.module.uid, vec::get(&context.path_stack, 0), context.path_stack.count);
	let symbol = result.symbol;

	vec::clear(&context.path_stack);
	match result.kind {
	symbol::PathResultKind::Found => {
		return node::push(
			context.nodes, node::NodeKind::Symbol,
			symbol.type, node::NodeData { symbol }, span
		);
	}
	symbol::PathResultKind::SkippedName => {
		if symbol.kind != symbol::symbol::SymbolKind::Enum {
			return err::error(context.parent, err::ErrorKind::PathEnumExpected, span);
		}
		let field_idx = enums::field_idx(symbol.deep.enum_def, ident);
		stdlib::assert(field_idx >= 0, "field_idx not found!");
		let enum_val = EnumValue { symbol, field_idx };
		return node::push(
			context.nodes, node::NodeKind::EnumValue,
			symbol.type, node::NodeData { enum_val }, span
		);
	}
	symbol::PathResultKind::ErrSymbolWasPrivate => {
		return err::error(context.parent, err::ErrorKind::PathSymbolWasPrivate, span);
	}
	symbol::PathResultKind::ErrModuleNotFound => {
		return err::error(context.parent, err::ErrorKind::PathModuleNotFound, span);
	}
	}
}

fn recursive_path(
	context: *FunctionContext,
	node: int,
	span: int,
): int {
	let node = ast_node::get(&context.module.nodes, node);
	match node.kind {
	ast_node::NodeKind::Ident => {
		let path: *str = vec::push(&context.path_stack);
		*path = node.data.ident;
	}
	ast_node::NodeKind::Binary => {
		let binary = &node.data.binary;
		if binary.op != ast_expr::BinaryOp::Path {
			return err::error(context.parent, err::ErrorKind::InvalidPathElement, span);
		}
		let rhs_data = ast_node::get(&context.module.nodes, binary.rhs);
		if rhs_data.kind != ast_node::NodeKind::Ident {
			return err::error(context.parent, err::ErrorKind::InvalidPathElement, rhs_data.span);
		}
		let lhs_data = ast_node::get(&context.module.nodes, binary.lhs);
		let lhs = recursive_path(context, binary.lhs, lhs_data.span);

		let node: *str = vec::push(&context.path_stack);
		*node = rhs_data.data.ident;
	}
	_ => { err::error(context.parent, err::ErrorKind::InvalidPathElement, span); }
	}
	return node::NONE;
}


// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////


pub fn debug_variable(sb: *sb::StringBuilder, nodes: *node::Nodes, var: *Variable, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "VAR@");
	sb::append_number(sb, var.id);
	sb::append(sb, " [ident=");
	sb::append(sb, var.ident);
	sb::append(sb, "]");
	// TODO: Add type
	sb::append(sb, "\n");
}

pub fn debug_symbol(sb: *sb::StringBuilder, nodes: *node::Nodes, symbol: **symbol::symbol::Symbol, depth: int) {
	sb::repeat(sb, "  ", depth);
	symbol::symbol::debug_head(sb, *symbol);
	sb::append(sb, "\n");
}


pub fn debug_call(sb: *sb::StringBuilder, nodes: *node::Nodes, call: *Call, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "[CALL] CALLEE:\n");
	node::debug(sb, nodes, call.callee, depth + 2);
	for let i = 0; i < call.arg_count; i+=1 {
		sb::repeat(sb, "  ", depth + 1);
		sb::append(sb, "ARG[");
		sb::append_number(sb, i);
		sb::append(sb, "]\n");
		node::debug(sb, nodes, call.args[i], depth + 2);
	}
}

pub fn debug_enum_val(sb: *sb::StringBuilder, nodes: *node::Nodes, enum_val: *EnumValue, depth: int) {
	sb::repeat(sb, "  ", depth);
	sb::append(sb, "ENUM_VALUE\n");
	sb::repeat(sb, "  ", depth + 1);
	symbol::symbol::debug_head(sb, enum_val.symbol);
	sb::append(sb, "\n");

	let field = &enum_val.symbol.deep.enum_def.fields[enum_val.field_idx];
	sb::repeat(sb, "  ", depth + 2);
	sb::append(sb, field.field);
	sb::append(sb, "\t:= ");
	sb::append_number(sb, field.value);
	sb::append(sb, "\n");
}

