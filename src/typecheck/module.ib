const vec = import "../utils/vec.ib"

const ast_module = import "../ast/mod.ib"
const function = import "./function.ib"
const node = import "./node.ib"

pub struct Module {
	uid: int,

	nodes: node::Nodes,
	functions: vec::Vec, // Vec<decl::Function>
	extern_fns: vec::Vec, // Vec<decl::ExternFn>
	args: vec::Vec, // Vec<decl::Arg>

	// globals: vec::Vec, // Vec<decl::Global>
	// extern_globals: vec::Vec, // Vec<decl::ExternGlobal>

	// structs: vec::Vec, // Vec<decl::ObjectDef>,
	// unions: vec::Vec, // Vec<decl::ObjectDef>,
	// enums: vec::Vec, // Vec<decl::EnumDef>,
	// object_data: arena::Arena, // Arena<ObjectField>
}

pub fn new(source: *ast_module::Module): Module {
	return Module {
		uid: source.uid,
		nodes: node::new(),
		functions: vec::new(sizeof(function::Function), source.functions.count),
		extern_fns: vec::new(sizeof(function::ExternFn), source.extern_fns.count),
		args: vec::new(sizeof(function::Arg), source.args.count),

		// extern_globals: vec::new(sizeof(decl::ExternGlobal), source.extern_globals.count),
		// globals: vec::new(sizeof(decl::Global), source.globals.count),

		// structs: vec::new(sizeof(decl::ObjectDef), source.structs.count),
		// unions: vec::new(sizeof(decl::ObjectDef), source.unions.count),
		// enums: vec::new(sizeof(decl::EnumDef), source.enums.count),
		// object_data: arena::new(sizeof(decl::ObjectField) * 128),
	};
}
