const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"
const vec = import "../utils/vec.ib"
const workstack = import "../utils/workstack.ib"

const symbol = import "../symbol/symbol.ib"

import "./mod.ib"

const ast = import "../ast/declaration.ib"
const ast_mod = import "../ast/mod.ib"

const node = import "./node.ib"
const bind = import "./var_bindings.ib"
const ty = import "./typeident.ib"
const module = import "./module.ib"
const err = import "./error.ib"


pub struct Function {
	proto: Prototype,
	body: int,
}


pub struct ExternFn {
	proto: Prototype,
}


pub struct Prototype {
	identifier: str,
	arg_index: int,
	arg_count: int,
	return_type: ty::FlowType,
	return_span: int,
	has_varargs: bool,
	ty: *ty::TypeIdent,
}


pub struct Arg {
	ident: str,
	type: *ty::TypeIdent,
	span: int,
	type_span: int,
}


pub struct FunctionContext {
	parent: *TypecheckContext,
	module: *ast_mod::Module,
	function: *ast::Function,
	nodes: *node::Nodes,
	bindings: bind::VarBindings,

	return_ty: ty::FlowType,
	loop_depth: int,
}


fn create_fn_context(
	parent: *TypecheckContext, symbol: *symbol::Symbol
): FunctionContext {
	let ast_module = find_ast_module(parent, symbol.module);
	let module = find_module(parent, symbol.module);
	stdlib::assert(module != null, "typecheck::function module not found!");

	return FunctionContext {
		parent, module: ast_module,
		function: symbol.shallow.func,
		nodes: &module.nodes,
		bindings: bind::new(),

		return_ty: ty::FlowType {},
		loop_depth: 0,
	};
}


pub fn typecheck_function(
    context: *TypecheckContext,
    symbol: *symbol::Symbol,
) {
	stdlib::printf("Symbol function body: %d\n", symbol.uid);
	stdlib::assert(symbol != null, "typecheck::run symbol was null!");
	stdlib::assert(symbol.kind == symbol::SymbolKind::Function,
		"typecheck::run symbols was not function!"
	);
	let fn_context = create_fn_context(context, symbol);

	let module = find_module(context, symbol.module);

	// let proto = typecheck_prototype(
	// 	context,
	// 	fn_context.module, module,
	// 	&fn_context.function.proto
	// );
	let proto: *Prototype = &symbol.deep.func.proto;
	fn_context.return_ty = proto.return_type;

	for let i = 0; i < proto.arg_count; i+=1 {
		let arg: *Arg = vec::get(&module.args, i);
		bind::insert(&fn_context.bindings, arg.ident, arg.type, true);
	}

	let body_res = node::typecheck(&fn_context, fn_context.function.body);
	let body = body_res.node;
	stdlib::assert(body < fn_context.nodes.nodes.count, "AAAa");

	match proto.return_type.kind {
		ty::FlowTypeKind::Some => {
			match body_res.flow {
				node::NodeFlow::Return => {}
				_ => {
					err::error(
						context,
						err::ErrorKind::FunctionInvalidFlow, 
						proto.return_span
					);
				}
			}
		}
		ty::FlowTypeKind::Void => {
			if body_res.flow == node::NodeFlow::Never {
				err::error(
					context,
					err::ErrorKind::FunctionInvalidFlow, 
					proto.return_span
				);
			}
		}
		ty::FlowTypeKind::Never => {
			if body_res.flow != node::NodeFlow::Never {
				err::error(
					context,
					err::ErrorKind::FunctionInvalidFlow, 
					proto.return_span
				);
			}
		}
	}

	symbol.deep.func.body = body;
}

pub fn typecheck_function_head(
    context: *TypecheckContext,
    symbol: *symbol::Symbol,
) {
	stdlib::printf("Symbol function head: %d\n", symbol.uid);
	symbol.stage = symbol::SymbolStage::TypecheckInProgress;
	let ast_module = find_ast_module(context, symbol.module);
	let module = find_module(context, symbol.module);

	let func: *Function = vec::push(&module.functions);
	func.proto = typecheck_prototype(
		context, symbol,
		&symbol.shallow.func.proto,
		ast_module, module,
	);
	symbol.deep.func = func;
	symbol.stage = symbol::SymbolStage::Typechecked;
	symbol.type = func.proto.ty;
}


pub fn typecheck_prototype(
	context: *TypecheckContext,
	symbol: *symbol::Symbol,
	proto: *ast::Prototype,
	ast_module: *ast_mod::Module,
	module: *module::Module,
): Prototype {
	let identifier = proto.identifier;

	let arg_index = module.args.count;
	let arg_count = proto.arg_count;
	for let i = 0; i < proto.arg_count; i+=1 {
		let ast_arg: *ast::Arg = vec::get(&ast_module.args, i);
		let type = ty::typecheck(context, ast_arg.type, ast_arg.type_span);

		let arg: *Arg = vec::push(&module.args);
		*arg = Arg { 
			ident: ast_arg.ident,
			type: type,
			span: ast_arg.span,
			type_span: ast_arg.type_span,
		};
		let typeident: **ty::TypeIdent = workstack::push(&context.workstack, sizeof(*ty::TypeIdent));
		*typeident = type;
	}
	let return_type = ty::typecheck_flowtype(context, proto.return_type, proto.return_span);
	let return_span = proto.return_span;

	let has_varargs = proto.has_varargs;

	let temp_ty = ty::TypeIdent {};
	temp_ty.kind = ty::TypeKind::Function;

	let temp_fn = &temp_ty.data.function;
	temp_fn.args_length = arg_count;
	temp_fn.has_varargs = has_varargs;
	temp_fn.return_ty = return_type;

	// NOTE: Args have to be loaded here
	for let i = 0; i < arg_count; i+=1 { workstack::pop(&context.workstack, sizeof(*ty::TypeIdent)); }
	temp_fn.args = workstack::top(&context.workstack);

	let ty = ty::find_or_insert(&context.typeidents, &temp_ty);
	return Prototype {
		identifier,
		arg_index, arg_count,
		has_varargs,
		return_type, return_span,
		ty
	};
}

// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////

pub fn debug(sb: *sb::StringBuilder, module: *module::Module, function: *Function) {
	sb::append(sb, "FN ");
	debug_proto(sb, module, &function.proto);
	if function.body != node::ERROR && function.body != node::NONE {
		node::debug(sb, &module.nodes, function.body, 1);
	}
	sb::append_char(sb, '\n');
}

pub fn debug_proto(sb: *sb::StringBuilder, module: *module::Module, proto: *Prototype) {
	sb::append(sb, proto.identifier);
	for let i = 0; i < proto.arg_count; i+=1 {
		sb::append(sb, "\n    ");

		let arg: *Arg = vec::get(&module.args, proto.arg_index + i);
		sb::append(sb, arg.ident);
		sb::append(sb, " : ");
		ty::debug(sb, &module.nodes, arg.type, 1);
	}
	if proto.has_varargs {
		sb::append(sb, "\n  ...");
	}
	sb::append(sb, "\n  return: ");
	ty::debug_flowtype(sb, &module.nodes, &proto.return_type, 1);
	sb::append_char(sb, '\n');
}

