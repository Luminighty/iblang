const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"
const vec = import "../utils/vec.ib"
const workstack = import "../utils/workstack.ib"

const symbol = import "../symbol/mod.ib"

import "./mod.ib"

const ast = import "../ast/declaration.ib"
const ast_mod = import "../ast/mod.ib"

const node = import "./node.ib"
const bind = import "./var_bindings.ib"
const ty = import "./typeident.ib"
const module = import "./module.ib"
const err = import "./error.ib"


pub struct Function {
	proto: Prototype,
	body: int,
	symbol: symbol::UID,
}


pub struct ExternFn {
	proto: Prototype,
	symbol: symbol::UID,
}


pub struct Prototype {
	identifier: str,
	arg_index: int,
	arg_count: int,
	return_type: ty::FlowType,
	return_span: int,
	has_varargs: bool,
	ty: *ty::TypeIdent,
}


pub struct Arg {
	ident: str,
	type: *ty::TypeIdent,
	span: int,
	type_span: int,
}


pub struct FunctionContext {
	parent: *TypecheckContext,
	module: *ast_mod::Module,
	function: *ast::Function,
	nodes: *node::Nodes,
	bindings: bind::VarBindings,

	target_ty: *ty::TypeIdent,
	target_ty_span: int,

	return_ty: ty::FlowType,
	loop_depth: int,
	path_stack: vec::Vec,
	has_return: bool,
	workstack: workstack::WorkStack,
}


pub fn create_fn_context(parent: *TypecheckContext, module: int): FunctionContext {
	let ast_module = find_ast_module(parent, module);
	let module = find_module(parent, module);
	stdlib::assert(module != null, "typecheck::function module not found!");

	return FunctionContext {
		parent, module: ast_module,
		function: null,
		nodes: &module.nodes,
		bindings: bind::new(),
		target_ty: null,
		target_ty_span: 0,
		return_ty: ty::FlowType {},
		loop_depth: 0,
		path_stack: vec::new(sizeof(str), 64),
		workstack: workstack::WorkStack{},
		has_return: false,
	};
}

pub fn free_fn_context(context: *FunctionContext) {
	vec::free(&context.path_stack);
	bind::free(&context.bindings);
	workstack::free(&context.workstack);
}


pub fn typecheck_function(
	context: *TypecheckContext,
	symbol: symbol::UID,
) {
	symbol::assert_exists(symbol);
	symbol::assert_kind(symbol, symbol::symbol::SymbolKind::Function,
		"typecheck::run symbols was not function!"
	);
	let fn_context = create_fn_context(context, symbol.module);
	fn_context.function = symbol::get_shallow(symbol).func;

	let module = find_module(context, symbol.module);

	let func = symbol::get_deep(symbol).func;
	let proto = &func.proto;
	fn_context.return_ty = proto.return_type;

	bind::start(&fn_context.bindings);
	for let i = 0; i < proto.arg_count; i+=1 {
		let arg: *Arg = vec::get(&module.args, proto.arg_index + i);
		bind::insert(&fn_context.bindings, arg.ident, arg.type, true, arg.span);
	}

	let body_res = node::typecheck(&fn_context, fn_context.function.body);
	let body = body_res.node;

	bind::end(&fn_context.bindings, context);
	bind::assert_no_blocks(&fn_context.bindings);

	let actual_flow = body_res.flow;
	if actual_flow == node::NodeFlow::Never && fn_context.has_return {
		actual_flow = node::NodeFlow::Return;
	}
	let invalid_flow = false;
	match proto.return_type.kind {
		ty::FlowTypeKind::Some => match body_res.flow {
			node::NodeFlow::Return => {}
			node::NodeFlow::Never => invalid_flow = !fn_context.has_return,
			_ => invalid_flow = true,
		}
		ty::FlowTypeKind::Void =>
			invalid_flow = actual_flow == node::NodeFlow::Never,
		ty::FlowTypeKind::Never =>
			invalid_flow = actual_flow != node::NodeFlow::Never,
	}
	if invalid_flow {
		err::error(
			context,
			err::ErrorKind::FunctionInvalidFlow,
			proto.return_span
		);
	}
	func.body = body;
	// symbol::attach_deep(symbol, symbol::symbol::DeepInfo { func: body });
	free_fn_context(&fn_context);
}

pub fn typecheck_function_head(
	context: *TypecheckContext,
	symbol: symbol::UID,
) {
	if symbol::is_extern(symbol) {
		typecheck_extern(context, symbol); 
		return;
	}

	symbol::set_stage(symbol, symbol::symbol::SymbolStage::TypecheckInProgress);
	let ast_module = find_ast_module(context, symbol.module);
	let module = find_module(context, symbol.module);

	let func: *Function = vec::push(&module.functions);
	let proto = &symbol::get_shallow(symbol).func.proto;
	func.proto = typecheck_prototype(
		context, symbol,
		proto,
		ast_module, module,
	);
	func.symbol = symbol;
	symbol::attach_deep(symbol, symbol::symbol::DeepInfo { func });
	symbol::set_stage(symbol, symbol::symbol::SymbolStage::Typechecked);
	symbol::set_type(symbol, func.proto.ty);
}

pub fn typecheck_extern(
	context: *TypecheckContext,
	symbol: symbol::UID,
) {
	symbol::assert_exists(symbol);
	if !symbol::is_extern(symbol) {
		stdlib::assert(false, "Typechecking externfn but symbol was not extern!");
	}
	symbol::set_stage(symbol, symbol::symbol::SymbolStage::TypecheckInProgress);
	let ast_module = find_ast_module(context, symbol.module);
	let module = find_module(context, symbol.module);

	let proto = &symbol::get_shallow(symbol).extern_func.proto;
	let func: *ExternFn = vec::push(&module.extern_fns);
	func.proto = typecheck_prototype(
		context, symbol,
		proto,
		ast_module, module,
	);
	func.symbol = symbol;
	symbol::attach_deep(symbol, symbol::symbol::DeepInfo { extern_func: func });
	symbol::set_stage(symbol, symbol::symbol::SymbolStage::Typechecked);
	symbol::set_type(symbol, func.proto.ty);
}


pub fn typecheck_prototype(
	context: *TypecheckContext,
	_symbol: symbol::UID,
	proto: *ast::Prototype,
	ast_module: *ast_mod::Module,
	module: *module::Module,
): Prototype {
	let identifier = proto.identifier;

	let arg_index = module.args.count;
	let arg_count = proto.arg_count;
	for let i = 0; i < proto.arg_count; i+=1 {
		let ast_arg: *ast::Arg = vec::get(&ast_module.args, proto.arg_index + i);
		let type = ty::typecheck(context, module.uid, ast_arg.type, ast_arg.type_span);

		let arg: *Arg = vec::push(&module.args);
		*arg = Arg {
			ident: ast_arg.ident,
			type: type,
			span: ast_arg.span,
			type_span: ast_arg.type_span,
		};
		let typeident: **ty::TypeIdent = workstack::push(&context.workstack, sizeof(*ty::TypeIdent));
		*typeident = type;
	}
	let return_type = ty::typecheck_flowtype(context, module.uid, proto.return_type, proto.return_span);
	let return_span = proto.return_span;

	let has_varargs = proto.has_varargs;

	let temp_ty = ty::TypeIdent {};
	temp_ty.kind = ty::TypeKind::Function;

	let temp_fn = &temp_ty.data.function;
	temp_fn.args_length = arg_count;
	temp_fn.has_varargs = has_varargs;
	temp_fn.return_ty = return_type;

	// NOTE: Args have to be loaded here
	temp_fn.args = workstack::pop_n(&context.workstack, sizeof(*ty::TypeIdent), arg_count);
	let ty = ty::find_or_insert(&context.typeidents, &temp_ty);
	return Prototype {
		identifier,
		arg_index, arg_count,
		has_varargs,
		return_type, return_span,
		ty
	};
}

// ///////////////////////////
// ////////// MISC ///////////
// ///////////////////////////

pub fn debug(sb: *sb::StringBuilder, module: *module::Module, function: *Function) {
	sb::append(sb, "FN ");
	debug_proto(sb, module, &function.proto);
	if function.body != node::ERROR && function.body != node::NONE {
		node::debug(sb, &module.nodes, function.body, 1);
	}
	sb::append_char(sb, '\n');
}

pub fn debug_extern(sb: *sb::StringBuilder, module: *module::Module, function: *ExternFn) {
	sb::append(sb, "EXTERN FN ");
	debug_proto(sb, module, &function.proto);
	sb::append_char(sb, '\n');
}

pub fn debug_proto(sb: *sb::StringBuilder, module: *module::Module, proto: *Prototype) {
	sb::append(sb, proto.identifier);
	for let i = 0; i < proto.arg_count; i+=1 {
		sb::append(sb, "\n    ");

		let arg: *Arg = vec::get(&module.args, proto.arg_index + i);
		sb::append(sb, arg.ident);
		sb::append(sb, " : ");
		ty::debug(sb, arg.type, 1);
	}
	if proto.has_varargs {
		sb::append(sb, "\n  ...");
	}
	sb::append(sb, "\n  return: ");
	ty::debug_flowtype(sb, &proto.return_type, 1);
	sb::append_char(sb, '\n');
}

