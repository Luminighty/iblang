const stdlib = import "@stdlib"
const vec = import "../utils/vec.ib"
const utils = import "../utils/mod.ib"

pub const symbol = import "./symbol.ib"
const table = import "./table.ib"
const strings = import "../storage/strings.ib"

pub const NONE: *symbol::Symbol = null;

let symbol_table = table::SymbolTable{};

pub fn init() { symbol_table = table::new(); }
pub fn free() { table::free(&symbol_table); }


pub fn insert_module(module: str): int {
	let module_str = strings::insert(module, stdlib::strlen(module));
	return table::insert_module(&symbol_table, module_str);
}


pub fn insert(
	module: int,
	name: str,
	is_public: bool,
	kind: symbol::SymbolKind,
	span: int,
): *symbol::Symbol {
	// stdlib::printf("Inserting Symbol: %d@%d %s\n", module, name, name);
	let symbol = table::create_symbol(&symbol_table, module, name, kind, span, is_public);
	// stdlib::printf("    %d\n", symbol.uid);
	return symbol;
}


pub fn exists(module: int, name: str): bool {
	return table::symbol_exists(&symbol_table, module, name);
}


pub fn insert_imports(
	module: int,
	imports: *vec::Vec, // Vec<ModuleImport>
) {
	let meta: *table::ModuleMeta = vec::get(&symbol_table.modules, module);
	meta.import_index = symbol_table.imports.count;
	meta.import_length = imports.count;
	table::insert_imports(&symbol_table, imports);
}


pub fn find_symbol(module_uid: int, name: str): *symbol::Symbol {
	// stdlib::printf("Finding Symbol: %d@%d %s\n", module_uid, name, name);
	return table::find_symbol(&symbol_table, module_uid, name);
}


pub fn attach_shallow(symbol: *symbol::Symbol, info: symbol::ShallowInfo) {
	symbol.shallow = info;
	symbol.stage = symbol::SymbolStage::SymbolResolved;
}

// pub fn attach_deep(symbol: *symbol::Symbol, info: symbol::DeepInfo) {
// 	// TODO:
// 	// symbol.shallow = info;
// 	symbol.stage = symbol::SymbolStage::Typechecked;
// }

pub fn set_stage(symbol: *symbol::Symbol, stage: symbol::SymbolStage) {
	symbol.stage = stage;
}

pub enum PathResultKind {
	Found,
	SkippedName,
	ErrSymbolWasPrivate,
	ErrModuleNotFound,
}
struct PathResult {
	kind: PathResultKind,
	symbol: *symbol::Symbol,
	not_found_module_index: int,
}
pub fn resolve_identifier(module_uid: int, path: *vec::Vec, name: str): PathResult {
	for let i = 0; i < path.count; i+=1 {
		let meta: *table::ModuleMeta = vec::get(
			&symbol_table.modules, module_uid
		);
		let node: *str = vec::get(path, i);
		let node = *node;
		let is_first = i == 0; // NOTE: First symbol may use private imports
		let is_last = i + 1 == path.count;

		let found = false;
		for let j = 0; j < meta.import_length; j+=1 {
			let imprt: *table::ModuleImport = vec::get(
				&symbol_table.imports, meta.import_index + j
			);
			// TODO: I could suggest this as a possible fix
			if !imprt.is_public && !is_first { continue; }
			if imprt.alias == node {
				found = true;
				module_uid = imprt.module;
				break;
			}
		}
		if found { continue; }
		// NOTE: I may have more type subfields
		//         StructFoo::Size/Align/Fields
		//         FatEnum::Tag
		if !is_last {
			stdlib::printf("MOD NOT FOUND: %s\n", node);
			return PathResult {
				kind: PathResultKind::ErrModuleNotFound, symbol: null,
				not_found_module_index: i,
			};
		}
		// NOTE: Last Path node, so we attempt to fetch an enum-ish value
		//        For example, node::NodeKind::Binary
		let symbol = table::find_symbol(
			&symbol_table, module_uid, node
		);
		if symbol == null { continue; }
		if !is_first && !symbol.is_public {
			return PathResult {
				kind: PathResultKind::ErrSymbolWasPrivate,
				symbol, not_found_module_index: 0,
			};
		}
		return PathResult {
			kind: PathResultKind::SkippedName,
			symbol, not_found_module_index: 0,
		};
	}
	let symbol = table::find_symbol(
		&symbol_table, module_uid, name
	);
	if !symbol.is_public {
		return PathResult {
			kind: PathResultKind::ErrSymbolWasPrivate,
			symbol, not_found_module_index: 0,
		};
	}
	return PathResult {
		kind: PathResultKind::Found,
		symbol, not_found_module_index: 0,
	};
}


pub fn debug_all() {
	table::debug(&symbol_table);
}


pub fn debug(symbol: *symbol::Symbol) {
	symbol::debug(symbol);
}
