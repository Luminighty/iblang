const stdlib = import "@stdlib"
const sb = import "../utils/stringbuilder.ib"

const ast = import "../ast/declaration.ib"
const ty = import "../typecheck/typeident.ib"
const function = import "../typecheck/function.ib"
const obj_def = import "../typecheck/object_def.ib"
const enums = import "../typecheck/enums.ib"
const global = import "../typecheck/global.ib"


pub enum SymbolStage {
	Declared,
	SymbolResolved,
	TypecheckInProgress,
	Typechecked,
	ImplementationEmitted,
}


pub enum SymbolKind {
	Struct,
	Union,
	Enum,
	Global,
	Function,
}


pub struct Symbol {
	uid: int,
	module: int,
	name: str,
	is_public: bool,
	is_extern: bool,
	preserve_name: bool,
	kind: SymbolKind,
	stage: SymbolStage,
	shallow: ShallowInfo,
	deep: DeepInfo,
	type: *ty::TypeIdent,
	span: int,
	used: bool,
}


pub union ShallowInfo {
	unknown: *any,

	func: *ast::Function,
	global: *ast::Global,
	object_def: *ast::ObjectDef,
	enum_def: *ast::EnumDef,
	extern_func: *ast::ExternFn,
	extern_global: *ast::ExternGlobal,
}

pub union DeepInfo {
	unknown: *any,

	func: *function::Function,
	global: *global::Global,
	object_def: *obj_def::ObjectDef,
	enum_def: *enums::EnumDef,
	extern_func: *function::ExternFn,
	extern_global: *global::ExternGlobal,
}


pub fn debug(symbol: *Symbol) {
	if symbol == null {
		stdlib::printf("Symbol NONE\n");
		return;
	}
	stdlib::printf("Symbol #%d:\n", symbol.uid);
	stdlib::printf("\tmodule: %d\n", symbol.module);
	stdlib::printf("\tname: %s\n", symbol.name);
	stdlib::printf("\tkind: ");
	match symbol.kind {
		SymbolKind::Struct => stdlib::printf("Struct"),
		SymbolKind::Union => stdlib::printf("Union"),
		SymbolKind::Enum => stdlib::printf("Enum"),
		SymbolKind::Global => stdlib::printf("Global"),
		SymbolKind::Function => stdlib::printf("Function"),
	}
	stdlib::printf("\n");

	stdlib::printf("\tstage: ");
	match symbol.stage {
		SymbolStage::Declared => stdlib::printf("Declared"),
		SymbolStage::SymbolResolved => stdlib::printf("SymbolResolved"),
		SymbolStage::TypecheckInProgress => stdlib::printf("TypecheckInProgress"),
		SymbolStage::Typechecked => stdlib::printf("Typechecked"),
		SymbolStage::ImplementationEmitted => stdlib::printf("ImplementationEmitted"),
	}
	stdlib::printf("\n");
	stdlib::printf("\tshallow: %lu\n", symbol.shallow.unknown);
	stdlib::printf("\t   deep: %lu\n", symbol.deep.unknown);

	stdlib::printf("\tattr: ");
	if symbol.is_extern { stdlib::printf("extern, "); }
	if symbol.is_public { stdlib::printf("pub, "); }
	stdlib::printf("\n");
}

pub fn print_ptr(symbol: *Symbol) {
	stdlib::printf(
		"SYMBOL@[mod=%d,uid=%d,name=%s]", 
		symbol.module,
		symbol.uid,
		symbol.name
	);
	stdlib::fflush(stdlib::stdout);
}

pub fn debug_ptr(sb: *sb::StringBuilder, symbol: *Symbol) {
	sb::append(sb, "SYMBOL@[ptr=");
	sb::append_number(sb, symbol as int);
	sb::append(sb, ",uid=");
	sb::append_number(sb, symbol.uid);
	sb::append(sb, ",module=");
	sb::append_number(sb, symbol.module);
	sb::append(sb, ",name=");
	sb::append(sb, symbol.name);
	sb::append(sb, "]");
}

pub fn debug_head(sb: *sb::StringBuilder, symbol: *Symbol) {
	if symbol == null {
		sb::append(sb, "SYMBOL@NONE");
		return;
	}
	sb::append(sb, "SYMBOL@");
	sb::append_number(sb, symbol.uid);
	sb::append(sb, "[name=");
	sb::append(sb, symbol.name);
	sb::append(sb, ",module=");
	sb::append_number(sb, symbol.module);
	sb::append(sb, "]");
}

