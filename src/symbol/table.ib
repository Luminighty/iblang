const stdlib = import "@stdlib"

const vec = import "../utils/vec.ib"
const sb = import "../utils/stringbuilder.ib"
const symbol = import "./symbol.ib"
const mod = import "./mod.ib"


pub struct ModuleImport {
	module: int,
	alias: str,
	is_public: bool,
}


pub struct ModuleMeta {
	uid: int,
	name: str,
	// NOTE: Index and length into the SymbolTable.symbols
	import_index: int,
	import_length: int,
	symbols: vec::Vec, // Vec<Symbol>
}


pub struct SymbolTable {
	modules: vec::Vec, // Vec<ModuleMeta>
	imports: vec::Vec,   // Vec<ModuleImport>

	last_symbol_uid: int, // SymbolUID
	next_module_uid: int, // ModuleUID
}


pub fn new(): SymbolTable {
	return SymbolTable {
		modules: vec::new(sizeof(ModuleMeta), 256),
		imports: vec::new(sizeof(ModuleImport), 1024),

		last_symbol_uid: 0,
		next_module_uid: 0,
	};
}


pub fn free(table: *SymbolTable) {
	// NOTE: Module names owned by AST module
	for let i = 0; i < table.modules.count; i+=1 {
		let module: *ModuleMeta = vec::get(&table.modules, i) ;
		vec::free(&module.symbols);
	}
	table.next_module_uid = 0;
	table.last_symbol_uid = 0;

	vec::free(&table.modules);
	vec::free(&table.imports);
}


pub fn create_symbol(
	table: *SymbolTable,
	module: int,
	name: str,
	kind: symbol::SymbolKind,
	span: int,
	is_public: bool,
	is_extern: bool,
): mod::UID {
	let mod: *ModuleMeta = vec::get(&table.modules, module);
	let index = mod.symbols.count;
	let symbol: *symbol::Symbol = vec::push(&mod.symbols);

	table.last_symbol_uid += 1;
	let uid = table.last_symbol_uid;
	*symbol = symbol::Symbol {
		uid, module, name , kind, span,
		stage: symbol::SymbolStage::Declared,
		is_public, is_extern,
		preserve_name: false,
		shallow: symbol::ShallowInfo { unknown: null },
		deep: symbol::DeepInfo { unknown: null },
		type: null,
		used: false,
	};

	return mod::UID { module, symbol: uid, index };
}


pub fn get_symbol(table: *SymbolTable, uid: mod::UID): *symbol::Symbol {
	// stdlib::printf("UID(m:%d,uid:%d,i:%d)\n", uid.module, uid.symbol, uid.index);
	stdlib::assert(uid.module < table.modules.count, "find::symbol uid.module >= table.modules.count");
	let module: *ModuleMeta = vec::get(&table.modules, uid.module) ;
	stdlib::assert(module.uid == uid.module, "find::symbol module uid got corrupted");
	stdlib::assert(uid.index < module.symbols.count, "find::symbol uid.index >= module.symbols.count");
	let symbol: *symbol::Symbol = vec::get(&module.symbols, uid.index);
	stdlib::assert(symbol.uid == uid.symbol, "find::symbol symbol uid got corrupted");
	return symbol;
}


pub fn insert_module(table: *SymbolTable, module: str): int {
	let value: *ModuleMeta = vec::push(&table.modules);
	value.symbols = vec::new(sizeof(symbol::Symbol), 64);
	value.name = module;
	value.import_index = table.imports.count;
	value.import_length = 0;
	let uid = table.next_module_uid;
	value.uid = uid;
	table.next_module_uid = table.next_module_uid + 1;
	return uid;
}


pub fn insert_imports(table: *SymbolTable, imports: *vec::Vec) {
	let stored: *ModuleImport = vec::push_many(&table.imports, imports.count);
	for let i = 0; i < imports.count; i+=1 {
		let imprt: *ModuleImport = vec::get(imports, i);
		stored[i] = *imprt;
	}
}


pub fn find_symbol(table: *SymbolTable, module_id: int, ident: str): mod::UID {
	let module: *ModuleMeta = vec::get(&table.modules, module_id);
	stdlib::assert(module.uid == module_id, "find::symbol module uid got corrupted");
	for let i = 0; i < module.symbols.count; i+=1 {
		let symbol: *symbol::Symbol = vec::get(&module.symbols, i);
		stdlib::assert(symbol.module == module_id, "find::symbol symbol module uid got corrupted");
		if symbol.name != ident { continue; }
		return mod::UID {
			module: module_id,
			symbol: symbol.uid,
			index: i
		};
	}
	return mod::NONE;
}


pub fn debug(table: *SymbolTable) {
	for let i = 0; i < table.modules.count; i+=1 {
		let module: *ModuleMeta = vec::get(&table.modules, i);
		stdlib::printf("Module: %d -> %s\n", i, module.name);
		for let i = 0; i < module.symbols.count; i+=1 {
			let value: *symbol::Symbol = vec::get(&module.symbols, i);
			symbol::debug(value);
		}
	}
}


pub fn debug_heads(table: *SymbolTable) {
	stdlib::printf("debug_heads\n");
	for let i = 0; i < table.modules.count; i+=1 {
		let module: *ModuleMeta = vec::get(&table.modules, i);
		for let j = 0; j < module.symbols.count; j+=1 {
			let value: *symbol::Symbol = vec::get(&module.symbols, j);

			symbol::print_ptr(value);
			stdlib::printf("\n");
			stdlib::fflush(stdlib::stdout);
		}
	}
}

