const ident = import "./storage/identifiers.ib"


// const FILE = "./src/main.ib";
// const FILE = "./playground/main.ib";
const FILE = "./src/main_other.ib";
const OUTFILE = "./build/main.c";

pub struct BuildResult {
	file_read_fail: bool,
	errors: err::Errors,
	ast_modules: vec::Vec, // Vec<ast::Module>
	modules: vec::Vec, // Vec<typecheck::Module>
	sb: sb::StringBuilder,

	typecheck_context: typecheck::TypecheckContext,
}


pub fn run(): int {
	let result = build();

	err::print_errors(&result.errors);
	let res = 0;
	if result.errors.had_errors { res = 1; }

	free(&result);

	return 0;
}


pub fn new(): BuildResult {
	return BuildResult {
		file_read_fail: false,
		errors: err::new(),
		ast_modules: vec::new(sizeof(ast::Module), 1),
		modules: vec::Vec {}, // WARN: This gets initialized later
		sb: sb::new(),

		typecheck_context: typecheck::TypecheckContext{},
	};
}


pub fn free(result: *BuildResult) {
	ast::free_modules(&result.ast_modules, true);
	typecheck::free_modules(&result.modules, false);
	vec::free(&result.ast_modules);
	sb::free(&result.sb);
	err::free(&result.errors);
	typecheck::context_free(&result.typecheck_context);
}

// NOTE: Used for lsp
pub fn clear(result: *BuildResult) {
       err::reset(&result.errors);
}

pub fn build(): BuildResult {
	// TODO: Try to find multiple entries (src/main.ib | main.ib)
	let entry: str = FILE;
	let result = new();

	parse_all(&result, entry);
	// if result.errors.had_errors { return result; }
	// symbol::debug_all_head();
	typecheck(&result);
	if result.errors.had_errors { return result; }
	// TODO: Turn this into a storage::error
	if result.file_read_fail { return result; }

	codegen(&result);
	return result;
}

struct ModuleParserMeta {
	uid: int,
	filename: str, // Borrowed,
	path: path::Path,
}
pub fn parse_all(result: *BuildResult, entry: str) {
	let modules_to_parse = vec::new(sizeof(ModuleParserMeta), 64);

	let path = path::new(entry);
	let filename = path::to_str(&path);

	let first: *ModuleParserMeta = vec::push(&modules_to_parse);
	*first = ModuleParserMeta {
		uid: symbol::insert_module(filename),
		filename,
		path,
	};
	
	// Meh, probably there is a cleaner way to do this, like a for loop?
	for let module_idx = 0; module_idx < modules_to_parse.count; module_idx += 1 {
		let module_parse_meta: *ModuleParserMeta = vec::get(&modules_to_parse, module_idx);

		// let path = &module_parse_meta.path;
		// path::print_debug(path);
		// stdlib::printf("\n");
		let filename: str = module_parse_meta.filename;
		let uid = module_parse_meta.uid;
		let parse_result = parse_file(filename, uid, result);

		if parse_result.module == null {
			continue;
		}
		insert_module_imports(
			parse_result.module,
			module_idx,
			&modules_to_parse,
		);

		// if !parse_result.success {
		// 	continue;
		// }
		if args::debug_ast { debug_ast(parse_result.module); }
		ast::create_symbols(parse_result.module);
	}
	path::assert_allocated_count(modules_to_parse.count);
	for let i = 0; i < modules_to_parse.count; i+=1 {
		let parser: *ModuleParserMeta = vec::get(&modules_to_parse, i);
		path::free(&parser.path);
	}
	path::assert_allocated_count(0);

	vec::free(&modules_to_parse);
}

fn insert_module_imports(
	module: *ast::Module,
	base_path_idx: int,
	modules_to_parse: *vec::Vec,
) {
	// stdlib::printf("\n");
	// stdlib::printf("\n");
	// stdlib::printf("insert_module_imports\n");
	// path::print_debug(base_path);
	// stdlib::printf("\n");
	// stdlib::fflush(stdlib::stdout);
	for let i = 0; i < module.imports.count; i+=1 {
		let imprt: *ast::decl::Import = vec::get(&module.imports, i);
		// stdlib::printf("IMPORT PATH: %s\n", imprt.path);
		// stdlib::fflush(stdlib::stdout);
		// stdlib::printf("BASE PATH: ");
		// path::print_debug(base_path);
		// stdlib::printf("\n");
		let base_path_mod: *ModuleParserMeta = vec::get(modules_to_parse, base_path_idx);
		let base_path = &base_path_mod.path;
		let canonical_path = path::join(base_path, imprt.path);
		let idx = is_queued(&canonical_path, modules_to_parse);
		if idx >= 0 {
			let parse: *ModuleParserMeta = vec::get(modules_to_parse, idx);
			imprt.resolved_module = parse.uid;
			path::free(&canonical_path);
			continue;
		}

		let filename = path::to_str(&canonical_path);
		let uid = symbol::insert_module(filename);

		imprt.resolved_module = uid;
		let pushed: *ModuleParserMeta = vec::push(modules_to_parse);
		*pushed = ModuleParserMeta {
			path: canonical_path,
			filename, uid,
		};
	}

	let module_imports = vec::new(sizeof(symbol_table::ModuleImport), module.imports.count);
	for let i = 0; i < module.imports.count; i+=1 {
		let ast_import: *ast::decl::Import = vec::get(&module.imports, i);
		let imprt: *symbol_table::ModuleImport = vec::push(&module_imports);
		*imprt = symbol_table::ModuleImport {
			module: ast_import.resolved_module,
			alias: ast_import.declaration.name,
			is_public: ast_import.declaration.is_public,
		};
	}
	symbol::insert_imports(module.uid, &module_imports);
	vec::free(&module_imports);

}

fn is_queued(
	canonical_path: *path::Path,
	modules_to_parse: *vec::Vec
): int {
	for let i = 0; i < modules_to_parse.count; i+=1 {
		let parse: *ModuleParserMeta = vec::get(modules_to_parse, i);
		let path = &parse.path;
		if path::eq(path, canonical_path) { return i; }
	}
	return -1;
}


// NOTE: We may want to move this to storage::error
pub fn file_read_error(file: str) {
	stdlib::printf("Failed to open file: \"%s\"\n", file);
}


struct FileParseResult {
	success: bool,
	module: *ast::Module,
}


pub fn parse_file(filename: str, module: int, build_result: *BuildResult): FileParseResult {
	let file = fs::read_file(filename);
	if !file.success {
		build_result.file_read_fail = true;
		file_read_error(filename);
		return FileParseResult {};
	}
	if args::verbose {
		stdlib::printf("  %sCompiling%s %s...\n", color::GREEN, color::RESET, filename);
	}

	let result = parse_file_content(
		module, filename,
		file.content, file.length, 
		build_result
	);
	fs::free(&file);
	return result;
}

let sb = sb::StringBuilder{};

pub fn parse_file_content(module: int, filename: str, content: str, length: int, build_result: *BuildResult): FileParseResult {
	let parse_result = FileParseResult { success: false, module: null };

	let result = lexer::run(filename, content, length, &build_result.errors);
	if !result.success { return parse_result; }

	if args::debug_lexer { lexer::print_tokens(&result.tokens); }

	let result = ast::run(filename, module, result.tokens, &build_result.errors);
	// TODO: Probably worth still returning the module, and just handling errored nodes
	// if !result.success {
		// ast::free_module(&result.module, false);
		// return parse_result;
	// }
	// stdlib::printf("%lu == %lu ?\n", build_result.ast_modules.count, module);
	stdlib::assert(build_result.ast_modules.count == module, "parse_file_content module id was incorrect");
	parse_result.module = vec::push(&build_result.ast_modules);
	*parse_result.module = result.module;
	// parse_result.success = true;

	// WARN: Remove this and insert the module insert
	// ast::free_module(&result.module, args::debug_ast);
	return parse_result;
}


fn debug_ast(module: *ast::Module) {
	stdlib::printf("=========================================================\n");
	stdlib::printf("============= %s =============\n", module.file);
	stdlib::printf("=========================================================\n");
	let sb = sb::new();
	ast::debug_module(&sb, module);
	stdlib::printf("%s", sb::merge(&sb));
	sb::free(&sb);
}



pub fn typecheck(result: *BuildResult) {
	// TODO: Check if exists, report error if missing
	let main_fn = symbol::find_symbol(0, ident::find("main"));
	if !symbol::is_none(main_fn) {
		symbol::preserve_name(main_fn);
	} else {
		err::entry_not_found(&result.errors);

	}

	result.modules = typecheck::create_modules(&result.ast_modules);
	result.typecheck_context = typecheck::context(
		&result.errors,
		&result.ast_modules,
		&result.modules,
	);
	typecheck::run(&result.typecheck_context);

	if args::debug_typecheck {
		for let i = 0; i < result.modules.count; i+=1 {
			debug_typecheck(vec::get(&result.modules, i));
		}
	}

}


fn debug_typecheck(module: *typecheck::module::Module) {
	let sb = sb::new();
	typecheck::debug_module(&sb, module);
	stdlib::printf("%s", sb::merge(&sb));
	sb::free(&sb);
}


pub fn codegen(result: *BuildResult) {
	let context = codegen::context(&result.modules, OUTFILE);
	codegen::run(&context);
	codegen::free(&context);
}
