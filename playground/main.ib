struct Vec2 {
	x: f32,
	y: f32,
}

struct Stats {
	health: u16,
	attack: u16,
	magic: u16,
}

struct Player {
	pos: Vec2,
	stats: Stats,
	name: str,
}

struct Test {
	baz: u8,
	bar: u32,
	foo: u8,
}
struct Test2 {
	baz: u8,
	foo: u8,
	bar: u32,
}

struct Test3 {
	bar: u32,
	baz: u8,
	foo: u8,
}


