pub enum Operation {
	Add,
	Subtract,
	Multiply,
	Divide,
}

pub fn apply(lhs: int, rhs: int, op: Operation): int {
	match op {
		Operation::Add => return lhs + rhs;
		Operation::Subtract => return lhs - rhs;
		Operation::Multiply => return lhs * rhs;
		Operation::Divide => return lhs / rhs;
	}
	return 0;
}
